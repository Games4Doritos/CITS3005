  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret literary theories independently through analysis of relevant scholarship.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply, knowingly and appropriately, highly developed skills of textual analysis and critical reasoning.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply, knowingly and appropriately, highly developed skills of textual analysis and critical reasoning.</hasOutcomeDescription>
