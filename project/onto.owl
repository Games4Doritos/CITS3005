</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome887">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the relationship between how criminogenic needs and criminal behaviour are addressed in the criminal justice system.</hasOutcomeDescription>
</owl:NamedIndividual>

