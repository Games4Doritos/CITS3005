  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write in Italian with nuanced modes of expression in syntactic and lexical choices.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1602">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of spoken Italian, in face-to-face and media-mediated situations, with accurate understanding of content and register.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1603">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">express themselves in Italian with accuracy and fluency and in the appropriate register.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1604">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce accurate translations from English into Italian and Italian into English taking into account the dimension of register.</hasOutcomeDescription>
</owl:NamedIndividual>

