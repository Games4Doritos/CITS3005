<owl:Class rdf:about="#Major">
  <rdfs:subClassOf rdf:resource="#UnitSet"/>
</owl:Class>

<owl:Class rdf:about="#Degree">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasMajor"/>
      <owl:someValuesFrom rdf:resource="#Major"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CombinedBachelorDegree">
  <rdfs:subClassOf rdf:resource="#UndergraduateDegree"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#comprisesDegree"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#BachelorDegree">
  <rdfs:subClassOf rdf:resource="#UndergraduateDegree"/>
</owl:Class>

<owl:Class rdf:about="#HonoursDegree">
