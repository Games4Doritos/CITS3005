  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CITS1501</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Introduction to Programming with Python</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces computational thinking, data analysis, and visualisation for students from any discipline.  This stand-alone unit will use datasets and problems from different disciplines to engage students. They will learn practical problem-solving, data analysis, and visualisation skills using the Python programming language and its libraries.</hasUnitDescription>
