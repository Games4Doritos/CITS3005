  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL1206</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Psychology of Work</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Work is an experience that dominates human existence. This unit uncovers the nature of this experience by drawing on the insights of sociology and social psychology.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

