  <hasPrerequisiteUnits rdf:resource="#JAPN1001"/>
  <hasPrerequisiteUnits rdf:resource="#JAPN2203"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JAPN2404</hasUnitCode>
