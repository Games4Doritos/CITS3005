  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the relative effects of past and projected climate change on pathogens, plants and animals.</hasOutcomeDescription>
