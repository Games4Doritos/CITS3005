<owl:NamedIndividual rdf:about="#STAT2401">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-DATSC"/>
  <isInMajors rdf:resource="#MJD-CDSDM"/>
  <isInMajors rdf:resource="#major18"/>
  <isInMajors rdf:resource="#MJD-STATS"/>
  <hasUnitOutcomes rdf:resource="#demonstrate skills in the statistical analysis of data from designed experiments and observational studies."/>
  <hasUnitOutcomes rdf:resource="#apply the fundamentals of designing random experiments in different situations."/>
  <hasUnitOutcomes rdf:resource="#articulate the use of linear models."/>
  <hasUnitOutcomes rdf:resource="#develop and apply linear models for data from real-world experiments and studies."/>
  <hasUnitOutcomes rdf:resource="#proficiently use a statistical computer package for linear modelling."/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#tests or quizzes"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasPrerequisiteDegrees rdf:resource="#62530"/>
  <hasContactRequirement rdf:resource="#contactrequirement694"/>
  <hasContactRequirement rdf:resource="#contactrequirement695"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STAT2401</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of Experiments</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the principles of randomised experiments and practical quantitative tools for analysing the data from such experiments. The emphasis is on choosing and applying appropriate methods, rather than technical details and formal inference. Topics include controlled experiments versus observational studies; different experimental designs—confounding, misinterpretation; biases—blinding and randomisation; and analysis—linear regression, linear models and analysis of variance.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Applications ATAR or MATH1720 Mathematics Fundamentals or MATX1720 Mathematics Fundamentals or equivalent or Enrolment in 62530 Master of Data Science</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate skills in the statistical analysis of data from designed experiments and observational studies.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate skills in the statistical analysis of data from designed experiments and observational studies.</hasOutcomeDescription>
