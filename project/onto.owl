  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire problem-solving skills in the context of conducting research in Korean at an advanced level of proficiency.</hasOutcomeDescription>
</owl:NamedIndividual>

