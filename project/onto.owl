  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply professional skills in communication in the context of agricultural technology.</hasOutcomeDescription>
</owl:NamedIndividual>

