  <isInMajor rdf:resource="#MJD-CMMST"/>
  <hasPrerequisite rdf:resource="#COMM2002"/>
  <hasPrerequisite rdf:resource="#COMM1001"/>
  <hasPrerequisite rdf:resource="#COMM1002"/>
  <hasPrerequisite rdf:resource="#COMM2001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMM3003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Designing Interactive Media</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interactive media has become increasingly pervasive across political, economic, social and cultural processes, facilitating the interplay of storytelling through interactive and transmedia technologies commonly utilised to extend communicative experiences. Focusing on non-linear narratives, this unit introduces students to the main elements and principles of their creation and application. The unit engages students with both theoretical and practical aspects of interactivity through a hands-on approach to the design of transmedia narratives, aiming to facilitate students' creative and critical engagement with the production and consumption of interactive media experiences.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMM1001 Power, Participation and Meaning (ID 813) or COMM1002 Cultures, New Media and Communications (ID 814) and COMM2001 Media Influence or COMM2002 Digital Media</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome858">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise, analyse, and utilise key interactive- and trans-media elements.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome859">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a critical understanding of the key issues underpinning the production and consumption of interactive- and trans-media experiences.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome860">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foster collaborative and professional interactive- and trans-media skills by engaging in team projects that simulate real-world scenarios.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome861">
