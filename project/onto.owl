<owl:NamedIndividual rdf:about="#GENG5504">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#analyse stress in the earth crust."/>
  <hasUnitOutcomes rdf:resource="#calculate the stress around a well and perform a well stability analysis."/>
  <hasUnitOutcomes rdf:resource="#develop simple models of hydraulic fracture."/>
  <hasUnitOutcomes rdf:resource="#evaluate the flow through porous rocks accounting for reservoir heterogeneity and in situ stresses."/>
  <hasUnitOutcomes rdf:resource="#evaluate reservoir properties from different sources and interpret reservoir properties obtained from different methods."/>
  <hasUnitOutcomes rdf:resource="#develop models of reservoir properties using appropriate techniques."/>
  <hasUnitOutcomes rdf:resource="#make simple investment decisions and evaluate the necessary parameters."/>
  <hasUnitOutcomes rdf:resource="#locate and evaluate literature relevant to the unit content."/>
