  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be aware of the effects of environmental change.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#have the ability to think at different levels of integration, from molecular physiology to physiological and systems ecology.">
