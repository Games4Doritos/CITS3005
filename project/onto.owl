  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locate global epistemological issues in their historical and cultural context.</hasOutcomeDescription>
</owl:NamedIndividual>

