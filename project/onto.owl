  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL3003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moral Theory</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The core of this unit consists in a survey of influential moral theories. Students engage both with contemporary readings and with certain classic texts such as those of Aristotle, Kant and J. S. Mill. The details vary from year to year, but typically include: (1) theories of intrinsic value and wellbeing such as hedonism, preferentism and objective theories; (2) consequentialist theories of moral rightness, including act-utilitarianism and rule-utilitarianism; (3) deontological theories of moral rightness, including pluralism, Kantianism and contractualism; and (4) virtue-ethical theories, with a focus on Aristotle's Nichomachean Ethics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any level 2 Philosophy unit or PPHE2211 History of Political Ideas or HUMR2001 Global and Environmental Justice</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2042">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how moral judgements differ from non-moral judgements.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2043">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and utilise the sorts of evidence and reasoning that is relevant for establishing a moral conclusion.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2044">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply general moral theories to concrete actions and social policies.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2045">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distinguish between deontological, consequentialist, and virtue-theoretical approaches to moral theorising.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2046">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a knowledge of three of the most influential texts in the history of Western moral philosophy—Aristotle's Nicomachean Ethics, Kant's Groundwork for the Metaphysics of Morals, and Mill's Utilitarianism.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PHIL3004">
  <rdf:type rdf:resource="#Unit"/>
