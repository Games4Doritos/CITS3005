  <hasPrerequisiteUnit rdf:resource="#MUSC2441"/>
  <hasPrerequisite rdf:resource="#MUSC1441"/>
  <hasPrerequisite rdf:resource="#MUSC1442"/>
  <hasPrerequisite rdf:resource="#MUSC2442"/>
  <hasPrerequisite rdf:resource="#MUSC2441"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3441</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 5</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit facilitates students developing and presenting a professional performance or recorded work (EP) with an accompanying written exegesis that explores a specific creative thesis.  Students will realise their major project, as planned in the previous Principal Studies unit, and will learn professional skills and concepts to support their own unique Contemporary Popular music practice.  Students will work collaboratively to produce their own professional EP or live performance, and will learn the techniques required for song production and mixing.  The final music project is expected to be suitable for, and shared publicly via, live performance or online presentation.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2442 Contemporary Popular Music Principal Studies 4</hasPrerequisiteText>
</owl:NamedIndividual>

