<owl:NamedIndividual rdf:about="#ARTF2021">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FNART"/>
  <isInMajors rdf:resource="#major10"/>
  <hasUnitOutcomes rdf:resource="#discuss your creative work in relation to historical and contemporary contexts relevant to film."/>
  <hasUnitOutcomes rdf:resource="#utilise appropriate materials, techniques, methods and media in the realisation of your creative work."/>
  <hasUnitOutcomes rdf:resource="#articulate a clear and comprehensive creative concept which is verified during development and resolution."/>
  <hasUnitOutcomes rdf:resource="#demonstrate technical competency in the realisation of your creative work."/>
  <hasUnitOutcomes rdf:resource="#communicate information, ideas and proposals effectively in written, oral and creative modes."/>
  <hasUnitAssessments rdf:resource="#project proposal"/>
  <hasUnitAssessments rdf:resource="#studio project"/>
  <hasContactRequirement rdf:resource="#contactrequirement155"/>
  <hasPrerequisiteUnits rdf:resource="#ARTF1053"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF2021</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Animation and Video</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Design School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a studio unit focusing on production of contemporary animation and video. Students study core strategies and production workflows for computer animation and video. They are taught industry-standard motion graphics software and video editing tools which will enable them not only to produce their own independent films, but also, to gain foundational skills to contribute and work in the creative industries. In this unit, students are exposed to the aesthetics of contemporary animation and video, through 2D and 3D animation, real-time motion graphics, generative art, expanded animation and new technologies for creation of moving images.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF1053 Digital Art and Object Making</hasPrerequisiteText>
</owl:NamedIndividual>

