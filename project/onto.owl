  <hasUnitOutcomes rdf:resource="#critically analyse responses to contemporary Australian crime problems and."/>
  <hasUnitOutcomes rdf:resource="#develop convincing, coherent, and consistent responses to contemporary Australian crime problems by applying criminological perspectives that engage with a recognisable body of theory and empirical evidence."/>
  <hasUnitAssessments rdf:resource="#problem review"/>
  <hasUnitAssessments rdf:resource="#workshop engagement"/>
  <hasUnitAssessments rdf:resource="#end-of-semester test"/>
  <hasContactRequirement rdf:resource="#contactrequirement122"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS2223"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS2230"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS3213</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preventing Contemporary Crime Problems</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Law School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will build on what students know about why crime occurs, what we currently do in response to crime, and what we could do differently. Using this knowledge, students will engage with contemporary crime problems in Australia, and be encouraged to develop innovative, theory- and evidence-based responses to address these issues.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS2223 Criminal Justice Systems and LAWS2230 Working with Offenders 1</hasPrerequisiteText>
</owl:NamedIndividual>

