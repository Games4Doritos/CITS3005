  <isInMajor rdf:resource="#MJD-MSTGM"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3341</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music, Society, and Ideas</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit investigates the social and intellectual facets of music's composition, performance and reception, and how these contribute to musical meaning. Students will explore the musical impact of ideas about identity, place, human nature, politics, sexuality and social justice, as well as concepts of time and being. This unit acts as a capstone unit for the music history sequence. It will allow students to consolidate knowledge from previous units in broad conceptual terms, AND consolidate research skills developed progressively throughout the degree</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any level 2 unit</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1895">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and describe key concepts related to the study of music, society and ideas.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1896">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply conceptual knowledge to the interpretation of musical meaning and contexts.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1897">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced skills in critical reading and research, independent thought and communication.</hasOutcomeDescription>
</owl:NamedIndividual>

