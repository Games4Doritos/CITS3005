<owl:NamedIndividual rdf:about="#HRMT3344">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-HRSMT"/>
  <hasUnitOutcomes rdf:resource="#describe 'best practice' and 'best fit' HR strategies and how they affect an organisation's staffing policy and practices."/>
  <hasUnitOutcomes rdf:resource="#explain how aspects of an employee's job affects that person and the organisation."/>
  <hasUnitOutcomes rdf:resource="#compare and contrast the appropriateness of commonly used recruitment tools and techniques for selection and placement decisions."/>
  <hasUnitOutcomes rdf:resource="#describe different forms of performance measurement that can be used to validate selection systems and motivate performance."/>
  <hasUnitOutcomes rdf:resource="#list and compare major strategies for retaining talented staff."/>
  <hasUnitOutcomes rdf:resource="#develop written communication skills in explaining well-researched staffing principles."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement936"/>
