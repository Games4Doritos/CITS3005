  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply engineering synthesis and design processes relevant to mining engineering.</hasOutcomeDescription>
</owl:NamedIndividual>

