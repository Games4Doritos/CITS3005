  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conduct independent research in Greek literature demonstrating a familiarity with the discourse conventions of the discipline.</hasOutcomeDescription>
</owl:NamedIndividual>

