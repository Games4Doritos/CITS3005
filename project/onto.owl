  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the role of an internal control system in maintaining data integrity and recommend internal control improvements to protect key business processes.</hasOutcomeDescription>
</owl:NamedIndividual>

