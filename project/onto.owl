  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use commercial software codes to build, constrain, mesh, run and debug FEM solutions for a range of applications.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4158">
