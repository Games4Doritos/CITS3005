  <isInMajor rdf:resource="#MJD-ICYDM"/>
  <hasUnitOutcome rdf:resource="#outcome2135"/>
  <hasUnitOutcome rdf:resource="#outcome2136"/>
  <hasUnitOutcome rdf:resource="#outcome2137"/>
  <hasUnitOutcome rdf:resource="#outcome2138"/>
  <hasUnitOutcome rdf:resource="#outcome2139"/>
  <hasUnitOutcome rdf:resource="#outcome2140"/>
