<owl:NamedIndividual rdf:about="#KORE1401">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-KOREI"/>
  <hasUnitOutcomes rdf:resource="#communicate at beginner level in written and oral Korean on everyday topics."/>
  <hasUnitOutcomes rdf:resource="#apply appropriate beginner-level Korean language to selected cultural social situations."/>
  <hasUnitOutcomes rdf:resource="#apply a variety of learning strategies relevant to the areas of syntax, semantics and phonetics."/>
  <hasUnitOutcomes rdf:resource="#have an understanding of the Korean culture and society and how they inform basic sociolinguistic conventions in contemporary Korean language use."/>
  <hasUnitOutcomes rdf:resource="#achieve a comparative understanding of language and language use, in both Korean and English."/>
  <hasUnitOutcomes rdf:resource="#apply basic methods of linguistic and cultural analysis, particularly in relation to contrastive modes in language learning."/>
  <hasUnitAssessments rdf:resource="#final exam"/>
  <hasUnitAssessments rdf:resource="#oral presentation"/>
  <hasUnitAssessments rdf:resource="#In class assessment"/>
  <hasContactRequirement rdf:resource="#contactrequirement366"/>
  <hasContactRequirement rdf:resource="#contactrequirement367"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KORE1401</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean 1</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to Korean grammar and vocabulary, giving students the confidence to communicate with Koreans on basic everyday language topics both orally and in writing. No previous knowledge of Korea or Korean language is required. The unit develops intercultural communication skills as well as confidence in listening, speaking, reading and writing Korean. It provides a good basis for an intercultural understanding of Korean culture and society through situating the use of Korean language in relevant social and cultural contexts. The unit is useful for broadening students' international outlook, and for developing independent learning skills.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

