<owl:NamedIndividual rdf:about="#PHYL3001">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <hasUnitOutcome rdf:resource="#outcome3075"/>
  <hasUnitOutcome rdf:resource="#outcome3076"/>
  <hasUnitOutcome rdf:resource="#outcome3077"/>
  <hasUnitOutcome rdf:resource="#outcome3078"/>
