</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2086">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse key foreign policy ideas, theories and concepts that seek to explain the interface between states and the international system.</hasOutcomeDescription>
</owl:NamedIndividual>

