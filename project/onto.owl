<owl:NamedIndividual rdf:about="#LING1002">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-LINGO"/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of the relationships between language, the mind and the brain."/>
  <hasUnitOutcomes rdf:resource="#describe the basic properties of the physical realisation of language in speech, and sign."/>
  <hasUnitOutcomes rdf:resource="#describe the progress of child language acquisition and explain how the facts of acquisition are key issues in the debate on the innateness of language."/>
  <hasUnitOutcomes rdf:resource="#describe how child language acquisition differs from machine learning."/>
  <hasUnitOutcomes rdf:resource="#describe how language is localised in the brain, and how this relates to divergent linguistic ability across diverse population."/>
  <hasUnitAssessments rdf:resource="#tutorial preparation"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement388"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LING1002</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Language, mind and brain</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Language is a key expression of human intelligence. It allows us to interact with others, process and share complex ideas, and communicate our heritage and culture. But what does it mean to know a language? How do humans acquire language without formal instruction? Do different languages portray the world in different ways? This unit focuses on how language is represented in the human brain and how it is realised by the body in speech and sign. It also focuses on how linguistic ability develops in children, how child language acquisition compares to machine learning, and on what differently abled language users can teach us about where language sits in the brain.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

