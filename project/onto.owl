  <hasUnitOutcomes rdf:resource="#understand current developments in the management of workplace diversity, and differentiate between diversity, equality and inclusion."/>
  <hasUnitOutcomes rdf:resource="#relate diversity issues to sociological and psychological theories of work and organisations."/>
  <hasUnitOutcomes rdf:resource="#identify and analyse the effectiveness of management strategies that promote workplace diversity and inclusion."/>
  <hasUnitOutcomes rdf:resource="#articulate why diversity, equality and inclusion are important for organisational performance and culture."/>
  <hasUnitOutcomes rdf:resource="#develop interpersonal communication skills, openness, and understanding of the importance of listening to different views and opinions."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#group project"/>
  <hasUnitAssessments rdf:resource="#Examinations"/>
  <hasContactRequirement rdf:resource="#contactrequirement213"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL3208</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Managing Diversity</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit aims to introduce key concepts and theories about the management of workplace diversity and inclusion. Through Australian and international case studies, the unit also aims to create an applied understanding about 1) some of the main challenges faced by minority groups, and 2) practical inclusion strategies for ensuring that organisations take full advantage of an increasingly diverse labour market.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 points of study at any level, including at least 12 points of Bachelor of Commerce units</hasPrerequisiteText>
</owl:NamedIndividual>

