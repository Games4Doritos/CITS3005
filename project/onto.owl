<owl:NamedIndividual rdf:about="#GENG2003">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#understanding the fundamental properties of fluids and their variations with changing state."/>
  <hasUnitOutcomes rdf:resource="#understanding the characteristics and analysis of laminar and turbulent flows."/>
  <hasUnitOutcomes rdf:resource="#deriving and applying the Navier-Stokes equations to develop and solve differential equations describing simple laminar flows and pressure fields in static fluids."/>
  <hasUnitOutcomes rdf:resource="#understanding and applying the macroscale mass, momentum and energy balances for incompressible and compressible fluid flows."/>
  <hasUnitOutcomes rdf:resource="#developing and applying dimensional analyses to characterise complex flow phenomena."/>
  <hasUnitOutcomes rdf:resource="#analysis and basic design of pump and pipework systems."/>
  <hasUnitAssessments rdf:resource="#laboratory reports and in-class quizzes"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasPrerequisiteDegrees rdf:resource="#62560"/>
  <hasPrerequisiteDegrees rdf:resource="#62570"/>
  <hasContactRequirement rdf:resource="#contactrequirement1011"/>
  <hasContactRequirement rdf:resource="#contactrequirement1012"/>
  <hasContactRequirement rdf:resource="#contactrequirement1013"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1011"/>
  <hasPrerequisiteUnits rdf:resource="#PHYS1001"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1011"/>
  <hasPrerequisiteUnits rdf:resource="#PHYX1001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluid Mechanics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the principles of conservation and momentum transfer in the flow of fluids. Topics discussed include the fundamental properties of fluids, hydrostatics, the general equations of fluid motion, dimensional analysis, fluid friction, pumps, pipe systems, flow in porous media and compressible flow.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62560 Master of Renewable and Future Energy or  Enrolment in 62570 Master of Offshore and Coastal Engineering or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of ( ( MATH1011 Multivariable Calculus and PHYS1001 Physics for Scientists and Engineers or MATX1011 Multivariable Calculus and PHYX1001 Physics for Scientists and Engineers ) )</hasPrerequisiteText>
</owl:NamedIndividual>

