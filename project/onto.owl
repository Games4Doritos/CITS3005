<owl:NamedIndividual rdf:about="#GEOG1106">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#Flexible"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-GGRPY"/>
  <isInMajor rdf:resource="#major2"/>
  <hasUnitOutcome rdf:resource="#outcome2822"/>
  <hasUnitOutcome rdf:resource="#outcome2823"/>
  <hasUnitOutcome rdf:resource="#outcome2824"/>
  <hasUnitOutcome rdf:resource="#outcome2825"/>
  <hasUnitAssessment rdf:resource="#assessment341"/>
  <hasUnitAssessment rdf:resource="#assessment27"/>
  <hasUnitAssessment rdf:resource="#assessment546"/>
  <hasOutcome rdf:resource="#outcome2822"/>
  <hasOutcome rdf:resource="#outcome2823"/>
  <hasOutcome rdf:resource="#outcome2824"/>
  <hasOutcome rdf:resource="#outcome2825"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GEOG1106</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Climate Change: Environment and Society</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Climate change is widely acknowledged as the single largest challenge that faces the environment and society. This course engages students in practical activities and interactive learning experiences to understand the science, causes and processes of climate change. The course is about the Geography of climate change, exploring how climate change and variability impacts the physical environment, human societies and economies. Students learn about our dynamic and changing catchments and coastal systems, and how our changing climate and atmospheric processes are impacting hydrology and water resources. The course also focuses on the deep-time experience of human societies, and how they have experienced, been impacted by, and adapted to, changing climates and to climate variability.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2822">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the fundamental scientific processes of climate change.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2823">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain key landscape processes and identify how climate change is impacting terrestrial, marine and coastal systems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2824">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss how climate change affects environments and societies.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2825">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compare and contrast the impacts of climate change on environmental systems and society, at present and future scenarios.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment546">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">practical class portfolio</hasAssessmentDescription>
</owl:NamedIndividual>

