  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and explain the principles of embryonic development in higher animals.</hasOutcomeDescription>
</owl:NamedIndividual>

