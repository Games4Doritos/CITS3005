  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse economic and financial data in order to establish an investment strategy.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3409">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">examine performance and risk exposure of investments.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3410">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss and peer-evaluate investment recommendations.</hasOutcomeDescription>
</owl:NamedIndividual>

