  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify appropriate language use in various social settings and situations specific to Korean culture and society.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate research skills by selecting, organising and critically evaluating materials in the Korean language, as well as summarise them, drawing conclusions.">
