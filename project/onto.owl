  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSYC2213</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychology: Lifespan Development</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the scientific study of lifespan development, with emphasis on major theories, key research findings, and core methods used in developmental psychology. The areas of development covered include cognition, language, literacy, numeracy, social and emotional functioning, and self-identity. Students will also examine how biological, cognitive, social, cultural, and contextual influences shape development across the lifespan, with a focus on critical evaluation of developmental theory and evidence.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) PSYC1101 Psychology: Mind and Brain or Unit(s) PSYC1102 Psychology: Behaviour in Context</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2165">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a thorough understanding of the key principles and concepts in developmental psychology, and describe key aspects of biological, cognitive, social, and emotional development across the lifespan.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2166">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and evaluate current theories and research on biological, cognitive, social, cultural, and contextual influences on development across the lifespan.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2167">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of the research methods used in developmental psychology.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2168">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply critical thinking to developmental issues and research evidence.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2169">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate self-directed pursuit of scholarly inquiry in developmental psychology.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2170">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate developmental psychology concepts and research findings clearly and effectively in written form.</hasOutcomeDescription>
