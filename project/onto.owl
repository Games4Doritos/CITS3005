  <hasUnitOutcomes rdf:resource="#identify the fundamental economic forces driving seemingly complex behaviour of micro-entities."/>
  <hasUnitOutcomes rdf:resource="#apply the supply-and-demand model to analyze the likely outcomes of changes in public policies."/>
  <hasUnitOutcomes rdf:resource="#effectively communicate economic issues."/>
  <hasUnitOutcomes rdf:resource="#understand and apply concepts of game theory when analyzing strategic interaction between entities."/>
  <hasUnitAssessments rdf:resource="#LMS weekly assignment"/>
