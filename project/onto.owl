  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the performance of algorithms and appreciate the extra requirements of algorithms operating in an autonomous context.</hasOutcomeDescription>
</owl:NamedIndividual>

