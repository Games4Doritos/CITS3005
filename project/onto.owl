  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply appropriate research techniques in art and architectural historiography to the direct study of objects and space on site.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1124">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">engage critically with pertinent texts to make historic and theoretical arguments.</hasOutcomeDescription>
</owl:NamedIndividual>

