<owl:NamedIndividual rdf:about="#FINA2207">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FINCE"/>
  <isInMajors rdf:resource="#MJD-BUSAN"/>
  <hasUnitOutcomes rdf:resource="#demonstrate knowledge of how fundamental or intrinsic firm values are estimated."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an awareness of business strategies and activities that create value."/>
  <hasUnitOutcomes rdf:resource="#discuss the relevance of cash flows, dividends, earnings and book values in firm valuation and integrate profitability into a firm's value."/>
  <hasUnitOutcomes rdf:resource="#explore and evaluate the determinants of a firm's market-to-book ratio."/>
  <hasUnitOutcomes rdf:resource="#produce a clear and concise written equity research report."/>
  <hasUnitOutcomes rdf:resource="#deliver oral presentations that are clear and coherent."/>
  <hasUnitAssessments rdf:resource="#individual assessments"/>
  <hasUnitAssessments rdf:resource="#project"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement926"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2207</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Business Analysis and Valuation</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit emphasises how parties external to the company employ publicly available information, company reports and financial market information to evaluate the current, and predict the future, financial condition of the company. The analytical techniques of financial statement analysis (e.g. fundamental analysis, cash flow analysis and pro forma analysis) and the issue of the reliability and quality of publicly available information are discussed and explored. Analytical tools are applied in different decision contexts such as equity valuation, mergers and acquisitions, lending decisions and the evaluation of managerial performance.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of FINA1221 Introduction to Finance or FINX1221 Introduction to Finance or  Enrolment in MJD-BUSAN Business Analytics</hasPrerequisiteText>
</owl:NamedIndividual>

