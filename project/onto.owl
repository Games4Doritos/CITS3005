<owl:NamedIndividual rdf:about="#outcome2162">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design and operationalise ways of addressing social psychological research questions of contemporary relevance to society using a variety of methodological approaches.</hasOutcomeDescription>
