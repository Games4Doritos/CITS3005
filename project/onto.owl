  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe how the purpose of work has changed throughout human history.</hasOutcomeDescription>
</owl:NamedIndividual>

