  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an understanding of different approaches to commercialising new technologies.</hasOutcomeDescription>
</owl:NamedIndividual>

