  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse influential ideas and concepts in global political economy and demonstrate an understanding of their significance.</hasOutcomeDescription>
</owl:NamedIndividual>

