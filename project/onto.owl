  <hasPrerequisite rdf:resource="#FREN2407"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3814</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Francophone Caribbean Literature</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This cultural unit explores notions of history, identity, exile and belonging in contemporary francophone Caribbean literature. Through a study of selected texts by key writers from Martinique, Guadeloupe and Haiti, students will investigate how contemporary authors represent the complexities of identity when one is caught between competing cultural and historical influences. While the course locates these questions in the particular context of the francophone Caribbean, students will be encouraged to reflect more widely on these issues and to draw parallels between the Caribbean experience and that of other colonized nations. They will also discover one of the most vibrant and exciting bodies of writing in French. This unit is designed to help students towards achieving level B2/C1 of the Common European Framework of References for Languages.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2404 French Studies 4 or FREN2406 French Studies 6 or FREN2408 French Studies 8</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1168">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read, analyse, and develop a historical and theoretical perspective on a body of contemporary literature in French.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1169">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate writing and research skills in a francophone literary context.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1170">
