  <isInMajor rdf:resource="#MJD-MGMNT"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL3270</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Negotiation: Theory and Practice</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the collective and individual significance of negotiation and conflict management with particular reference to employment relations. It considers theories of conflict and various approaches to conflict resolution.  It also provides an introduction to negotiation as a process, including, among other topics, consideration of competitive and cooperative approaches to negotiation, social context, preparation, strategy and ethics.  Students examine case studies and undertake negotiation exercises to experience the practical aspects of the subject.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any two Level 2 units in the Human Resource Management major, Management major or Work and Employment Relations major</hasPrerequisiteText>
</owl:NamedIndividual>

