  <hasUnitOutcomes rdf:resource="#use interpersonal communication skills in French and in English."/>
  <hasUnitAssessments rdf:resource="#test + quizzes"/>
  <hasUnitAssessments rdf:resource="#oral tasks"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement197"/>
