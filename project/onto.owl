  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">written work</hasAssessmentDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ARCY1002">
  <rdf:type rdf:resource="#Unit"/>
