  <hasPrerequisiteUnits rdf:resource="#ENSC2004"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH2004</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering Dynamics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on the knowledge and skills developed in ENSC2004 Engineering Mechanics with a focus on rigid bodies and mechanisms undergoing general planar motion. Topics include the definition and principles of rigid body mechanics; coordinate systems and reference frames, absolute and relative motion, momentum and work/energy methods, and an introduction to mechanical vibration.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of ( MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus and MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods and ENSC2004 Engineering Mechanics )</hasPrerequisiteText>
</owl:NamedIndividual>

