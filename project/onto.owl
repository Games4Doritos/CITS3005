  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies.</hasOutcomeDescription>
</owl:NamedIndividual>

