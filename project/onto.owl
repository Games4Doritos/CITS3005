<owl:NamedIndividual rdf:about="#SSEH1101">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#describe the structure and understand the function of the human skeletal and muscular systems."/>
  <hasUnitOutcomes rdf:resource="#understand and recall the biomechanical responses of bone, tendon and ligament tissue to loading and immobilisation."/>
  <hasUnitOutcomes rdf:resource="#locate, name and describe the function of major bones, joints, ligaments, muscles and peripheral nerves in the human body."/>
  <hasUnitOutcomes rdf:resource="#devise safe and appropriate stretching and strengthening exercises for each major muscle group."/>
  <hasUnitAssessments rdf:resource="#anatomy theory examination"/>
