  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret Process Flow Diagrams and other chemical engineering design documents.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#explain different approaches available for chemical process synthesis and design, and their safety and economic constraints.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain different approaches available for chemical process synthesis and design, and their safety and economic constraints.</hasOutcomeDescription>
</owl:NamedIndividual>

