  <hasUnitOutcomes rdf:resource="#apply technical knowledge, appropriate tools and problem-solving skills to achieve a desired outcome to satisfy user requirements."/>
  <hasUnitOutcomes rdf:resource="#apply project management tools and processes to the planning and execution of a design project."/>
  <hasUnitOutcomes rdf:resource="#demonstrate ethical conduct and professional accountability."/>
  <hasUnitOutcomes rdf:resource="#critically analyse design inputs, processes and outputs."/>
  <hasUnitOutcomes rdf:resource="#locate and apply relevant standards."/>
  <hasUnitOutcomes rdf:resource="#use discourse conventions relevant to the discipline."/>
  <hasUnitOutcomes rdf:resource="#communicate clearly, effectively and appropriately using written, oral and visual means."/>
  <hasUnitOutcomes rdf:resource="#contribute to and/or manage a complex engineering project activity, as a member and/or leader of an engineering team."/>
  <hasUnitAssessments rdf:resource="#oral presentation"/>
  <hasUnitAssessments rdf:resource="#project deliverables"/>
  <hasUnitAssessments rdf:resource="#professional conduct"/>
  <hasContactRequirement rdf:resource="#contactrequirement1028"/>
  <hasContactRequirement rdf:resource="#contactrequirement1029"/>
  <hasPrerequisiteUnits rdf:resource="#BMEG5551"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMEG5552</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Engineering Design Project 2</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit is a capstone experience in which students integrate and apply knowledge and skills acquired in earlier units to a substantial real-world design challenge relevant to their discipline. Students work in teams, typically with four to six members, and are supervised by an academic and/or industry mentor. Teams are responsible for managing their project as well as reporting against milestones and preparing the necessary design documentation. The academic objectives of the unit are to lead students through a systematic engineering design and synthesis process and to better prepare them for professional practice as engineers. The focus of this unit is the delivery of outcomes to a professional standard.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMEG5551 Biomedical Engineering Design Project 1</hasPrerequisiteText>
</owl:NamedIndividual>

