  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The broad aim of the unit is to give students an increased awareness of current issues in international trade and a framework for thinking about international trade policy.</hasUnitDescription>
