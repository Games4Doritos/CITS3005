  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate important theoretical, practical and ethical consequences of artificial intelligence research.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PPHE2211">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
