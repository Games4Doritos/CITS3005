<owl:NamedIndividual rdf:about="#MUSC1591">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasTeachingPeriod rdf:resource="#Semester 2"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-MUSST"/>
  <isInMajor rdf:resource="#MJD-MSTGM"/>
  <isInMajor rdf:resource="#major25"/>
