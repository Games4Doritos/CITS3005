<owl:NamedIndividual rdf:about="#LAWS2227">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-LWSOC"/>
  <hasUnitOutcomes rdf:resource="#demonstrate basic knowledge of."/>
  <hasUnitOutcomes rdf:resource="#apply skills in."/>
  <hasUnitOutcomes rdf:resource="#implement the discursive practices and conventions of socio-legal studies."/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasUnitAssessments rdf:resource="#research essay"/>
  <hasUnitAssessments rdf:resource="#tutorial work"/>
  <hasContactRequirement rdf:resource="#contactrequirement397"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS1111"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS2227</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Law in Action</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Law School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on three interrelated questions—how law acts (and where); how law changes and how this occurs within a broader societal context; and how well law works in action. The goal of the unit is for students to appreciate that the law operates in myriad ways, does not exist in isolation from the rest of society (but impacts on and changes in response to it), and is not perfect. The unit extends the written and oral communication skills developed at Level 1 and also engages collaborative working skills.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS1111 Law in Context</hasPrerequisiteText>
</owl:NamedIndividual>

