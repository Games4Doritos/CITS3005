<owl:NamedIndividual rdf:about="#outcome4198">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carry out performance analysis.</hasOutcomeDescription>
