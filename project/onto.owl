<owl:NamedIndividual rdf:about="#MJD-ANHBY">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#demonstrate an understanding of human biology from the perspectives of evolution, genetics, behaviour, ecology, development, structure, function and comparative studies."/>
