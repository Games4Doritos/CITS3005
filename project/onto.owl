  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employ amplifier circuits to process analog signals.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3843">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use software tools to analyse and design electrical and electronic circuits.</hasOutcomeDescription>
</owl:NamedIndividual>

