  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the project stakeholders and propose effective response strategies to manage stakeholder pressure in both local and global projects.</hasOutcomeDescription>
</owl:NamedIndividual>

