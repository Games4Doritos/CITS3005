  <hasPrerequisiteUnits rdf:resource="#FINA2221"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA3324</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Investment Analysis</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides a framework for a systematic, coherent analysis of risk and return, pricing of investment assets, the construction of investment portfolios and the role of psychology and economics in investment markets.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any Level 2 Finance unit. for pre-2012 courses : FINA2221 Introduction to Finance</hasPrerequisiteText>
</owl:NamedIndividual>

