</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#gain an understanding of key analytical tools used in health economics.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain an understanding of key analytical tools used in health economics.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#acquire extensive knowledge of current issues, the policy environment in Australia and other countries.">
