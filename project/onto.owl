  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the core debates over the meaning of the term 'globalisation'.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2274">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the relationship between globalisation and labour market and workplace restructuring.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2275">
