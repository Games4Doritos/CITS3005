</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3102">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perform modelling using various distributions and calculate related probabilities, expected values, covariance and correlation.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3103">
