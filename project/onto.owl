  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain knowledge of the nature of physiological environments.</hasOutcomeDescription>
</owl:NamedIndividual>

