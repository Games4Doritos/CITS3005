  <hasOutcome rdf:resource="#outcome946"/>
  <hasPrerequisiteUnit rdf:resource="#LAWS1111"/>
  <hasPrerequisiteUnit rdf:resource="#LAWS1110"/>
  <isInMajor rdf:resource="#MJD-CRIMN"/>
