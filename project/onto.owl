<owl:NamedIndividual rdf:about="#ANHB2214">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ANHBY"/>
  <hasUnitOutcomes rdf:resource="#identify and describe the histological organisation and structure of human organs and."/>
  <hasUnitOutcomes rdf:resource="#apply learning to differentiate human organs at the level of cells, tissues and organs by identifying, contrasting and describing key structural and functional features."/>
  <hasUnitAssessments rdf:resource="#online quizzes"/>
  <hasUnitAssessments rdf:resource="#final on campus examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement585"/>
  <hasPrerequisiteUnits rdf:resource="#ANHB1101"/>
  <hasPrerequisiteUnits rdf:resource="#ANHX1101"/>
  <hasPrerequisiteUnits rdf:resource="#ANHB1102"/>
  <hasPrerequisiteUnits rdf:resource="#ANHX1102"/>
  <hasPrerequisiteUnits rdf:resource="#BIOL1130"/>
  <hasPrerequisiteUnits rdf:resource="#SCIE1106"/>
  <hasPrerequisiteUnits rdf:resource="#SCIX1106"/>
  <hasPrerequisiteUnits rdf:resource="#IMED1001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB2214</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Organs and Systems</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores various systems of the human body, including cardiovascular, respiratory, endocrine, urinary, skeletal, digestive and reproductive. Students will become familiar with histological sections from different body systems – each week 1.5 hours will be spent examining the microscopic structure of organs using microscopes. Students will become proficient in basic light microscopy. Elements taught in ANHB2214 Human Organs and Systems will assist in transitioning to ANHB3323 Cells, Tissue, and Development.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any two Unit(s) ANHB1101 Human Biology I: Becoming Human or ANHX1101 Human Biology 1 (Becoming Human) or ANHB1102 Human Biology II: Being Human or ANHX1102 Human Biology 2 (Being Human) or BIOL1130 Frontiers in Biology or SCIE1106 Molecular Biology of the Cell or SCIX1106 Molecular Biology of the Cell or IMED1001 Form and Function</hasPrerequisiteText>
</owl:NamedIndividual>

