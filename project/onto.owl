  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and evaluate the historiographical problems posed by the historical interpretation of National Socialism and the Holocaust.</hasOutcomeDescription>
</owl:NamedIndividual>

