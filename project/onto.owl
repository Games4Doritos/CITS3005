  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply cost-volume-profit analysis techniques in decision making.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3188">
