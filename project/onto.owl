<owl:NamedIndividual rdf:about="#GENE3350">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-GENET"/>
  <isInMajors rdf:resource="#major30"/>
  <isInMajors rdf:resource="#major28"/>
  <isInMajors rdf:resource="#major29"/>
  <hasUnitOutcomes rdf:resource="#describe and explain the principles of embryonic development in higher animals."/>
  <hasUnitOutcomes rdf:resource="#describe and explain the principles of vegetative and floral development in angiosperms."/>
  <hasUnitOutcomes rdf:resource="#predict and explain developmental outcomes involving genetic crosses and transgenesis."/>
  <hasUnitOutcomes rdf:resource="#describe and explain the role of changes in genome organisation in evolutionary-developmental innovations."/>
  <hasUnitOutcomes rdf:resource="#acquire skills for presenting, analysing and interpreting experimental data relevant to molecular life sciences."/>
  <hasUnitOutcomes rdf:resource="#acquire core bench techniques and solve calculations relevant to molecular life sciences."/>
  <hasUnitOutcomes rdf:resource="#synthesise experimental data with scientific literature to derive and test hypotheses."/>
  <hasUnitAssessments rdf:resource="#worksheets"/>
  <hasUnitAssessments rdf:resource="#examinations"/>
  <hasUnitAssessments rdf:resource="#laboratory work"/>
  <hasContactRequirement rdf:resource="#contactrequirement747"/>
  <hasPrerequisiteUnits rdf:resource="#GENE2230"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENE3350</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evolution and Development</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on the molecular genetics and evolution of genes involved in developmental pathways in animals and plants. Consideration is given to gene families that play roles in the development of organisms in diverse evolutionary lineages as well as to genes that control species-specific developmental programs. Topics also include the interactions between an organism's genes and its environment, resulting in changes to the genome that may become heritable.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) GENE2230 Molecular Genetics I</hasPrerequisiteText>
</owl:NamedIndividual>

