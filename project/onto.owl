  <hasPrerequisiteUnits rdf:resource="#ITAL2204"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITAL3405</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Italian Studies 5</hasUnitTitle>
