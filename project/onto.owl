  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">show satisfactory understanding of the political transformation in Taiwan, Hong Kong, the global Chinese community and their interactions with mainland China.</hasOutcomeDescription>
</owl:NamedIndividual>

