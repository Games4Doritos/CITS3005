<owl:NamedIndividual rdf:about="#HART1000">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#Flexible"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-HYART"/>
  <isInMajor rdf:resource="#major17"/>
  <hasUnitOutcome rdf:resource="#outcome1391"/>
  <hasUnitOutcome rdf:resource="#outcome1392"/>
  <hasUnitOutcome rdf:resource="#outcome1393"/>
  <hasUnitOutcome rdf:resource="#outcome1394"/>
  <hasUnitOutcome rdf:resource="#outcome1395"/>
  <hasUnitAssessment rdf:resource="#assessment216"/>
  <hasUnitAssessment rdf:resource="#assessment159"/>
  <hasUnitAssessment rdf:resource="#assessment217"/>
  <hasContactRequirement rdf:resource="#contactrequirement10"/>
  <hasContactRequirement rdf:resource="#contactrequirement85"/>
  <hasOutcome rdf:resource="#outcome1392"/>
  <hasOutcome rdf:resource="#outcome1395"/>
  <hasOutcome rdf:resource="#outcome1393"/>
  <hasOutcome rdf:resource="#outcome1391"/>
  <hasOutcome rdf:resource="#outcome1394"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART1000</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ways of Making: From Pigments to Plastic in the History of Art</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to Art History through the lens of materials, processes and techniques. It explores how art objects were made across time and space, assuming a strong cross-cultural approach. Central questions include: What are the qualities and histories of artistic materials? And: How do materials shape artistic practice and the meaning of an artwork? Lectures invite students to look and listen, while tutorials and workshops provide the opportunity to touch, smell and even taste materials to understand what they do. Through this hands-on engagement with materials and making processes, students develop a deeper appreciation of artworks and their production. In essence, the unit cultivates material literacy - equipping students to speak and write clearly about the qualities, histories and affordances of materials in art.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1391">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define and describe the qualities, histories, and affordances of artistic materials across different cultures and periods.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1392">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of materials and processes to analyse specific art objects, recognising how they were made and the impact of their materials and creation on the meaning of the work.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1393">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the relationship between materials, processes and the finished object in different cultural and historical contexts.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1394">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire the protocols of basic research techniques used in art historiography such as some specialised critical vocabulary, different formats of reporting, essay writing and referencing.</hasOutcomeDescription>
</owl:NamedIndividual>

