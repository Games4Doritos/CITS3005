<owl:NamedIndividual rdf:about="#INDG1150">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#Flexible"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-INKHH"/>
  <isInMajors rdf:resource="#major11"/>
  <hasUnitOutcomes rdf:resource="#use critical thinking skills to incorporate new information about the construction of knowledge."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of Aboriginal history and how these narratives inform contemporary issues in Australian society."/>
  <hasUnitOutcomes rdf:resource="#understand the unity of Aboriginal people yet recognise divergence in the narratives of Aboriginal people."/>
  <hasUnitOutcomes rdf:resource="#develop an understanding of Aboriginal demographics."/>
  <hasUnitOutcomes rdf:resource="#imagine a 'third space' for sharing Aboriginal and non-Aboriginal histories."/>
  <hasUnitAssessments rdf:resource="#participation assessments"/>
  <hasUnitAssessments rdf:resource="#tutorial presentation"/>
  <hasUnitAssessments rdf:resource="#essay"/>
  <hasContactRequirement rdf:resource="#contactrequirement316"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG1150</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aboriginal Encounters: Strangers in our Backyard</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Studies</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the often contested historical realities of Aboriginal experience in postcolonial Australia. Significant eras in shaping an Australian national identity are deconstructed in order to highlight the cultural, social and political impact on, and from, the Aboriginal nation. The unit also explores how collective historical experiences transmit and transform over time.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

