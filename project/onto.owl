<owl:Class rdf:about="#UnitSet">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Unit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Major">
  <rdfs:subClassOf rdf:resource="#UnitSet"/>
</owl:Class>

<owl:Class rdf:about="#Outcome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Location">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ContactRequirement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ContactType">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Degree">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasMajors"/>
      <owl:someValuesFrom rdf:resource="#Major"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#BachelorDegree">
  <rdfs:subClassOf rdf:resource="#UndergraduateDegree"/>
</owl:Class>

<owl:Class rdf:about="#HonoursDegree">
  <rdfs:subClassOf rdf:resource="#UndergraduateDegree"/>
</owl:Class>

<owl:Class rdf:about="#TeachingPeriod">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#UnitMode">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Assessment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#UndergraduateDegree">
  <rdfs:subClassOf rdf:resource="#Degree"/>
</owl:Class>

<owl:Class rdf:about="#PostgraduateDegree">
  <rdfs:subClassOf rdf:resource="#Degree"/>
</owl:Class>

<owl:Class rdf:about="#Minor">
  <rdfs:subClassOf rdf:resource="#UnitSet"/>
</owl:Class>

<owl:Class rdf:about="#CombinedBachelorDegree">
  <rdfs:subClassOf rdf:resource="#UndergraduateDegree"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#comprisesDegrees"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#MastersDegree">
  <rdfs:subClassOf rdf:resource="#PostgraduateDegree"/>
</owl:Class>

<owl:Class rdf:about="#CombinedBachelorMastersDegree">
  <rdfs:subClassOf rdf:resource="#UndergraduateDegree"/>
  <rdfs:subClassOf rdf:resource="#PostgraduateDegree"/>
</owl:Class>

