<owl:NamedIndividual rdf:about="#MKTG1204">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MRKTG"/>
  <hasUnitOutcomes rdf:resource="#identify the different components of consumer decision-making process and individual and environmental factors that influence it."/>
  <hasUnitOutcomes rdf:resource="#identify how consumer behaviour decision-making processes influence organisations' marketing activities."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the applicability of different consumer behaviour concepts."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the ability to produce clear and concise written communication."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the ability to discuss different consumer behaviour concepts in a clear and consistent way."/>
  <hasUnitAssessments rdf:resource="#tutorial participation"/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement948"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG1204</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consumer Behaviour</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the fundamental concepts, principles and theories of consumer behaviour and their marketing implications. Topics include the consumer purchase decision-making process; and environmental and individual determinants of consumer behaviour.</hasUnitDescription>
