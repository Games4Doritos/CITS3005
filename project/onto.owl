<owl:NamedIndividual rdf:about="#FREN3407">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FRNHI"/>
  <hasUnitOutcomes rdf:resource="#demonstrate competency in listening, speaking, reading, and writing corresponding to Levels B2/C1 and upwards of the Common European Framework of Reference for Languages."/>
  <hasUnitOutcomes rdf:resource="#demonstrate awareness of intercultural understanding and language learning."/>
  <hasUnitOutcomes rdf:resource="#use research skills and communication strategies in both French and English."/>
  <hasUnitAssessments rdf:resource="#tests and quizzes"/>
  <hasUnitAssessments rdf:resource="#oral tasks"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement204"/>
  <hasPrerequisiteUnits rdf:resource="#FREN2406"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3407</hasUnitCode>
