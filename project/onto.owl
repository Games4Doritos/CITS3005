  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF3000</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Studio</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a studio based third year Fine Arts unit that prepares students for completion of their studies in the final capstone unit AFTF3050 Advanced Major Project. Based in the studio, students research both contemporary art aesthetics and focus on the practical development and experimentation with of works that conceptually model an advanced creative arts project. In addition to the development of a critically engaged body of work, all students are expected to participate in peer group discussion seminars and develop a written proposition that effectively communicates their artistic strategies.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any two Unit(s) from: ARTF2270 (Inter)national Studio for Arts and Culture , ARTF2021 Animation and Video , ARTF2041 Art in the Environment: Deep-Time Performance and Socially-Engaged Art , ARTF2030 BioArt , ARTF2000 Curatorial Practices in Contemporary Arts , ARTF2040 Environmental and Biological Art , ARTF2031 Living Art , ARTF2020 Moving Images , ARTF2055 Photography and Printmaking studio ARTF2053 Painting Studio</hasPrerequisiteText>
</owl:NamedIndividual>

