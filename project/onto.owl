  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locate, utilise and reference a range of information sources proficiently.</hasOutcomeDescription>
</owl:NamedIndividual>

