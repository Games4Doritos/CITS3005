  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit discusses the human body plan, body organisation and basic histology.  Basic physiology, cell communication and cell biology are presented in an integrated fashion.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in MJD-MEDSI Medical Science or MJD-IMSCP Integrated Medical Sciences and Clinical Practice or MJD-EBMEG Biomedical Engineering or MJD-PHMSC Podiatric Health and Medical Sciences or MJD-DENTS Integrated Dental Sciences</hasPrerequisiteText>
</owl:NamedIndividual>

