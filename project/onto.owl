  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of ethical issues in the sector such as inequality, inclusion, and accessibility.</hasOutcomeDescription>
</owl:NamedIndividual>

