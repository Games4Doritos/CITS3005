  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH2032</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complex and Fourier Analysis</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with the foundation of complex and Fourier analysis, with an emphasis on Cauchy-Riemann equations, holomorphic functions, analytic continuation in the complex plane, contour integration, residues, Laurent series, Fourier series and Fourier transform, point-wise and L2 convergence.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus or MATH1013 Mathematical Analysis and MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods or MATH1014 Algebra</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3148">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and exploit the notions of holomorphic functions and analytic continuation in the complex plane.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3149">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compute contour integrals using methods from complex analysis.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3150">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">show convergence of Fourier series and use them for applications to differential equations.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3151">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exploit the notion of Fourier transform, find the inverse and use these techniques to solve differential equations.</hasOutcomeDescription>
</owl:NamedIndividual>

