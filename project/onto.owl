  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the clinical symptoms and diagnostic criteria for each class of psychological disorder introduced within the unit.</hasOutcomeDescription>
