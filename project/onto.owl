  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">find, critically interpret and evaluate the content of scholarly publications in the literature on language change and language relationships.</hasOutcomeDescription>
</owl:NamedIndividual>

