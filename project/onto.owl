  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate ideas, both orally and in writing, relating to the foundations of special relativity, magnetism, electrical circuits and the physics of particles.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2970">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solve problems in a range of realistic situations relating to the foundations of special relativity, magnetism, electrical circuits and the physics of particles.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2971">
