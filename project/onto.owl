  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate elementary skills in reading, writing, listening and speaking in the French language.</hasOutcomeDescription>
</owl:NamedIndividual>

