  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire important experimental skills required for synthetic chemistry with particular reference to metal complexes.</hasOutcomeDescription>
