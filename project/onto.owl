  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the processes leading to environmental change in a range of places and periods.</hasOutcomeDescription>
</owl:NamedIndividual>

