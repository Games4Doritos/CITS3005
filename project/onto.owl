  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse and interpret physical and biological oceanographic datasets in real world applications.</hasOutcomeDescription>
</owl:NamedIndividual>

