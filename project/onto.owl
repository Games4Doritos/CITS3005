  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL2202</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Australian Employment Relations</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an evidence-based understanding of the dynamics that have influenced the development and current practice of Australian employment relations, as well as an understanding of the institutional arrangements affecting practice in the field, and future challenges facing the field.</hasUnitDescription>
