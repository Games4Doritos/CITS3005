  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3060</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SoilPlant Interactions</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit seeks to examine the soil as an environment for the growth of plants, and to develop a basic understanding of plant nutrition. The unit integrates knowledge of biological components of soil fertility with the physical and chemical components of soil. The role of soil biota in cycling nutrients for plants and in the development of a suitable environment for plant growth is emphasised. These aspects are considered in the context of soil management to maintain sustainable agricultural, horticultural and forest production, to restore disturbed natural ecosystems and to understand processes in managed and natural ecosystems.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of EART2222 Geomorphology and Soils or ENVT2250 Ecology or ENVT2236 Soil Science</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2365">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand nutrient cycling in the soil–microbe–plant continuum and soil–plant interactions governing resistance to abiotic stresses.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2366">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrate concepts related to soil fertility and land use in sustainable land management.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2367">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">record, analyse, critically assess, present and discuss experimental data.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2368">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write concise research reports describing the methods used and data acquired, relate them to published knowledge and place them in a broader environmental and social context.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2369">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work individually and in groups to solve problems related to soil fertility and land use.</hasOutcomeDescription>
</owl:NamedIndividual>

