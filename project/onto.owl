  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse microbial genomic and surveillance datasets, and scientific publications.</hasOutcomeDescription>
</owl:NamedIndividual>

