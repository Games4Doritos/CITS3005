  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the basic concepts and methods of Statistical Learning.</hasOutcomeDescription>
</owl:NamedIndividual>

