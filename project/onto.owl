  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the principles of clean, green and ethical animal production, including the supply chain and its importance to agriculture in the twenty-first century.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2325">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of the principles  underpinning animal production industries.</hasOutcomeDescription>
