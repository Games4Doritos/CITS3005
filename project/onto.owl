<owl:NamedIndividual rdf:about="#PHYS3001">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#analyse the concepts and physical principles involved in advanced formulations of quantum mechanics."/>
  <hasUnitOutcomes rdf:resource="#communicate ideas in writing relating to advanced formulations of quantum mechanics and performed experiments, at an expert level."/>
  <hasUnitOutcomes rdf:resource="#solve problems in a range of realistic situations relating to advanced formulations of quantum mechanics."/>
  <hasUnitOutcomes rdf:resource="#execute an advanced experiment relevant to physics."/>
  <hasUnitOutcomes rdf:resource="#evaluate the results of an advanced experiment relevant to physics."/>
  <hasUnitAssessments rdf:resource="#laboratories"/>
  <hasUnitAssessments rdf:resource="#tests and assignments"/>
  <hasUnitAssessments rdf:resource="#end of semester exam"/>
  <hasPrerequisiteUnits rdf:resource="#PHYS2001"/>
  <hasPrerequisiteUnits rdf:resource="#PHYS2003"/>
  <hasPrerequisiteUnits rdf:resource="#MATH2501"/>
  <hasPrerequisiteUnits rdf:resource="#MATH3023"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS3001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quantum Mechanics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit further develops the physical principles of quantum mechanics.  The content includes: observables and operators, the Dirac formalism, uncertainty relations, measurement theory, spin one-half particles and two-state systems, conservation and symmetry, angular momentum and addition rules, and approximation methods with applications.
The content is explored with reference to a range of applications and physical contexts, and developed and applied through a series of laboratory tasks. Skills in problem identification, mathematical exploration and solution are fostered through practice problems and practical class activities.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS2001 Quantum Physics and Electromagnetism or PHYS2003 Physics for Electrical Engineers and MATH2501 Advanced Mathematical Methods or MATH3023 Advanced Mathematics Applications</hasPrerequisiteText>
</owl:NamedIndividual>

