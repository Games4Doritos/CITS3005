  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the basic methodological issues characteristic of the discipline of History.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1361">
