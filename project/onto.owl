  <hasUnitOutcomes rdf:resource="#apply theoretical knowledge of and practical proficiency in the fundamentals of booking and promoting live performance."/>
  <hasUnitOutcomes rdf:resource="#apply effective strategies for self-directed collaborative music making appropriate to this level of tertiary study."/>
  <hasUnitOutcomes rdf:resource="#analyse the processes involved in creative development."/>
  <hasUnitAssessments rdf:resource="#portfolio"/>
  <hasUnitAssessments rdf:resource="#collaborative music project"/>
  <hasUnitAssessments rdf:resource="#journal"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC1442"/>
