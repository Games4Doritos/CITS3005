<owl:NamedIndividual rdf:about="#ARTF1053">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FNART"/>
  <hasUnitOutcomes rdf:resource="#communicate the practical and conceptual aspects of your creative work."/>
  <hasUnitOutcomes rdf:resource="#apply a range of basic technical skills in the making of art objects and time-based creative work."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an expanded awareness of the creative possibilities of time-based mediums."/>
  <hasUnitOutcomes rdf:resource="#demonstrate development of the ability to critically reflect on your creative work."/>
  <hasUnitOutcomes rdf:resource="#communicate information and ideas effectively in written, oral and creative modes."/>
  <hasUnitAssessments rdf:resource="#portfolio"/>
  <hasUnitAssessments rdf:resource="#final project"/>
  <hasContactRequirement rdf:resource="#contactrequirement149"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF1053</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Digital Art and Object Making</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Design School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is the core Level 1 studio-based unit focusing on the fundamentals of Fine Arts practice by utilising digital arts and media platforms and object making skills. Students work with both traditional and new media technologies to create digital time-based media art that responds to and engages with our rapidly changing world. They are also exposed to fabrication and object making techniques, that engage with the concepts of time, space and narrative. This unit familiarises students with the core stages of producing and developing an art work including ideation, prototyping and final execution.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

