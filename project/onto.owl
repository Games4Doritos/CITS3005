  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH4429</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Engineering Thermodynamics</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students completing this unit demonstrate an understanding of the fundamental laws of thermodynamics, and the ability to analyse a range of industrial systems. Students also understand the social and environmental consequences associated with such technologies. Typically the systems studied include compressors (rotating and reciprocating), refrigeration systems, steam power systems, internal combustion engines and gas turbines, and air-conditioning systems.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Mechanical Engineering specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of MECH3024 Engineering Thermodynamics</hasPrerequisiteText>
</owl:NamedIndividual>

