<owl:NamedIndividual rdf:about="#outcome2683">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically assess the suitability of the approach for a particular data set.</hasOutcomeDescription>
</owl:NamedIndividual>

