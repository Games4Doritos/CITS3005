  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply criminological theoretical frameworks to analyse contemporary challenges relating to crime, victimisation, crime prevention, and the criminal justice system.</hasOutcomeDescription>
</owl:NamedIndividual>

