  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply fundamental and emerging geospatial data analytic techniques and technologies for a range of biophysical and social applications.</hasOutcomeDescription>
</owl:NamedIndividual>

