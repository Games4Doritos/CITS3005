<owl:NamedIndividual rdf:about="#CITS5508">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#explain the role of machine learning in knowledge extraction."/>
  <hasUnitOutcomes rdf:resource="#explain the difference between supervised and unsupervised learning algorithms."/>
  <hasUnitOutcomes rdf:resource="#demonstrate a systematic knowledge of algorithmic machine learning approaches."/>
  <hasUnitOutcomes rdf:resource="#produce practical implementations of machine learning solutions for a real-world dataset."/>
