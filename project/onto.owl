  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre Performance Skills 1</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit draws together students from different levels of musical experience at pre-tertiary level, and consolidates essential musicianship, technical skills and repertoire in music theatre performance. 
The emphasis is upon development of singing technique and performance skills (incorporating singing, dancing, and acting) including awareness of psychological, biomechanical/performance health concepts. 
This unit prepares students for the next unit in the sequence, MUSC1752 Music Theatre Performance Skills 2.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in MJD-MUSMT Music Theatre</hasPrerequisiteText>
</owl:NamedIndividual>

