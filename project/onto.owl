<owl:NamedIndividual rdf:about="#LING3007">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-LINGO"/>
  <hasUnitOutcomes rdf:resource="#describe important research issues in the contemporary study of Australian languages and critically assess papers addressing these issues."/>
  <hasUnitOutcomes rdf:resource="#demonstrate a knowledge of the broad ethical and political issues involved in the contemporary study of Australian languages."/>
  <hasUnitOutcomes rdf:resource="#recognise areas of applied linguistic work involving Australian languages, especially language maintenance activities."/>
  <hasUnitOutcomes rdf:resource="#describe common structural features of Australian languages."/>
  <hasUnitOutcomes rdf:resource="#describe the main typological parameters."/>
  <hasUnitOutcomes rdf:resource="#describe the issues involved in the genetic classification of Australian languages."/>
  <hasUnitAssessments rdf:resource="#tutorial preparation"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#essay"/>
  <hasContactRequirement rdf:resource="#contactrequirement392"/>
  <hasPrerequisiteUnits rdf:resource="#LING2001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LING3007</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linguistics of Australian Indigenous Languages</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Indigenous languages of Australia form a unique part both of the story of human language and of Australian Indigenous heritage. The unit examines broad practical and social issues in linguistic research on Australian languages and introduces the range of applied linguistic work that linguists are often involved in, for instance language maintenance activities and education. The linguistic fabric that forms the background of these issues will also be examined, in particular the diversity of Australian languages and the typological parameters by which they can usefully be compared and classified.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LING2001 Morphosyntax of the World's Languages</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#describe important research issues in the contemporary study of Australian languages and critically assess papers addressing these issues.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe important research issues in the contemporary study of Australian languages and critically assess papers addressing these issues.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate a knowledge of the broad ethical and political issues involved in the contemporary study of Australian languages.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a knowledge of the broad ethical and political issues involved in the contemporary study of Australian languages.</hasOutcomeDescription>
</owl:NamedIndividual>

