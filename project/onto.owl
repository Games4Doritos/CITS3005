  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">express original arguments, together with research methodologies, approaches and findings, coherently and logically in oral and written formats.</hasOutcomeDescription>
</owl:NamedIndividual>

