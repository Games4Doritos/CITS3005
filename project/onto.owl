  <hasUnitOutcomes rdf:resource="#write research proposals relevant to social psychological issues in the format appropriate for psychological science."/>
  <hasUnitOutcomes rdf:resource="#critically apply social psychological theory and evidence to provide insight into real world social issues."/>
  <hasUnitAssessments rdf:resource="#assignments"/>
