  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds upon the tools and techniques introduced in CHEM2104-Energy and Materials. Topics include nanotechnology, polymers, drug delivery, nanostructured liquids and solid materials, liquid crystals, surfactants, interfaces and emulsions. Advanced concepts in these topics are also taught using examples from cutting edge chemical research and a range of industries.
This unit will be offered from: TBA</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
