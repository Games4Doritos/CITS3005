<owl:NamedIndividual rdf:about="#CLAN2002">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-CLANH"/>
  <hasUnitOutcomes rdf:resource="#identify, describe and analyse the major political, social and cultural developments of the period."/>
  <hasUnitOutcomes rdf:resource="#identify and analyse the iconography of material remains from the Roman World."/>
  <hasUnitOutcomes rdf:resource="#identify and analyse the main ancient writers of the period."/>
  <hasUnitOutcomes rdf:resource="#skilfully research using print and electronic resource."/>
  <hasUnitAssessments rdf:resource="#research essay"/>
  <hasUnitAssessments rdf:resource="#in-class participation"/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasContactRequirement rdf:resource="#contactrequirement79"/>
  <hasContactRequirement rdf:resource="#contactrequirement80"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN2002</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power and Politics in the Roman Empire: 44 BC-AD 68</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Why do republics die? What factors lead to the creation of autocracies? How do autocrats maintain power? These questions are at the heart of CLAN2002. 44 BC to AD 68 was a period of dramatic change in the Mediterranean world. It was a period which saw dramatic constitutional changes in Rome, as it transitioned from an imperial Republic to a 'Republican Monarchy'. It was also a time of artistic and poetic development, as artists sought a new language by which to talk about contemporary culture.
The unit offers a carefully structured program of lectures and tutorials that identify and trace the development of the major political, social and cultural aspects of the Triumviral, Augustan, and (to a lesser extent) Julio-Claudian periods. The unit emphasises the collection, analysis and criticism of the ancient source material (literary as well as material) through written in-class tests and tutorial discussion. The unit aims to encourage students to develop critical abilities in the process of exploring and evaluating particular events and personalities throughout this period.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any level 1 6 points Unit(s) MJD-CLANH Classics and Ancient History</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#identify, describe and analyse the major political, social and cultural developments of the period.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify, describe and analyse the major political, social and cultural developments of the period.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#identify and analyse the iconography of material remains from the Roman World.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse the iconography of material remains from the Roman World.</hasOutcomeDescription>
</owl:NamedIndividual>

