  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the operational basis of traditional contract and torts doctrine in relation to online contracts and online defamation.</hasOutcomeDescription>
