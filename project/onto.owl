<owl:NamedIndividual rdf:about="#HIST2015">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#Flexible"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-HISTY"/>
  <hasUnitOutcomes rdf:resource="#understand the long-term, global and culturally diverse history of Australian society, and demonstrate familiarity with key themes and case studies from Australia's deep, global and diverse past."/>
  <hasUnitOutcomes rdf:resource="#demonstrate cultural literacy by developing a personal, social and ethical awareness of the legacies of Australia's deep, global and diverse past."/>
  <hasUnitOutcomes rdf:resource="#identify and evaluate some of the major debates and key historiographical issues in Australia's deep, global and diverse past."/>
  <hasUnitOutcomes rdf:resource="#evaluate the authority of different arguments made about the past."/>
  <hasUnitOutcomes rdf:resource="#express ideas and arguments cogently in written and spoken forums."/>
  <hasUnitOutcomes rdf:resource="#deploy the bibliographical skills necessary to find appropriate sources and produce a viable research proposal in order to undertake a research essay."/>
  <hasUnitAssessments rdf:resource="#research essay"/>
  <hasUnitAssessments rdf:resource="#review essay"/>
  <hasUnitAssessments rdf:resource="#workshop activities"/>
  <hasContactRequirement rdf:resource="#contactrequirement258"/>
  <hasContactRequirement rdf:resource="#contactrequirement259"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIST2015</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Looking for Australia: From the Deep Past to Federation</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What is Australia? This unit critically interrogates the national framework for Australian history, aiming to explore the continent's long-term history in regional and global context, and its culturally diverse identities. Applying a historical focus to the many ways the continent has been understood, we adopt a case study approach, starting with the concept of ‘Deep Time', our geological and biological history, the arrival of humans, Asian polities and trade, cosmopolitan networks and European ‘discovery' from the 17th century onwards, British imperialism, colonisation and cultural exchange, and key themes in the Australian imaginary over the 19th century such as multicultural economies, gender and empire, and citizenship and rights at Federation in 1901. Through documentary, material and visual sources, the unit aims to develop an informed and critically engaged citizenship, and to give students skills in the historical and cultural analysis of Australia in its global relationships.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#understand the long-term, global and culturally diverse history of Australian society, and demonstrate familiarity with key themes and case studies from Australia's deep, global and diverse past.">
