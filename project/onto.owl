<owl:NamedIndividual rdf:about="#MECH5504">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#identify types of material/structural damage associated with fatigue and cracking."/>
  <hasUnitOutcomes rdf:resource="#describe the mechanisms governing various types of fracture of materials due to fatigue and cracking."/>
  <hasUnitOutcomes rdf:resource="#provide plausible explanations to the underlying cause."/>
  <hasUnitOutcomes rdf:resource="#apply various design equations against fatigue and cracking."/>
  <hasUnitOutcomes rdf:resource="#formulate a solution to rectify/prevent the identified damage."/>
  <hasUnitOutcomes rdf:resource="#describe relevant material testing methods for design applications."/>
  <hasUnitOutcomes rdf:resource="#locate and evaluate literature relevant to the unit content."/>
  <hasUnitOutcomes rdf:resource="#work effectively in a diverse team to achieve professional outcomes."/>
  <hasUnitOutcomes rdf:resource="#communicate effectively through concise written technical reports, using discourse conventions relevant to the discipline."/>
  <hasUnitAssessments rdf:resource="#laboratory reports"/>
  <hasUnitAssessments rdf:resource="#individual project assignment"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasPrerequisiteDegrees rdf:resource="#62550"/>
  <hasPrerequisiteUnits rdf:resource="#MECH2002"/>
  <hasPrerequisiteUnits rdf:resource="#GENG2004"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH5504</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Design and Failure Analysis of Materials</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is designed to address the failure and damage of materials and structures due to fatigue and cracking, and relevant methods used to prevent such failures. The unit covers topics including stress concentration due to crack-like defects; stress corrosion cracking; fatigue and cracking due to welding; fracture control and prevention. In addition, the unit covers design standards such as ASTM and relevant design codes, and materials selection to avoid fatigue and cracking.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Mechanical Engineering specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of ( 120 points and MECH2002 Engineering Materials 2 and GENG2004 Solid Mechanics )</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#identify types of material/structural damage associated with fatigue and cracking.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify types of material/structural damage associated with fatigue and cracking.</hasOutcomeDescription>
</owl:NamedIndividual>

