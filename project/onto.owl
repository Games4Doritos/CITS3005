<owl:NamedIndividual rdf:about="#NEUR3310">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-NEURS"/>
  <isInMajors rdf:resource="#major15"/>
  <hasUnitOutcomes rdf:resource="#explain the cellular, molecular and/or genetic principles relevant to nervous system function."/>
  <hasUnitOutcomes rdf:resource="#explain selected research techniques used to study the nervous system."/>
  <hasUnitOutcomes rdf:resource="#explain the physiological and behavioural mechanisms of selected neurological disorders, as well as the experimental models used to study them, and their pharmacological and non-pharmacological treatments."/>
  <hasUnitOutcomes rdf:resource="#analyse,visualise, and interpret neuroscience behavioural data."/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasUnitAssessments rdf:resource="#research-based report"/>
  <hasUnitAssessments rdf:resource="#in semester tests"/>
  <hasPrerequisiteUnits rdf:resource="#PHYL2002"/>
  <hasPrerequisiteUnits rdf:resource="#PHAR2220"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEUR3310</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroscience</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with advanced knowledge of the physiology, pharmacology and function of the nervous system. Students will learn the cellular physiology of neural circuits in detail, contemporary techniques used to study the nervous system, select neurological disorders and their pharmacological and non-pharmacological treatments. In addition, students will learn how to conduct and analyse neuroscience experiments using modern techniques.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of Unit(s) PHYL2002 Cellular Physiology or PHAR2220 Human Pharmacology or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

