  <hasUnitOutcomes rdf:resource="#demonstrate how the evolution of electronic device technology has transformed industries such as energy, communications, manufacturing and medicine."/>
  <hasUnitOutcomes rdf:resource="#relate carrier transport phenomena."/>
  <hasUnitOutcomes rdf:resource="#use Fermi-Dirac statistics."/>
  <hasUnitOutcomes rdf:resource="#model physical characteristics of a transistor as an electric circuit."/>
