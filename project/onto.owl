  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with a solid understanding of mathematical functions and their applications. It also introduces students to the fundamentals of calculus and some basic statistics and probability.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Applications ATAR or MATH1720 Mathematics Fundamentals or MATX1720 Mathematics Fundamentals or Mathematics Methods ATAR (with a scaled score of less than 50) or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

