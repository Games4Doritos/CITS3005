  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-NEURS"/>
  <isInMajors rdf:resource="#major14"/>
  <isInMajors rdf:resource="#MJD-PSYCH"/>
  <isInMajors rdf:resource="#major15"/>
  <hasUnitOutcomes rdf:resource="#explain the nature of some important psychological processes, how they are measured, and their relation to brain function."/>
  <hasUnitOutcomes rdf:resource="#identify the basic principles of psychological measurement and experimental design."/>
  <hasUnitOutcomes rdf:resource="#describe data relevant to psychological questions and draw appropriate inferences from such data."/>
  <hasUnitOutcomes rdf:resource="#write research reports relevant to psychological issues in the format appropriate for psychological science."/>
  <hasUnitOutcomes rdf:resource="#discuss and use the language of psychology appropriately."/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement500"/>
  <hasContactRequirement rdf:resource="#contactrequirement501"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSYC1101</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychology: Mind and Brain</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychological Science</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the broad scope of psychology, with a particular emphasis on the brain and how it relates to basic learning processes, memory, thinking and perception. It provides an overview of those central topics and the links between them. The unit is taught through a coordinated series of lectures and laboratory tutorials and makes use of online materials.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

