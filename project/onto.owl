<owl:NamedIndividual rdf:about="#STAT2062">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MATHS"/>
  <isInMajors rdf:resource="#MJD-STATS"/>
  <hasUnitOutcomes rdf:resource="#explain the fundamental concepts of probability."/>
  <hasUnitOutcomes rdf:resource="#apply probability models to real-world problems and present mathematical results in a logical and coherent manner."/>
  <hasUnitOutcomes rdf:resource="#recognise that understanding fundamentals is necessary for effective application."/>
  <hasUnitAssessments rdf:resource="#quizzes"/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasUnitAssessments rdf:resource="#mid-semester test and final examination"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1011"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1011"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1012"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1012"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STAT2062</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamentals of Probability with Applications</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit develops mathematical methods essential in the study of probability together with the distribution theory required for a study of statistical inference. Topics include random variables and their distributions; joint and conditional distributions; a survey of common distributions and some of their applications; the Poisson process and related distributions; convergence of random variables and the central limit theorem; and an introduction to Markov chains.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus and MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods</hasPrerequisiteText>
</owl:NamedIndividual>

