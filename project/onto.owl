  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate recall and mastery of Ancient Greek vocabulary and grammar through translation of passages of seen and unseen prose or verse without the aid of reference materials.</hasOutcomeDescription>
</owl:NamedIndividual>

