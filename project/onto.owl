  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the emerging challenges the environmental engineering profession addresses.</hasOutcomeDescription>
</owl:NamedIndividual>

