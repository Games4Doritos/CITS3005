  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG2308</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professional Selling</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sales force plays an important role in linking customers to the firm, generating revenue and enhancing the product's brand reputation. Many graduates find themselves in entry level positions where they will need to sell-to or service customers. Consequently, this unit approaches the topic from the salesperson's perspective and focuses on understanding the sales process. This course will provide the principles and practical skills to enable you to be confident in planning and executing professional selling activities, managing key accounts, relationship development and sales strategies.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG1203 Introduction to Marketing or MKTX1203 Introduction to Marketing</hasPrerequisiteText>
</owl:NamedIndividual>

