  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand and discuss key scientific relationships and processes relevant to all four modules.</hasOutcomeDescription>
</owl:NamedIndividual>

