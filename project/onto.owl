  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use skills in literature research, comprehension and analysis of scientific publications and oral and visual presentation of scientific material.</hasOutcomeDescription>
