  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse works of art in their historical context.</hasOutcomeDescription>
</owl:NamedIndividual>

