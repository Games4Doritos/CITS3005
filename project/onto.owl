  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">negotiate cultural difference as a feature of texts in a globalised world.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#comprehend the central critical debates that surround the emergence of global literatures.">
