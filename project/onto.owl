  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how cloud platforms can be used by organisations to achieve efficiencies in developing, operating and scaling modern applications.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3610">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">propose new ways of modifying, extending or combining existing methodologies and implementation techniques.</hasOutcomeDescription>
