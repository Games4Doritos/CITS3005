  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate effective science communication skills.</hasOutcomeDescription>
</owl:NamedIndividual>

