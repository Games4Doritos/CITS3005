  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain an understanding of current issues in wildlife conservation and management.</hasOutcomeDescription>
</owl:NamedIndividual>

