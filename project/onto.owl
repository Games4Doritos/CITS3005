  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read and translate journalistic Japanese.</hasOutcomeDescription>
</owl:NamedIndividual>

