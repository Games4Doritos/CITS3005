  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incorporate fatigue in analysis and design and quantify the non-static failure mechanism of fatigue.</hasOutcomeDescription>
</owl:NamedIndividual>

