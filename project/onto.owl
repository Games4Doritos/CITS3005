  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an ability to critically assess key concepts, theories, arguments and developments in sports history.</hasOutcomeDescription>
</owl:NamedIndividual>

