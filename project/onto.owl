  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read texts from a variety of historical periods and relate them to their geographical, historical and cultural contexts.</hasOutcomeDescription>
</owl:NamedIndividual>

