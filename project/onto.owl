  <hasPrerequisiteUnits rdf:resource="#MECH2004"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH3001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanisms and Machines</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with the engineering skills to analyse the dynamic behaviour of various mechanical components, mechanisms and machines. Both planar and three-dimensional dynamics are considered, including gyroscopic behaviour.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of CITX1401 Computational Thinking with Python or CITS1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation and MECH2004 Engineering Dynamics</hasPrerequisiteText>
</owl:NamedIndividual>

