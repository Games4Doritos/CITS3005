  <hasPrerequisite rdf:resource="#62530"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STAT2401</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of Experiments</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the principles of randomised experiments and practical quantitative tools for analysing the data from such experiments. The emphasis is on choosing and applying appropriate methods, rather than technical details and formal inference. Topics include controlled experiments versus observational studies; different experimental designs—confounding, misinterpretation; biases—blinding and randomisation; and analysis—linear regression, linear models and analysis of variance.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Applications ATAR or MATH1720 Mathematics Fundamentals or MATX1720 Mathematics Fundamentals or equivalent or Enrolment in 62530 Master of Data Science</hasPrerequisiteText>
</owl:NamedIndividual>

