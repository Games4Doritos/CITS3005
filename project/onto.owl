  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an advanced unit in financial reporting focusing on both theories and practices relating to financial reporting and regulation.  Current Australian practice is examined and integrated with broader theoretical perspectives, seeking to provide the student with a comprehensive and up-to-date understanding of contemporary accounting standards and significant issues in the current accounting environment.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACCT2201 Corporate Accounting</hasPrerequisiteText>
</owl:NamedIndividual>

