  <hasOutcome rdf:resource="#outcome1039"/>
  <hasOutcome rdf:resource="#outcome1040"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF1053</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Digital Art and Object Making</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is the core Level 1 studio-based unit focusing on the fundamentals of Fine Arts practice by utilising digital arts and media platforms and object making skills. Students work with both traditional and new media technologies to create digital time-based media art that responds to and engages with our rapidly changing world. They are also exposed to fabrication and object making techniques, that engage with the concepts of time, space and narrative. This unit familiarises students with the core stages of producing and developing an art work including ideation, prototyping and final execution.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1038">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate the practical and conceptual aspects of your creative work.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1039">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply a range of basic technical skills in the making of art objects and time-based creative work.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1040">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an expanded awareness of the creative possibilities of time-based mediums.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1041">
