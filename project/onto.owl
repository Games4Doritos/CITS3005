  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Criminal Justice Systems</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the institutions, activities and processes that make up the Australian criminal justice system including police, courts, prosecution and corrections. It investigates historical and contemporary issues within their broader context.</hasUnitDescription>
