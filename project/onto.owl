  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have an advanced understanding of ecological processes across terrestrial, aquatic and marine ecosystems.</hasOutcomeDescription>
</owl:NamedIndividual>

