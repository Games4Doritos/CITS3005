<owl:NamedIndividual rdf:about="#ITAL1402">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasTeachingPeriods rdf:resource="#Summer teaching period"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ITLNB"/>
  <hasUnitOutcomes rdf:resource="#further develop elementary skills in reading, writing, listening and speaking in the Italian language."/>
  <hasUnitOutcomes rdf:resource="#be familiar with a broader range of sociolinguistic conventions in Italian."/>
  <hasUnitOutcomes rdf:resource="#have an increased knowledge of culture and society in Italian-speaking countries."/>
  <hasUnitOutcomes rdf:resource="#further develop independent learning skills and develop interpersonal skills."/>
  <hasUnitOutcomes rdf:resource="#have an increased awareness of language and language use, in both Italian and in English."/>
  <hasUnitAssessments rdf:resource="#in-class and on-line test"/>
  <hasUnitAssessments rdf:resource="#oral activities"/>
  <hasUnitAssessments rdf:resource="#online and in-class engagement"/>
  <hasContactRequirement rdf:resource="#contactrequirement339"/>
  <hasPrerequisiteUnits rdf:resource="#ITAL1401"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITAL1402</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Italian Studies 2</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit continues the introduction to Italian language and culture provided in ITAL1401 Italian Studies 1. Students are taught to speak, understand, read and write contemporary Italian and study aspects of contemporary Italian culture in Italy and in countries of Italian migration. The unit uses communicative and natural learning methodologies, and authentic print and multimedia texts. Students achieve language proficiency equivalent to Level A1/A2 of the Common European Framework of Reference for Languages (Quadro Comune Europeo di Riferimento per le Lingue).
The unit leads to ITAL2403 Italian Studies 3.  Level 2 and 3 Italian units not only increase language competency but offer the opportunity to further engage with Italian  culture and history (including linguistics, literature and film) and to take advantage of a range of exchange possibilities, including our short-term Bergamo Summer School.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of ITAL1401 Italian Studies 1</hasPrerequisiteText>
</owl:NamedIndividual>

