  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2441</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 3</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit consolidates and builds upon essential skills and concepts learnt in Contemporary Popular Music Principal Studies 2. Students further develop their own unique Contemporary Popular music practice, including performance, songwriting, live sound, and event promotion.  Students will work collaboratively to produce their own portfolio in either performance and/or songwriting, while also learning techniques in production, and booking and promotion of live performances. This unit prepares students in technical and performance skills required for the next unit in the Principal Studies sequence.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1442 Contemporary Popular Music Principal Studies 2</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1919">
