  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN2404 Chinese 4 or CHIN2204 Chinese Intermediate II</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome724">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read and analyse texts in Chinese in dialogue and narrative forms.</hasOutcomeDescription>
</owl:NamedIndividual>

