<owl:NamedIndividual rdf:about="#CITS4012">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 2"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <hasUnitOutcome rdf:resource="#outcome3575"/>
  <hasUnitOutcome rdf:resource="#outcome3576"/>
  <hasUnitOutcome rdf:resource="#outcome3577"/>
