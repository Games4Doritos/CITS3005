<owl:NamedIndividual rdf:about="#MUSC1352">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MUSMT"/>
  <hasUnitOutcomes rdf:resource="#discuss developments in musical theatre."/>
  <hasUnitOutcomes rdf:resource="#demonstrate critical reading, thinking, and communication skills in relation to musical theatre."/>
  <hasUnitOutcomes rdf:resource="#relate knowledge of key musical theatre developments to relevant cultural and historical contexts."/>
  <hasUnitAssessments rdf:resource="#tutorial activities"/>
  <hasUnitAssessments rdf:resource="#research project"/>
  <hasUnitAssessments rdf:resource="#final exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement439"/>
  <hasContactRequirement rdf:resource="#contactrequirement440"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1352</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre: Oklahoma! to Hamilton</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will investigate the history of the musical and its evolution to current musical theatre works.  Students will examine various style and forms within theatrical productions of music, discuss libretti and dramatic content, and identify performance traditions that occur within entire shows, specific productions, and individual songs. Case studies from a range of musical theatre shows (including a range of Broadway, West End, and international productions) will be used to illustrate the discussions.  
 
This unit is open to all enrolled students who have an interest in music. No prior experience is necessary.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

