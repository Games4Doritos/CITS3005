  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH5504</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Design and Failure Analysis of Materials</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is designed to address the failure and damage of materials and structures due to fatigue and cracking, and relevant methods used to prevent such failures. The unit covers topics including stress concentration due to crack-like defects; stress corrosion cracking; fatigue and cracking due to welding; fracture control and prevention. In addition, the unit covers design standards such as ASTM and relevant design codes, and materials selection to avoid fatigue and cracking.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Mechanical Engineering specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of ( 120 points and MECH2002 Engineering Materials 2 and GENG2004 Solid Mechanics )</hasPrerequisiteText>
</owl:NamedIndividual>

