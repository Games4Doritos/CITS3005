  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3409</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Studies 9</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from FREN2408 French Studies 8. In this unit students develop advanced skills in French speaking, reading, writing and aural comprehension and deepen their understanding of French and francophone culture. Through analysing literary works, writing creatively, conducting interviews and making oral presentations students refine their language abilities and further extend their understanding of French-speaking societies, their literature and history. Students achieve language proficiency corresponding to Level C2 of the Common European Framework of Reference for Languages.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2408 French Studies 8 or FREN3408 French Studies 8</hasPrerequisiteText>
</owl:NamedIndividual>

