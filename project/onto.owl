</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1905">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply collaborative music making skills appropriate to this foundational level of tertiary performance.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1906">
