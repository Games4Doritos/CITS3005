<owl:NamedIndividual rdf:about="#FINA2209">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FINCE"/>
  <hasUnitOutcomes rdf:resource="#identify the obligations of the provider of personal financial advice and discuss ethical considerations faced by personal financial advice providers."/>
  <hasUnitOutcomes rdf:resource="#identify and critically review the regulatory, investment, budgeting and personal advisory issues impacting the provision of personal financial advice."/>
  <hasUnitOutcomes rdf:resource="#identify available investment opportunities utilising rapidly-changing innovations to construct an investment portfolio for a client."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the role of taxation and superannuation in financial planning."/>
  <hasUnitOutcomes rdf:resource="#outline the importance and components of an effective estate plan and asset protection plan."/>
  <hasUnitOutcomes rdf:resource="#develop effective communication skills."/>
  <hasUnitAssessments rdf:resource="#individual activities"/>
  <hasUnitAssessments rdf:resource="#group assignment"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement927"/>
  <hasPrerequisiteUnits rdf:resource="#FINA1221"/>
  <hasPrerequisiteUnits rdf:resource="#FINX1221"/>
  <hasPrerequisiteUnits rdf:resource="#FINA2221"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA2209</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Planning</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit equips students with the knowledge and expertise necessary for the provision of financial advice to individuals concerned about their personal and family finances. It covers the role and obligations of the financial planner; identification of the regulatory, investment, budgeting and personal advisory issues in financial planning; identification of the available investments and the tools used to hedge against risks; understanding the role of taxation in financial planning, the importance of superannuation and estate planning; and likely regulatory and financial markets developments in the field and a survey of the most promising areas for research. The unit also covers the structure and the design of a typical financial plan.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA1221 Introduction to Finance or FINX1221 Introduction to Finance or FINA2221 Introduction to Finance</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#identify the obligations of the provider of personal financial advice and discuss ethical considerations faced by personal financial advice providers.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the obligations of the provider of personal financial advice and discuss ethical considerations faced by personal financial advice providers.</hasOutcomeDescription>
</owl:NamedIndividual>

