<owl:NamedIndividual rdf:about="#ARTF3030">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FNART"/>
  <hasUnitOutcomes rdf:resource="#locate your creative work within critical/theoretical, historical and contemporary contexts relevant to art and technology."/>
  <hasUnitOutcomes rdf:resource="#self-generate modes of creative inquiry using various approaches to support an individualised creative art practice."/>
  <hasUnitOutcomes rdf:resource="#produce a coherently evolving body of creative work that advances a personal vocabulary and vision."/>
  <hasUnitOutcomes rdf:resource="#demonstrate advanced technical mastery to articulate your creative work in the field of Art &amp; Biotechnologies."/>
  <hasUnitOutcomes rdf:resource="#critically evaluate your practice within the relevant contemporary cultural, historical, social and professional contexts through the use of a range of presentation skills."/>
  <hasUnitOutcomes rdf:resource="#synthesise critical and analytical thinking effectively in written, oral and creative modes."/>
  <hasUnitAssessments rdf:resource="#creative work"/>
  <hasUnitAssessments rdf:resource="#written work"/>
  <hasUnitAssessments rdf:resource="#oral presentation"/>
  <hasContactRequirement rdf:resource="#contactrequirement175"/>
  <hasPrerequisiteUnits rdf:resource="#ARTF2030"/>
  <hasPrerequisiteUnits rdf:resource="#ARTF2031"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF3030</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Art and Biotechnologies</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Design School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In this unit students will continue to develop and extend their techno-scientific skills, knowledge and techniques acquired in Level 2 so that they can advance and refine their capacity to make art that is engaged with biotechnological expertise. Students will respond to our increasingly techno-scientific society by engaging with the aesthetic, cultural and ethical issues concerned with the use of biotechnologies in the creation of art. Students continue to cultivate their independent work practices, artistic research and concept development so that they can take greater command of the direction of their art in preparation for the capstone Advanced Major Project unit in Semester 2.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Completion of 12 points of level 2 Fine Arts units (ARTF-coded units), including ARTF2030 Art and Life Manipulation and/or ARTF2031 Art and the Life Sciences</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#locate your creative work within critical/theoretical, historical and contemporary contexts relevant to art and technology.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locate your creative work within critical/theoretical, historical and contemporary contexts relevant to art and technology.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate advanced technical mastery to articulate your creative work in the field of Art &amp; Biotechnologies.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced technical mastery to articulate your creative work in the field of Art &amp; Biotechnologies.</hasOutcomeDescription>
</owl:NamedIndividual>

