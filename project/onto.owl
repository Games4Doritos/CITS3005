  <hasPrerequisite rdf:resource="#HART1003"/>
  <hasPrerequisite rdf:resource="#HART1000"/>
  <hasPrerequisite rdf:resource="#VISA1000"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART2043</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zen to Manga: A Survey of Japanese Art</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the art and visual culture of Japan, with an emphasis on the modern period.  As an introduction to the artistic practices and aesthetic principles of Japanese culture, this unit offers a broad history of Japan through a close consideration of specific artists and material traditions.  From Hokusai's Great Wave, to in the indoor surfing clubs of Tokyo, from Zen tea bowls, to the Manga empire of Takashi Murakami, this unit encourages interactive engagement with Japanese art through objects, images, and experiences. Over the semester, students will examine a wide array of topics, including Buddhist art, the politics of craft, and the complexities of cultural appropriation, ultimately enhancing their interpretive skills through hands-on learning, site-visits, oral presentations, and written work.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART1000 Great Moments in Art (formerly VISA1000) or HART1003 Ways of Seeing: Themes and Theories in Art</hasPrerequisiteText>
</owl:NamedIndividual>

