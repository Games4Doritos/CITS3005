  <hasPrerequisite rdf:resource="#POLS1101"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IREL3002</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Politics of Human Rights</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human rights have become a central issue in international politics, observable in the increasing number of political claims for human rights that have been advanced in recent decades. This unit examines the theory and politics of human rights in a global context. It first considers different normative approaches to conceptualising human rights, and their contested philosophical foundations. It then analyses the politics of human rights through a range of empirical cases, which may include refugees, security, citizenship, development justice, and climate change.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of POLS1102 Understanding Global Politics or POLS1101 Understanding Politics and Policy</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2104">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and analyse the development of the human rights discourse and its significance in international politics.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2105">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the strengths and weaknesses of key normative and philosophical approaches to human rights.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2106">
