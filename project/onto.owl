  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret questions, problems and instructions written in the terminology of engineering thermodynamics.</hasOutcomeDescription>
</owl:NamedIndividual>

