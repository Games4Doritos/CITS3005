<owl:NamedIndividual rdf:about="#MJD-POLSC">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#Demonstrate advanced knowledge about the nature of politics and the functions of diverse political ideas, theories, actors, institutions and systems."/>
  <hasMajorOutcomes rdf:resource="#Critically evaluate key political and policy dynamics at local, national, transnational, regional and international levels."/>
  <hasMajorOutcomes rdf:resource="#Creatively apply critical thinking and problem-solving skills to independently and collaboratively address challenges, crises and change in the political world."/>
  <hasMajorOutcomes rdf:resource="#Competently apply basic Political Science and International Relations methods and skills to designing and executing social research."/>
  <hasMajorOutcomes rdf:resource="#Effectively communicate political knowledge, ideas, analyses and arguments in different formats."/>
