  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of fundamental concepts in probability and statistical inference.</hasOutcomeDescription>
</owl:NamedIndividual>

