  <isInMajor rdf:resource="#major27"/>
  <isInMajor rdf:resource="#MJD-MBIOL"/>
  <isInMajor rdf:resource="#MJD-MARCP"/>
  <hasUnitOutcome rdf:resource="#outcome2837"/>
