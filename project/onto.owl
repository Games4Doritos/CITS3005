</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4293">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the important characteristics of sound generation and transmission.</hasOutcomeDescription>
</owl:NamedIndividual>

