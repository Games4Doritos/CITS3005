<owl:NamedIndividual rdf:about="#FREN1402">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 2"/>
  <hasTeachingPeriod rdf:resource="#Summer teaching period"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-FRNHB"/>
  <hasUnitOutcome rdf:resource="#outcome1176"/>
  <hasUnitOutcome rdf:resource="#outcome1177"/>
  <hasUnitOutcome rdf:resource="#outcome1178"/>
