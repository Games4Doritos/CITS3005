  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH3022</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scientific and Industrial Modelling</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to partial differential equations, continuum mechanics, wave and diffusion models. It discusses the essential properties of these models and their solutions. The unit presents the archetypal examples from physics, industry and biology of these types of problems.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
