<owl:NamedIndividual rdf:about="#MUSC3571">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MEMSD"/>
  <isInMajors rdf:resource="#major25"/>
  <hasUnitOutcomes rdf:resource="#develop effective strategies for self directed research and practice."/>
  <hasUnitOutcomes rdf:resource="#develop a high level of practical skills in appropriate sound and, if applicable, image technology."/>
  <hasUnitOutcomes rdf:resource="#summarise and communicate via written and verbal means, inventive conceptual/theoretical frameworks."/>
  <hasUnitOutcomes rdf:resource="#selectively use digital media applications to develop and demonstrate sound sketches, prototypes and models."/>
  <hasUnitOutcomes rdf:resource="#complete and present a cohesive conceptual model for the development of well resolved sound art works."/>
  <hasUnitAssessments rdf:resource="#written proposal"/>
  <hasUnitAssessments rdf:resource="#portfolio of sound sketches/prototypes"/>
  <hasUnitAssessments rdf:resource="#seminar participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement408"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC2273"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC2274"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC2276"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC2277"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3571</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sound Art: Advanced Studio</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a conceptual development unit that prepares a student for completion of their sound design studies in the final capstone unit MUSC3572 Sound Art: Major Project. Students research theoretical concepts and explore the practical development of works that conceptually model an advanced creative sound art proposal. In addition to the development of preparatory sound sketches, prototypes and models, all students are expected to participate in peer group discussion seminars and develop a written proposal that effectively communicates their creative goals and technical requirements for a major sound art project in MUSC3572.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any two units selected from: MUSC2273 Electronic Music: Generative Processes. MUSC2274 Electronic Music: Experimental Investigations. MUSC2276 Sound, Image and Space. MUSC2277 Electronic Music: Interactive Systems</hasPrerequisiteText>
</owl:NamedIndividual>

