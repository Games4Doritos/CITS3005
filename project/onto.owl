  <hasUnitAssessment rdf:resource="#assessment14"/>
  <hasUnitAssessment rdf:resource="#assessment37"/>
  <hasContactRequirement rdf:resource="#contactrequirement117"/>
  <hasContactRequirement rdf:resource="#contactrequirement118"/>
  <hasOutcome rdf:resource="#outcome1938"/>
  <hasOutcome rdf:resource="#outcome1939"/>
  <hasOutcome rdf:resource="#outcome1940"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1352</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre: Oklahoma! to Hamilton</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will investigate the history of the musical and its evolution to current musical theatre works.  Students will examine various style and forms within theatrical productions of music, discuss libretti and dramatic content, and identify performance traditions that occur within entire shows, specific productions, and individual songs. Case studies from a range of musical theatre shows (including a range of Broadway, West End, and international productions) will be used to illustrate the discussions.  
 
This unit is open to all enrolled students who have an interest in music. No prior experience is necessary.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1938">
