  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converse in Korean on everyday topics and express their own views with an intermediate understanding of Korean grammar and phonology.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1723">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply written Korean language skills to compose intermediate-level passages for different purposes.</hasOutcomeDescription>
