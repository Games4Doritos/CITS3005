  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use modern programming languages to apply theoretical ideas to data.</hasOutcomeDescription>
</owl:NamedIndividual>

