  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use a multiphysics computational modelling software to design and analyse a medical device, such as a neurostimulator.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3831">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess demand and the regulatory requirements involved when bringing a medical device to market.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3832">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse risk and safety associated with the development of medical devices, including relevant standards associated with the clinical investigation of medical devices and ethical principles for medical research involving human subjects.</hasOutcomeDescription>
</owl:NamedIndividual>

