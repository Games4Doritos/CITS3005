  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply key concepts in sociolinguistics and features of major approaches to language variation in social context.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate a critical understanding of sociolinguistic concepts and methods as employed in designing, implementing and reporting the results of an original research project.">
