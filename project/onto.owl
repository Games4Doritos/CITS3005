</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3137">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and exploit the notions of sets, functions, relations, and cardinality.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3138">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate rigorous proofs using abstract number systems and associated algebraic objects.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3139">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">employ the axiomatic definition of an abstract vector space, of linear transformations and of linear independence.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3140">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and apply the relationship between a spectral decomposition of a vector space and the diagonalisation of certain linear transformations.</hasOutcomeDescription>
</owl:NamedIndividual>

