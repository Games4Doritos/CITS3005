  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply random signal analysis to modelling and filtering.</hasOutcomeDescription>
</owl:NamedIndividual>

