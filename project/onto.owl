  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the fundamental divisions of the microbial world including bacteria, viruses, protozoa, algae and parasites.</hasOutcomeDescription>
</owl:NamedIndividual>

