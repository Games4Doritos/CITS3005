<owl:NamedIndividual rdf:about="#CHIN1401">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-CHNSB"/>
  <hasUnitOutcomes rdf:resource="#master Pinyin."/>
  <hasUnitOutcomes rdf:resource="#speak by imitating sentence patterns learned, and have attained minimum survival proficiency in four basic skills—comprehension, speaking, reading and writing."/>
  <hasUnitOutcomes rdf:resource="#communicate mainly with simple phrases and sentences."/>
  <hasUnitOutcomes rdf:resource="#recognise and understand a range of short, simple texts that are often heard and seen."/>
  <hasUnitOutcomes rdf:resource="#understand Chinese language in its social and cultural contexts which encourages an understanding of differences as well as the similarities between culture of origin and the culture of the target community."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#workbook and oral  presentation"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement48"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN1401</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chinese 1</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is open to students with no previous knowledge of modern standard Chinese ONLY. It provides a basic introduction to contemporary spoken and written Chinese (Mandarin or Putonghua). The primary focus is on giving elementary instruction in the various facets of modern standard Chinese: comprehension and speaking, reading and writing. The first few weeks of the semester concentrates on the learning of the Pinyin system (Romanisation). In addition, there is a series of lectures on the key features of both the spoken language and the Chinese script. Successful completion of this unit brings students to the ISLPR Level 1 (International Second Language Proficiency Ratings) or New HSK Level 1 (New Chinese Proficiency Test) or CEFR A1 (Common European Framework of Reference for Languages).</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#master Pinyin.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">master Pinyin.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#speak by imitating sentence patterns learned, and have attained minimum survival proficiency in four basic skills—comprehension, speaking, reading and writing.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">speak by imitating sentence patterns learned, and have attained minimum survival proficiency in four basic skills—comprehension, speaking, reading and writing.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#communicate mainly with simple phrases and sentences.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate mainly with simple phrases and sentences.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#recognise and understand a range of short, simple texts that are often heard and seen.">
