<owl:NamedIndividual rdf:about="#outcome3808">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and recognise structural components of the body in gross anatomical terms.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3809">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the overall body plan and the organisational levels in the structure of the human body, from cells to organ systems.</hasOutcomeDescription>
