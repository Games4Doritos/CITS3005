  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop generic skills in experimental planning, data analysis and interpretation.</hasOutcomeDescription>
</owl:NamedIndividual>

