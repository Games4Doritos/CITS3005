<owl:NamedIndividual rdf:about="#GENE2220">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-GENET"/>
  <hasUnitOutcomes rdf:resource="#define the structural and molecular characteristics of genes and chromosomes, and how they differ between prokaryotes and eukaryotes."/>
  <hasUnitOutcomes rdf:resource="#interpret the molecular mechanisms and general principles by which genes are regulated in prokaryotic and eukaryotic organisms."/>
  <hasUnitOutcomes rdf:resource="#explain how variation in gene content can arise and be measured, and can account for phenotypic change including disease."/>
  <hasUnitOutcomes rdf:resource="#demonstrate how core molecular genetics knowledge can be applied to solve practical problems relating to agriculture, health and the bioeconomy."/>
  <hasUnitOutcomes rdf:resource="#acquire and apply technical skills applicable to the molecular life sciences."/>
  <hasUnitAssessments rdf:resource="#workshop and practical assessments"/>
  <hasUnitAssessments rdf:resource="#in-semester tests"/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement744"/>
  <hasContactRequirement rdf:resource="#contactrequirement745"/>
  <hasContactRequirement rdf:resource="#contactrequirement746"/>
  <hasPrerequisiteUnits rdf:resource="#IMED1001"/>
  <hasPrerequisiteUnits rdf:resource="#IMED1002"/>
  <hasPrerequisiteUnits rdf:resource="#SCIE1106"/>
  <hasPrerequisiteUnits rdf:resource="#SCIX1106"/>
  <hasPrerequisiteUnits rdf:resource="#IMED1003"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENE2220</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Genetics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit will equip students with a foundation in modern molecular genetics applicable to a wide range of organisms. Students will gain insight into: chromosome structure; mechanisms of transcription and translation; regulation of gene expression; mechanisms of mutation and DNA repair; genetic variation; cell cycle control; and methods for determining gene function. Emphasis will be placed on emerging applications dependent on molecular genetics, including synthetic biology and RNA-based technologies. The unit will have a flipped format with pre-recorded lectures paired with self-study materials. Knowledge will be consolidated through in-person, active-learning workshops. Practical experience will be gained through laboratory sessions featuring routine methods in molecular genetics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IMED1001 Form and Function and IMED1002 The Facts of Life or SCIE1106 Molecular Biology of the Cell or SCIX1106 Molecular Biology of the Cell or IMED1003 Cell Survival and Communication</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#define the structural and molecular characteristics of genes and chromosomes, and how they differ between prokaryotes and eukaryotes.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define the structural and molecular characteristics of genes and chromosomes, and how they differ between prokaryotes and eukaryotes.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#interpret the molecular mechanisms and general principles by which genes are regulated in prokaryotic and eukaryotic organisms.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret the molecular mechanisms and general principles by which genes are regulated in prokaryotic and eukaryotic organisms.</hasOutcomeDescription>
</owl:NamedIndividual>

