<owl:NamedIndividual rdf:about="#MICR3310">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MCBIM"/>
  <hasUnitOutcomes rdf:resource="#describe the ecological roles and activities of microbes in the natural environment, the human host, animal reservoirs and at the human-animal interface."/>
  <hasUnitOutcomes rdf:resource="#explain the principles and appropriate use of a range of environmental microbiology techniques including water quality analysis, the effects of environmental variables on microbial activity, biogeochemical cycling and the application of microbes to pollution remediation."/>
  <hasUnitOutcomes rdf:resource="#communicate scientific findings using group and individual scientific writing activities."/>
  <hasUnitOutcomes rdf:resource="#analyse microbial genomic and surveillance datasets, and scientific publications."/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasUnitAssessments rdf:resource="#group assignment"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasContactRequirement rdf:resource="#contactrequirement782"/>
  <hasContactRequirement rdf:resource="#contactrequirement783"/>
  <hasPrerequisiteUnits rdf:resource="#MICR2208"/>
  <hasPrerequisiteUnits rdf:resource="#MICR2209"/>
  <hasPrerequisiteUnits rdf:resource="#IMED2001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MICR3310</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbial Ecology and One Health</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit describes the importance of microbes in human and animal ecosystems, and in nature. The unit presents concepts and principles in microbial ecology including the role of the human microbiome in health and disease, microorganisms at the interface between animals and humans, endemic and epidemic disease. The roles of infectious disease surveillance, interventions to prevent infectious disease transmission and probiotic interventions are considered. Key ecological roles of microbes including in terrestrial and aquatic ecosystems, interactions with biota and the physicochemical environment, and their consequences (beneficial and detrimental) for human activities are investigated. In addition to expanding their breadth of knowledge of microbiology, students will develop analytical skills for interpreting microbial datasets, and practical laboratory skills.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MICR2208 Introductory Microbiology and MICR2209 Introduction to Infectious Diseases and Immunology or MICR2208 Introductory Microbiology and IMED2001 Body Defences</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#describe the ecological roles and activities of microbes in the natural environment, the human host, animal reservoirs and at the human-animal interface.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the ecological roles and activities of microbes in the natural environment, the human host, animal reservoirs and at the human-animal interface.</hasOutcomeDescription>
</owl:NamedIndividual>

