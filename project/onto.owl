  <hasContactRequirement rdf:resource="#contactrequirement445"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2345</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre: Exploring Characterisation</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Great characters are central to the success of a musical theatre production. Therefore, the choices that composers, librettists, and directors make to shape their character and bring them to life are central to the creative process.
In this unit, students will begin by analysing a selection of book musicals and jukebox musicals from a dramaturgical, musical, and choreographic perspective separately to understand how each aspect functions in these works. Students will then combine these analytical methodologies with in-class case studies and an independent research project. These studies will allow students to develop a deeper understand of musical theatre functions from a variety of perspectives. This unit is open to all students who have an interest in music.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of level 1 24 points</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#discuss developments in book and jukebox musicals and identify stylistic characteristics of these works.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss developments in book and jukebox musicals and identify stylistic characteristics of these works.</hasOutcomeDescription>
</owl:NamedIndividual>

