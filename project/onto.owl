  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the properties and behaviour of the four classes of biomaterials.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3835">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain how the human body responds to an implanted biomaterial.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3836">
