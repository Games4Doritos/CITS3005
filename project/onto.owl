<owl:NamedIndividual rdf:about="#ENVE4401">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#articulate key chemical concepts and processes of significance for contaminant cycling."/>
  <hasUnitOutcomes rdf:resource="#quantify temporal and spatial scales of importance for the fate and transport of pollutants."/>
  <hasUnitOutcomes rdf:resource="#define control volumes and use a systems approach to solve environmental contamination problems."/>
  <hasUnitOutcomes rdf:resource="#assimilate presented data and utilise them for problem solving."/>
  <hasUnitOutcomes rdf:resource="#provide estimates of contaminant concentrations under given scenarios."/>
  <hasUnitAssessments rdf:resource="#individual and/or group assignments"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasPrerequisiteDegrees rdf:resource="#62550"/>
  <hasContactRequirement rdf:resource="#contactrequirement1061"/>
  <hasPrerequisiteUnits rdf:resource="#GENG2010"/>
  <hasPrerequisiteUnits rdf:resource="#GENG2003"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVE4401</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contaminant Fate and Transport</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers both the chemical and physical processes relevant to the transport of contaminants through the natural environment and the contaminants' eventual fate—either destruction or long-term storage. Students learn about the processes that govern the fate and transport of many classes of contaminants in three major environmental media—surface water, the subsurface environment and the atmosphere. Topics such as photochemical smog, acid sulphate soils and the mobility of fertilisers are covered.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Environmental Engineering specialisation or Chemical Engineering specialisation) or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of ( 96 points and ( GENG2010 Principles of Hydraulics or GENG2003 Fluid Mechanics )</hasPrerequisiteText>
</owl:NamedIndividual>

