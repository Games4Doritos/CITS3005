  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse the available data and literature sources for threatened species and use the data to develop a recovery or management plan.</hasOutcomeDescription>
</owl:NamedIndividual>

