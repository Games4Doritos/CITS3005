  <hasContactRequirement rdf:resource="#contactrequirement922"/>
  <hasPrerequisiteUnits rdf:resource="#MATH0700"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON1111</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quantitative Methods for Business and Economics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is designed to prepare students' quantitative capabilities to the standard required for further study in business and other relevant fields. Topics include linear and non-linear functions, basic calculus, financial mathematics, and probability and introductory statistics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Applications (ATAR) or WACE Mathematics 2C/2D or TEE Discrete Mathematics or MATH0700 Preparatory Mathematics</hasPrerequisiteText>
</owl:NamedIndividual>

