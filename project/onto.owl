  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe their everyday experiences and needs.</hasOutcomeDescription>
</owl:NamedIndividual>

