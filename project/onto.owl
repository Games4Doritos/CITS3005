  <hasUnitOutcome rdf:resource="#outcome3055"/>
  <hasUnitAssessment rdf:resource="#assessment325"/>
  <hasUnitAssessment rdf:resource="#assessment613"/>
  <hasUnitAssessment rdf:resource="#assessment37"/>
  <hasPrerequisiteDegree rdf:resource="#CM005"/>
  <hasContactRequirement rdf:resource="#contactrequirement37"/>
  <hasContactRequirement rdf:resource="#contactrequirement238"/>
