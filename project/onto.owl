<owl:NamedIndividual rdf:about="#PHYS1021">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#laboratory classes"/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1720"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1720"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1721"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1721"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1722"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS1021</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Physics A</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers (1) basics—measurement and units; (2) mechanics—motion in one dimension, force, work and energy, motion in two dimensions, linear momentum; (3) bodies in equilibrium, elasticity and fracture; (4) vibrations and waves; and (5) fluids. The content is strongly biologically focused.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Applications ATAR or MATH1720 Mathematics Fundamentals or MATX1720 Mathematics Fundamentals or Mathematics Methods ATAR or MATH1721 Mathematics Foundations: Methods or MATX1721 Mathematics Foundations or Mathematics Specialist ATAR or MATH1722 Mathematics Foundations: Specialist or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PHYS2004">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-QCOMP"/>
  <hasUnitOutcomes rdf:resource="#analyse the concepts and physical principles involved in the foundations of quantum mechanics."/>
  <hasUnitOutcomes rdf:resource="#communicate ideas, both orally and written, relating to the foundations of quantum mechanics."/>
  <hasUnitOutcomes rdf:resource="#communicate ideas, both orally and written, relating to the foundations of relativity."/>
  <hasUnitOutcomes rdf:resource="#execute an experiment relevant to physics."/>
  <hasUnitOutcomes rdf:resource="#analyse the concepts and physical principles involved in the foundations of relativity."/>
  <hasUnitOutcomes rdf:resource="#analyse the results of an experiment relevant to physics."/>
  <hasUnitAssessments rdf:resource="#mid-semester tests and assignments"/>
  <hasUnitAssessments rdf:resource="#laboratory"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement971"/>
  <hasContactRequirement rdf:resource="#contactrequirement972"/>
  <hasPrerequisiteUnits rdf:resource="#PHYS1021"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS2004</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quantum and Relativity</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The content of this unit introduces and develops the foundations and interpretations of quantum theory and relativity. Quantum theory explains the world at the smallest scales, while relativity explains the relationships between space, time and matter. Both theories continue to be experimentally verified with extraordinary precision and are central to the ongoing technological revolution that humankind is creating. Despite the phenomenal power of these theories, their predictions are at odds with our everyday experience of the world, and their more profound interpretations are still debated. In this unit, students are introduced to the foundations and interpretations of these theories and a range of applications and physical contexts.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of PHYS1021 Applied Physics A or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

