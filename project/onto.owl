<owl:NamedIndividual rdf:about="#CLAN2103">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-CLANH"/>
  <hasUnitOutcomes rdf:resource="#translate prepared selected passages of largely and completely unadapted classical Latin."/>
  <hasUnitOutcomes rdf:resource="#demonstrate understanding of the morphology and syntax of all common classical Latin inflections and constructions."/>
  <hasUnitOutcomes rdf:resource="#demonstrate a broad knowledge of Latin vocabulary."/>
  <hasUnitOutcomes rdf:resource="#translate unseen passages of simple or simplified classical Latin without reference books."/>
  <hasUnitOutcomes rdf:resource="#write a short study on the literary or historical significance of one or more Latin texts."/>
  <hasUnitAssessments rdf:resource="#in-class tests"/>
  <hasUnitAssessments rdf:resource="#a commentary"/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasContactRequirement rdf:resource="#contactrequirement82"/>
  <hasPrerequisiteUnits rdf:resource="#CLAN2102"/>
  <hasPrerequisiteUnits rdf:resource="#LATN2201"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN2103</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Latin 3</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is the final stage of instruction in the rudiments of the language's morphology and (especially) syntax. It is also the introduction to reading short unadapted passages of original Latin prose and verse, and to the literary and historical study of Latin writers. Students meet with all the usual constructions of classical Latin and a reasonable percentage of the most common vocabulary. They are well placed to begin the in-depth study of individual texts in CLAN3104 Latin 4.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
