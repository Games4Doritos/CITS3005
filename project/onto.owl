<owl:NamedIndividual rdf:about="#SPAN3813">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-SPNHB"/>
  <hasUnitOutcomes rdf:resource="#develop oral and written skills in Spanish."/>
  <hasUnitOutcomes rdf:resource="#gain a panoramic knowledge of literature in Spanish."/>
  <hasUnitOutcomes rdf:resource="#situate literary texts in their historical, political, social and cultural contexts."/>
  <hasUnitOutcomes rdf:resource="#learn specialised vocabulary associated with literary texts, forms, genres and styles."/>
  <hasUnitOutcomes rdf:resource="#hone critical and analytical skills through the close reading of literary texts."/>
  <hasUnitAssessments rdf:resource="#in-class participation"/>
  <hasUnitAssessments rdf:resource="#in-class test"/>
  <hasUnitAssessments rdf:resource="#oral presentation"/>
  <hasContactRequirement rdf:resource="#contactrequirement538"/>
  <hasContactRequirement rdf:resource="#contactrequirement539"/>
  <hasPrerequisiteUnits rdf:resource="#SPAN2404"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPAN3813</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Literature in Spanish</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This specialist unit, taught in Spanish, enables learners to consolidate their language competencies in writing, reading, listening and speaking in Spanish through the critical analysis of literary works by authors from a range of Spanish-speaking countries. This survey of literature in Spanish introduces students to the breadth of literary expression in Spanish by studying a wide range of its forms and genres, typically including prose, poetic, musical and visual genres, allowing students to hone critical and analytical skills, and gain an understanding of the texts' contexts of production.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPAN2404 Spanish Studies 4</hasPrerequisiteText>
</owl:NamedIndividual>

