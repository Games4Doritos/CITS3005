  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to chemistry in the workplace.</hasOutcomeDescription>
</owl:NamedIndividual>

