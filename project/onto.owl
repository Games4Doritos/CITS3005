</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#understand how the ocean's physical processes influence its biological characteristics.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how the ocean's physical processes influence its biological characteristics.</hasOutcomeDescription>
</owl:NamedIndividual>

