  <hasPrerequisite rdf:resource="#MKTG1203"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG3304</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brand Management</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brands are intangible, but extremely valuable. Many organisations maintain competitive advantage based on the value of their brand; their brand equity. How, though, do we build and manage brands? This unit will answer this question, exposing you to real-world branding situations and decisions. You will learn about the concept of brand equity, and which strategic and tactical brand management decisions are necessary to build and maintain it.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MKTG1203 Introduction to Marketing Successful completion of any level 2 Unit(s) MJD-MRKTG Marketing</hasPrerequisiteText>
</owl:NamedIndividual>

