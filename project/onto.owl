<owl:NamedIndividual rdf:about="#HIST2224">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-HISTY"/>
  <isInMajors rdf:resource="#MJD-CRIMN"/>
  <isInMajors rdf:resource="#major13"/>
  <hasUnitOutcomes rdf:resource="#assess the basic historiographical issues characteristic of US History through the lens of crime and punishment."/>
  <hasUnitOutcomes rdf:resource="#evaluate the historiographical problems posed by interrogating the histories and theories of crime and punishment in the United States."/>
  <hasUnitOutcomes rdf:resource="#demonstrate a detailed understanding of the US histories of punishment."/>
  <hasUnitOutcomes rdf:resource="#locate appropriate sources for research essays."/>
