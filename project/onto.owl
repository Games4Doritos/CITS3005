  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read and interpret original literature, documents and artworks in relation to their influence from and transformation of Classical models.</hasOutcomeDescription>
</owl:NamedIndividual>

