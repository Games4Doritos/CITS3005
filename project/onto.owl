  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a critical understanding of central topics in the philosophy of art.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2039">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">independently interpret complex philosophical texts in aesthetics from a variety of historical and contemporary sources.</hasOutcomeDescription>
</owl:NamedIndividual>

