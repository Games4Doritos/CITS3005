  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB3330</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Structure and Function - Head and Neck</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on head and neck and teaches the relevant embryology, gross anatomy, functional application and imaging to ensure a holistic understanding of human anatomy.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
