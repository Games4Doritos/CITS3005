  <hasPrerequisite rdf:resource="#SPAN1402"/>
  <hasPrerequisite rdf:resource="#SPAN1401"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPAN2812</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Culture in Spanish</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This specialist unit, taught in Spanish, enables learners to consolidate their language competencies in writing, reading, listening and speaking through the critical analysis of textual, audio and visual sources from the media and the arts. Through the study of cultural sources, taken from the media and the arts, and related to topics ranging from geography, history and economy, through music, cinema and gastronomy, this unit allow students to engage with issues of contemporary significance in the Spanish-speaking world and to familiarize themselves with the breadth of Hispanic cultures.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPAN1402 Spanish Studies 2</hasPrerequisiteText>
</owl:NamedIndividual>

