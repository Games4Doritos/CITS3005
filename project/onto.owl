  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work in teams to a write preliminary design cost estimation reports.</hasOutcomeDescription>
</owl:NamedIndividual>

