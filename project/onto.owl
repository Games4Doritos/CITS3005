  <hasUnitOutcomes rdf:resource="#conduct culturally appropriate, simple conversations, adjusting terms of address according to social status."/>
  <hasUnitOutcomes rdf:resource="#understand simple texts and write a short series of original sentences related to their own transactional needs and on topics related to everyday life."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
