  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop and enhance communication skills – written, visual and oral.</hasOutcomeDescription>
</owl:NamedIndividual>

