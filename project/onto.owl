  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">translate from Latin, without the aid of dictionaries, simple passages composed of a set vocabulary.</hasOutcomeDescription>
</owl:NamedIndividual>

