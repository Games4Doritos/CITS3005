<owl:NamedIndividual rdf:about="#MECH2003">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EMECH"/>
  <hasUnitOutcomes rdf:resource="#describe the manufacturing processes and behaviours of materials as used in engineering practice."/>
  <hasUnitOutcomes rdf:resource="#explain how the features and limitations of various manufacturing methods and materials are the key to success in engineering design work."/>
  <hasUnitOutcomes rdf:resource="#analyse a mechanical engineering component to determine the likely methods used in its manufacture and joining."/>
  <hasUnitOutcomes rdf:resource="#select an appropriate manufacturing method for a given geometry and material."/>
  <hasUnitOutcomes rdf:resource="#demonstrate how design and manufacturing choices influence the recycling of a component and the circular economy."/>
  <hasUnitOutcomes rdf:resource="#demonstrate personal initiative in individual and group work."/>
  <hasUnitAssessments rdf:resource="#practical class homework and assignments"/>
  <hasUnitAssessments rdf:resource="#laboratories"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement1132"/>
  <hasContactRequirement rdf:resource="#contactrequirement1133"/>
  <hasContactRequirement rdf:resource="#contactrequirement1134"/>
  <hasPrerequisiteUnits rdf:resource="#ENSC1004"/>
  <hasPrerequisiteUnits rdf:resource="#GENG1101"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MECH2003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturing</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers manufacturing methods including casting, joining, metal working, machining and finishing for a range of materials such as metals, polymers, composites (including concrete), and ceramics. Various relationships between material structure, manufacturing processes, component recycling and material properties are highlighted. The unit also covers design for assembly and disassembly and considerations on how design affects the circular economy.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and ENSC1004 Engineering Materials and GENG1101 Engineering Drawings</hasPrerequisiteText>
</owl:NamedIndividual>

