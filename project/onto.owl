</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome719">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compose simple but informative sentences and passages in Chinese characters.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome720">
  <rdf:type rdf:resource="#Outcome"/>
