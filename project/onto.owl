<owl:NamedIndividual rdf:about="#MATH3034">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MATHS"/>
  <hasUnitOutcomes rdf:resource="#explain and exploit the notions of extension of linear functionals and separation of convex sets."/>
  <hasUnitOutcomes rdf:resource="#identify the difference between weak and strong topologies."/>
  <hasUnitOutcomes rdf:resource="#define and utilise functional spaces and exploit the notion of compactness."/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement876"/>
  <hasContactRequirement rdf:resource="#contactrequirement877"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1013"/>
  <hasPrerequisiteUnits rdf:resource="#MATH2031"/>
  <hasPrerequisiteUnits rdf:resource="#MATH2030"/>
  <hasPrerequisiteUnits rdf:resource="#MATH2501"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH3034</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional Analysis</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit provides students with a foundation in functional analysis, with emphasis on the Hahn-Banach theorem, the uniform boundedness principle, the closed graph theorem, weak topologies, functional spaces, compactness in functional spaces and linear operators.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1013 Mathematical Analysis or MATH2031 Introduction to Pure Mathematics or MATH2030 Metric Spaces &amp; Measure Theory or MATH2501 Advanced Mathematical Methods</hasPrerequisiteText>
</owl:NamedIndividual>

