  <hasPrerequisiteUnits rdf:resource="#LAWS2301"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS2201"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS3222</hasUnitCode>
