         xmlns="https://www.handbooks.uwa.edu.au/onto.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="https://www.handbooks.uwa.edu.au/onto.owl"/>

<owl:ObjectProperty rdf:about="#hasUnits">
  <rdfs:domain rdf:resource="#UnitSet"/>
  <rdfs:range rdf:resource="#Unit"/>
  <rdfs:domain rdf:resource="#Major"/>
  <owl:inverseOf rdf:resource="#isInMajors"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isInMajors">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Major"/>
  <owl:inverseOf rdf:resource="#hasUnits"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutcomes">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="#Outcome"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLocations">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPrerequisites">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasContactType">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ContactRequirement"/>
  <rdfs:range rdf:resource="#ContactType"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMajorOutcomes">
  <rdfs:subPropertyOf rdf:resource="#hasOutcomes"/>
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Outcome"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAvailableInDegree">
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Degree"/>
  <owl:inverseOf rdf:resource="#hasMajors"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMajors">
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#Major"/>
  <owl:inverseOf rdf:resource="#isAvailableInDegree"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMajorLocations">
  <rdfs:subPropertyOf rdf:resource="#hasLocations"/>
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Location"/>
  <owl:inverseOf rdf:resource="#hasMajorsAvailable"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMajorsAvailable">
  <rdfs:domain rdf:resource="#Location"/>
  <rdfs:range rdf:resource="#Major"/>
  <owl:inverseOf rdf:resource="#hasMajorLocations"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCoreUnits">
  <rdfs:subPropertyOf rdf:resource="#hasUnits"/>
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBridgingUnits">
  <rdfs:subPropertyOf rdf:resource="#hasUnits"/>
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDegreeLocations">
  <rdfs:subPropertyOf rdf:resource="#hasLocations"/>
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#Location"/>
  <owl:inverseOf rdf:resource="#hasDegreesAvailable"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDegreesAvailable">
  <rdfs:domain rdf:resource="#Location"/>
  <rdfs:range rdf:resource="#Degree"/>
  <owl:inverseOf rdf:resource="#hasDegreeLocations"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#comprisesDegrees">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#BachelorDegree"/>
        <rdf:Description rdf:about="#HonoursDegree"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTeachingPeriods">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#TeachingPeriod"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnitLocations">
  <rdfs:subPropertyOf rdf:resource="#hasLocations"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnitModes">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#UnitMode"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnitOutcomes">
  <rdfs:subPropertyOf rdf:resource="#hasOutcomes"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Outcome"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnitAssessments">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Assessment"/>
</owl:ObjectProperty>

