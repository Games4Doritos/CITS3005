  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate effectively in written technical reports.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#simplify a practical steel structure in the design process.">
