<owl:NamedIndividual rdf:about="#ENGL3602">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EGCST"/>
  <hasUnitOutcomes rdf:resource="#demonstrate sophisticated knowledge of Shakespeare's plays and their legacies."/>
  <hasUnitOutcomes rdf:resource="#demonstrate a comparable understanding of film, print and stage presentation of Shakespeare's plays."/>
  <hasUnitOutcomes rdf:resource="#create and understand connections between literary texts and broader sociocultural, political and historical contexts."/>
  <hasUnitOutcomes rdf:resource="#apply and evaluate research findings."/>
  <hasUnitOutcomes rdf:resource="#express arguments coherently and imaginatively in oral and written formats."/>
  <hasUnitAssessments rdf:resource="#tutorial participation"/>
  <hasUnitAssessments rdf:resource="#critical exercise"/>
  <hasUnitAssessments rdf:resource="#essay"/>
  <hasContactRequirement rdf:resource="#contactrequirement145"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS2018"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENGL3602</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shakespeare: Page, Stage, Screen</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores Shakespeare's original texts as the basis for understanding creative decisions that shape filmic versions of Shakespeare's plays and theatre performance. Focusing on literary and dramatic elements which underpin Shakespeare's complex plays and their realisation in performance, intellectual, historical and cultural contexts of Shakespeare's ideas and different approaches to performing Shakespeare throughout history, the unit encourages students to think critically about individual directorial approaches to issues supported by Shakespeare's works, and about the works' continued relevance in our world.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any Level 2 ENGL unit or LAWS2018 Law Literature</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate sophisticated knowledge of Shakespeare's plays and their legacies.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate sophisticated knowledge of Shakespeare's plays and their legacies.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate a comparable understanding of film, print and stage presentation of Shakespeare's plays.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a comparable understanding of film, print and stage presentation of Shakespeare's plays.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply and evaluate research findings.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply and evaluate research findings.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#contactrequirement145">
  <rdf:type rdf:resource="#ContactRequirement"/>
