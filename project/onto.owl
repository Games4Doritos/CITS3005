  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the key moments and international instruments in the establishment of the contemporary human rights regime.</hasOutcomeDescription>
</owl:NamedIndividual>

