  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain cooperation or conflict in the workplace.</hasOutcomeDescription>
</owl:NamedIndividual>

