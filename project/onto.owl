<owl:NamedIndividual rdf:about="#MUSC2442">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MUSCO"/>
  <hasUnitOutcomes rdf:resource="#demonstrate proficiency in performing, composing, and/or recording contemporary popular music."/>
  <hasUnitOutcomes rdf:resource="#apply theoretical knowledge of and practical proficiency in creative project planning."/>
  <hasUnitOutcomes rdf:resource="#apply effective strategies for self-directed collaborative and practice music making skills."/>
  <hasUnitOutcomes rdf:resource="#analyse the processes involved in creative development."/>
  <hasUnitAssessments rdf:resource="#portfolio and exegesis"/>
  <hasUnitAssessments rdf:resource="#collaborative music project"/>
  <hasUnitAssessments rdf:resource="#journal"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC2441"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2442</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 4</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit consolidates and builds upon essential skills and concepts learnt in Contemporary Popular Music Principal Studies 3.  Students will develop skills and learn fundamental concepts to support their own unique Contemporary Popular music practice, including performance, songwriting, and acoustic recording techniques.  Students will work collaboratively to produce their own portfolio in either an original or recontextualised performance or recording.  Applying their own creative focus, they will also learn the foundational approaches in microphone and recording techniques to record acoustic instruments and voice.  As part of developing a portfolio, students will prepare a project plan incorporating sketches and demos, and these will form the basis of their final project in the following semester's capstone unit in the Principal Studies sequence.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2441 Contemporary Popular Music Principal Studies 3</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply theoretical knowledge of and practical proficiency in creative project planning.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply theoretical knowledge of and practical proficiency in creative project planning.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply effective strategies for self-directed collaborative and practice music making skills.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply effective strategies for self-directed collaborative and practice music making skills.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#portfolio and exegesis">
  <rdf:type rdf:resource="#Assessment"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC3441">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MUSCO"/>
  <hasUnitOutcomes rdf:resource="#design a large scale creative project from concept through to presentation, working both independently and collaboratively."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an advanced level of practical skill in performing, composing, and/or recording contemporary popular music."/>
  <hasUnitOutcomes rdf:resource="#create and apply effective strategies and practices to achieve creative goals."/>
  <hasUnitOutcomes rdf:resource="#analyse the processes involved in creative development."/>
  <hasUnitAssessments rdf:resource="#portfolio and exegesis"/>
  <hasUnitAssessments rdf:resource="#collaborative music project"/>
  <hasUnitAssessments rdf:resource="#journal"/>
  <hasPrerequisiteUnits rdf:resource="#MUSC2442"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3441</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Popular Music Principal Studies 5</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit facilitates students developing and presenting a professional performance or recorded work (EP) with an accompanying written exegesis that explores a specific creative thesis.  Students will realise their major project, as planned in the previous Principal Studies unit, and will learn professional skills and concepts to support their own unique Contemporary Popular music practice.  Students will work collaboratively to produce their own professional EP or live performance, and will learn the techniques required for song production and mixing.  The final music project is expected to be suitable for, and shared publicly via, live performance or online presentation.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC2442 Contemporary Popular Music Principal Studies 4</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#design a large scale creative project from concept through to presentation, working both independently and collaboratively.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design a large scale creative project from concept through to presentation, working both independently and collaboratively.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate an advanced level of practical skill in performing, composing, and/or recording contemporary popular music.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an advanced level of practical skill in performing, composing, and/or recording contemporary popular music.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#create and apply effective strategies and practices to achieve creative goals.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">create and apply effective strategies and practices to achieve creative goals.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MUSC3538">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major25"/>
  <isInMajors rdf:resource="#MJD-MUSCO"/>
  <isInMajors rdf:resource="#MJD-MUSMT"/>
  <hasUnitOutcomes rdf:resource="#articulate a professional skill set, goals, and values as a musician."/>
  <hasUnitOutcomes rdf:resource="#demonstrate knowledge of the institutional, educational, promotional, economic and professional aspects of the music industry and the collection of careers it encompasses."/>
  <hasUnitOutcomes rdf:resource="#apply music industry knowledge to create a meaningful and feasible plan for the next phase of their musical careers."/>
  <hasUnitAssessments rdf:resource="#initial portfolio"/>
  <hasUnitAssessments rdf:resource="#reflective journal and participation"/>
  <hasUnitAssessments rdf:resource="#final portfolio"/>
  <hasPrerequisiteDegrees rdf:resource="#BP008"/>
  <hasContactRequirement rdf:resource="#contactrequirement436"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC3538</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professional Skills: Music Industry and Artist</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit helps students develop skills in building a career as a musician or in a music-related field. Students will explore a variety of strands to a professional musical career, which may include aspects such as applying for grants, preparing a pitch to a festival director, understanding musicians health and wellbeing, negotiating artistic residencies, cultivating an audience, studio and classroom teaching, arts administration, dealing with copyright and royalties or marketing and promotion, and managing a portfolio career. The unit also guides students in exploring what type of artist they would like to be, and what they value as artists, culminating in the development of a their own personal set of artistic and career development goals.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one level 2 6 points Unit(s) BP008 Bachelor of Music or one level 2 6 points Unit(s) MJD-MUSCO Contemporary Popular Music</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#articulate a professional skill set, goals, and values as a musician.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate a professional skill set, goals, and values as a musician.</hasOutcomeDescription>
</owl:NamedIndividual>

