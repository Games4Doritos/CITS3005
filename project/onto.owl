  <hasLocation rdf:resource="#Albany"/>
  <isInMajor rdf:resource="#MJD-ZOOLY"/>
  <isInMajor rdf:resource="#MJD-BOTNY"/>
  <isInMajor rdf:resource="#MJD-MBIOL"/>
  <isInMajor rdf:resource="#MJD-MCBIM"/>
  <isInMajor rdf:resource="#MJD-PHYGY"/>
  <isInMajor rdf:resource="#MJD-NEURS"/>
  <isInMajor rdf:resource="#MJD-CONBI"/>
  <isInMajor rdf:resource="#MJD-GENET"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIOL1130</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frontiers in Biology</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the origins and definitions of life, and the processes that led to today's incredibly diverse array of organisms, from viruses to vertebrates. Unifying patterns and concepts are demonstrated, such as the structure and function of cells, how cells reproduce, how traits particular to a species are passed to new generations, and how the inheritance of DNA is the basis of evolution and the formation of species. The unit appeals to students wishing to begin their training as a biological scientist and who are interested in learning about topics that are challenging and fascinating our leading researchers.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

