  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop convincing, coherent, and consistent written arguments based on evidence.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HIST2215">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 2"/>
  <hasUnitLocation rdf:resource="#Albany"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
