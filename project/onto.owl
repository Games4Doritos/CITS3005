<owl:NamedIndividual rdf:about="#MJD-CLANH">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#describe the chief eras, achievements and enduring legacies of the classical world."/>
  <hasMajorOutcomes rdf:resource="#assess various forms (written and material) of evidence used to study the classical world, and synthesise such diverse evidence."/>
  <hasMajorOutcomes rdf:resource="#demonstrate in several areas of specialised study a sophisticated appreciation of, and a basic command of research practice into, specific eras, methodologies, or classical authors."/>
  <hasMajorOutcomes rdf:resource="#demonstrate a basic understanding of at least one of the classical languages."/>
  <isAvailableInDegree rdf:resource="#BP001"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasCoreUnits rdf:resource="#CLAN1001"/>
  <hasCoreUnits rdf:resource="#CLAN1002"/>
