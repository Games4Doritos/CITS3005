  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HRMT2237</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Resource Management</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
