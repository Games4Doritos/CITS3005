  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the role of the management accountant in the organisation.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3186">
