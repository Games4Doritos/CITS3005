  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG1150</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aboriginal Encounters: Strangers in our Backyard</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the often contested historical realities of Aboriginal experience in postcolonial Australia. Significant eras in shaping an Australian national identity are deconstructed in order to highlight the cultural, social and political impact on, and from, the Aboriginal nation. The unit also explores how collective historical experiences transmit and transform over time.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

