  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply research, communication and design skills applicable across the creative and media industries.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#COMM3006">
