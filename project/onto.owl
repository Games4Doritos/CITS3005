<owl:NamedIndividual rdf:about="#ENVT3307">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#develop an appreciation for the basic laws of physics that describe fluid motion in the ocean."/>
  <hasUnitOutcomes rdf:resource="#understand the major driving forces of ocean circulation."/>
  <hasUnitOutcomes rdf:resource="#understand how the ocean's physical processes influence its biological characteristics."/>
  <hasUnitOutcomes rdf:resource="#analyse and interpret physical and biological oceanographic datasets in real world applications."/>
  <hasUnitAssessments rdf:resource="#quizzes"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#examinations"/>
  <hasContactRequirement rdf:resource="#contactrequirement770"/>
  <hasContactRequirement rdf:resource="#contactrequirement771"/>
  <hasPrerequisiteUnits rdf:resource="#SCIE2204"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3307</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oceanography</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Earth Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers an introduction to the physics of the ocean; physical properties of sea water; global distribution of temperature and salinity; dynamics governing motion in the ocean; barotropic and baroclinic ocean circulation; heat and salt budgets; water mass formation; major ocean biogeochemical cycles; the dynamics of coastal primary to secondary biological production; and the interaction of ocean processes with benthic biological communities.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) SCIE2204 Marine Systems</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#develop an appreciation for the basic laws of physics that describe fluid motion in the ocean.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an appreciation for the basic laws of physics that describe fluid motion in the ocean.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#understand the major driving forces of ocean circulation.">
  <rdf:type rdf:resource="#Outcome"/>
