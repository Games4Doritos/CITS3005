<owl:NamedIndividual rdf:about="#FREN2812">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FRNHI"/>
  <isInMajors rdf:resource="#MJD-FRNHA"/>
  <hasUnitOutcomes rdf:resource="#analyse French and francophone films in an aesthetic, social and historical framework."/>
  <hasUnitOutcomes rdf:resource="#demonstrate writing and research skills in the context of French and francophone film."/>
  <hasUnitOutcomes rdf:resource="#use oral, aural and interpersonal skills through classroom discussions in French."/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasUnitAssessments rdf:resource="#research essay"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement181"/>
  <hasContactRequirement rdf:resource="#contactrequirement182"/>
  <hasPrerequisiteUnits rdf:resource="#FREN2405"/>
  <hasPrerequisiteUnits rdf:resource="#FREN2407"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2812</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Cinema</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit integrates French speaking, reading, writing and aural comprehension skills with materials drawn from the history of French and francophone cinema. Students are introduced to the vocabulary and critical concepts of film studies and explore key films from different periods, ranging from silent films of the late nineteenth century through to New Wave films of the 1960s and twenty-first century films addressing social issues. This unit focuses on developing academic writing skills in French and deepening students' understanding of the aesthetics and history of film and of French and francophone culture and society.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2405 French Studies 5 or FREN2407 French Studies 7</hasPrerequisiteText>
</owl:NamedIndividual>

