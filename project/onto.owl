  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe, analyse and interpret culture, history and society in French-speaking regions.</hasOutcomeDescription>
</owl:NamedIndividual>

