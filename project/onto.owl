  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and evaluate the historiographical problems posed by the historical interpretation of imperial America.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate detailed knowledge of the major events and key political and cultural movements in United States history from 1845 to present.">
