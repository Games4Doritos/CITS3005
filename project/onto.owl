  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">validate a program's input data and external connections.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2614">
