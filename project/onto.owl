<owl:NamedIndividual rdf:about="#MINE3405">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EMINE"/>
  <hasUnitOutcomes rdf:resource="#demonstrate critical thinking and information literacy."/>
  <hasUnitOutcomes rdf:resource="#practise enquiry-based thinking relevant to the discipline."/>
  <hasUnitOutcomes rdf:resource="#explain the structure and geological setting of the world's main mineral resources."/>
  <hasUnitOutcomes rdf:resource="#exhibit knowledge of topics such as the distribution, origins, and characteristics of mineral systems."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the application of statistical and geostatistical methods to assessing various aspects of mineral resources."/>
  <hasUnitOutcomes rdf:resource="#explain the basic techniques in mineral resource modelling including geostatistics."/>
  <hasUnitAssessments rdf:resource="#in-class quizzes"/>
  <hasUnitAssessments rdf:resource="#project assignments"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement1149"/>
  <hasContactRequirement rdf:resource="#contactrequirement1150"/>
  <hasPrerequisiteUnits rdf:resource="#GENG2000"/>
  <hasPrerequisiteUnits rdf:resource="#MINE2001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINE3405</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mineral Resources</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers topics such as the distribution, origins, and characteristics of mineral systems (gold, base metals, iron ore, alumina, mineral sands and coal), methods of exploration for them, and issues related to mining and extraction. Mineral resource modelling procedures are covered, including geostatistics (semi-variograms and Kriging), wireframe modelling, block modelling, grade estimation and the JORC reporting code.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of GENG2000 Engineering Practice 2 and MINE2001 Fundamentals of Mining Engineering</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#practise enquiry-based thinking relevant to the discipline.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">practise enquiry-based thinking relevant to the discipline.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#explain the structure and geological setting of the world's main mineral resources.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the structure and geological setting of the world's main mineral resources.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#exhibit knowledge of topics such as the distribution, origins, and characteristics of mineral systems.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhibit knowledge of topics such as the distribution, origins, and characteristics of mineral systems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate the application of statistical and geostatistical methods to assessing various aspects of mineral resources.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the application of statistical and geostatistical methods to assessing various aspects of mineral resources.</hasOutcomeDescription>
