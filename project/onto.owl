<owl:NamedIndividual rdf:about="#ANIM3361">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#acquire a knowledge of population parameters and use them to produce population models."/>
  <hasUnitOutcomes rdf:resource="#understand how models are used to manage and conserve animal populations."/>
  <hasUnitOutcomes rdf:resource="#understand how populations interact with populations of the same and different species and model those responses."/>
  <hasUnitOutcomes rdf:resource="#use statistics to analyse data either collected during practical sessions or provided from field experiments."/>
  <hasUnitOutcomes rdf:resource="#articulate the main characteristics of communities and the divergent theories on how diversity is generated and maintained."/>
  <hasUnitOutcomes rdf:resource="#be able to apply theories of community organisation to conservation and management."/>
  <hasUnitOutcomes rdf:resource="#use multivariate techniques to analyse community data."/>
  <hasUnitOutcomes rdf:resource="#critically assess recent and relevant literature."/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasUnitAssessments rdf:resource="#data analysis and interpretation exercises"/>
  <hasUnitAssessments rdf:resource="#mid-semester in-class test"/>
  <hasContactRequirement rdf:resource="#contactrequirement836"/>
  <hasContactRequirement rdf:resource="#contactrequirement837"/>
  <hasPrerequisiteUnits rdf:resource="#ANIM2220"/>
  <hasPrerequisiteUnits rdf:resource="#ENVT2250"/>
  <hasPrerequisiteUnits rdf:resource="#ANIM2207"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANIM3361</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Animal Ecology</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biological Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit analyses the way animal populations fluctuate and use resources in space and time. It considers how individuals within populations interact with each other and with individuals in populations of other species, including those interactions that contribute to the determination of the biodiversity apparent in communities today. It covers population parameters such as age structure, birth and death rates and how these are used to construct life tables and population models. Theories and empirical evidence as to how biodiversity has developed over time and is currently maintained are considered along with discussion of how biodiversity contributes to ecosystem function and how that biodiversity should be managed and conserved.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of Unit(s) ANIM2220 Animal Diversity or Unit(s) ENVT2250 Ecology (ID 1228) or Unit(s) ANIM2207 Animal Form and Function</hasPrerequisiteText>
</owl:NamedIndividual>

