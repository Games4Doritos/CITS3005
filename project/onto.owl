  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">create research outputs in appropriate written and oral forms based on the collection and interpretation of archaeological information.</hasOutcomeDescription>
</owl:NamedIndividual>

