  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an awareness of how the principles of human/primate socioecology can inform the study of human biology.</hasOutcomeDescription>
</owl:NamedIndividual>

