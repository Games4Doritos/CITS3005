  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate effective musical leadership skills and techniques in a range of performance settings.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1899">
  <rdf:type rdf:resource="#Outcome"/>
