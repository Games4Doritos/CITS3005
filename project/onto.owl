  <hasUnitOutcomes rdf:resource="#show convergence of Fourier series and use them for applications to differential equations."/>
  <hasUnitOutcomes rdf:resource="#exploit the notion of Fourier transform, find the inverse and use these techniques to solve differential equations."/>
  <hasUnitAssessments rdf:resource="#tests"/>
