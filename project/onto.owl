  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop operating budgets and supporting schedules for the purpose of variance analysis, including direct cost and overhead cost variances.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3189">
  <rdf:type rdf:resource="#Outcome"/>
