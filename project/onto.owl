  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">situate your creative work in relation to the social and cultural context in which you are working.</hasOutcomeDescription>
</owl:NamedIndividual>

