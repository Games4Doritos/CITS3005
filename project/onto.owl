  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the differences and similarities between cinema and television.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome995">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the basic structures of screen dramas.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome996">
