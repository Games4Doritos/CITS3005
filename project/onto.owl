<owl:NamedIndividual rdf:about="#MJD-GENET">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#demonstrate knowledge of how traits are inherited and expressed, and the molecular basis of these processes."/>
  <hasMajorOutcomes rdf:resource="#demonstrate knowledge of prokaryotic and eukaryotic genome structure, content and evolution."/>
  <hasMajorOutcomes rdf:resource="#demonstrate knowledge of how genetic processes control development and disease in animals and plants."/>
  <hasMajorOutcomes rdf:resource="#demonstrate knowledge of how inheritance can explain diversity in natural populations, and be exploited in artificial breeding programs."/>
  <hasMajorOutcomes rdf:resource="#practise technologies and methodologies used in modern-day genetics and genomics."/>
  <hasMajorOutcomes rdf:resource="#develop skills in oral and written communication, experimental design, data analysis and interpretation, critical thinking, and problem solving."/>
  <isAvailableInDegree rdf:resource="#BP004"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasBridgingUnits rdf:resource="#CHEM1003"/>
  <hasBridgingUnits rdf:resource="#MATH1720"/>
  <hasBridgingUnits rdf:resource="#MATH1721"/>
  <hasCoreUnits rdf:resource="#BIOC1001"/>
