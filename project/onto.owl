  <hasMajorOutcomes rdf:resource="#develop and apply problem identification, exploration and solution skills in physical situations that range from simple to complex."/>
  <hasMajorOutcomes rdf:resource="#apply increasing levels of appropriate mathematical sophistication in the expression and communication of physical concepts."/>
  <hasMajorOutcomes rdf:resource="#develop in-depth understanding of the physical principles of measurement, experimental technique, quantitative analysis and data analysis."/>
  <hasMajorOutcomes rdf:resource="#develop and demonstrate skills relevant to the communication of physics concepts including writing, oral presentations, critical information literacy skills and interpersonal skills."/>
  <isAvailableInDegree rdf:resource="#BP004"/>
