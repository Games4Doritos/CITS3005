<owl:NamedIndividual rdf:about="#ARTF3000">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FNART"/>
  <hasUnitOutcomes rdf:resource="#maintain a disciplined approach to their art investigations and develop effective modes of self-directed practice."/>
  <hasUnitOutcomes rdf:resource="#develop a high level of practical skills in appropriate media and technology."/>
  <hasUnitOutcomes rdf:resource="#summarise and articulate inventive conceptual/theoretical frameworks."/>
