  <hasUnitOutcomes rdf:resource="#demonstrate effective musical leadership skills and techniques in a range of performance settings."/>
  <hasUnitOutcomes rdf:resource="#apply performance practices for studied repertoire to conducted ensemble performance."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of psychological processes underlying communicative gesture in musical ensembles."/>
  <hasUnitOutcomes rdf:resource="#contribute to the development of a collaborative musical interpretation."/>
  <hasUnitOutcomes rdf:resource="#demonstrate leadership techniques and outcomes as a conductor."/>
  <hasUnitOutcomes rdf:resource="#contribute towards a peer-reflection process involving the student's own work and that of other students."/>
  <hasUnitAssessments rdf:resource="#performance assessments"/>
