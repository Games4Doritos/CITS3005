<owl:NamedIndividual rdf:about="#LAWS3401">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-CRIMN"/>
  <isInMajors rdf:resource="#major13"/>
  <hasUnitOutcomes rdf:resource="#identify and analyse recent examples of emerging crime challenges."/>
  <hasUnitOutcomes rdf:resource="#explain the nature and impact of technology on crime."/>
  <hasUnitOutcomes rdf:resource="#critically assess legal and policy prevention responses to new crime challenges."/>
  <hasUnitOutcomes rdf:resource="#demonstrate advanced oral and written communication skills."/>
  <hasUnitOutcomes rdf:resource="#develop and apply skills in independent scholarly research."/>
  <hasUnitAssessments rdf:resource="#participation and engagement"/>
  <hasUnitAssessments rdf:resource="#case study analysis"/>
  <hasUnitAssessments rdf:resource="#research paper"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS2223"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS3401</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emerging Trends in Crime and Criminology</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Law School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores contemporary and evolving forms of crime, such as cybercrime, financial crime and corruption, environmental crime on land and sea, modern slavery, and emerging threats of terrorism. Students will critically analyse emerging crime types, the role of technology, and the responses of law and policy prevention frameworks in our globalised world. Through real-life case studies, debates, and practical assessments, students will develop analytical skills to understand modern crime threats and their potential responses.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS2223 Criminal Justice Systems</hasPrerequisiteText>
</owl:NamedIndividual>

