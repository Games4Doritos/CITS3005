<owl:NamedIndividual rdf:about="#BIOL3360">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Non-standard teaching period"/>
  <hasUnitLocation rdf:resource="#Albany"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-CONBI"/>
  <isInMajor rdf:resource="#major4"/>
