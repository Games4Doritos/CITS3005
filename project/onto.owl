</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KORE2811">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-KOREI"/>
  <hasUnitOutcome rdf:resource="#outcome1732"/>
  <hasUnitOutcome rdf:resource="#outcome1733"/>
  <hasUnitOutcome rdf:resource="#outcome1734"/>
