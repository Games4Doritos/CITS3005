  <isInMajor rdf:resource="#major33"/>
  <hasUnitOutcome rdf:resource="#outcome2741"/>
  <hasUnitOutcome rdf:resource="#outcome2742"/>
  <hasUnitOutcome rdf:resource="#outcome2743"/>
