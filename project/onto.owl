  <hasOutcome rdf:resource="#outcome1295"/>
  <hasOutcome rdf:resource="#outcome1154"/>
  <hasPrerequisiteUnit rdf:resource="#GRMN1402"/>
  <hasPrerequisiteUnit rdf:resource="#GRMN1401"/>
  <hasPrerequisite rdf:resource="#GRMN2403"/>
  <hasPrerequisite rdf:resource="#GRMN1402"/>
  <hasPrerequisite rdf:resource="#GRMN1401"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN2404</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">German Studies 4</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is intended for students who have completed GRMN2403 German Studies 3. The unit consolidates and improves the language ability of learners of German at an intermediate level and further develops cultural and linguistic awareness. In addition, students develop a better understanding of how languages work in general (both in the target language and in English). The seminar uses the discussion and analysis of German cultural productions such as film, literature and music as the basis for language acquisition, focusing on a range of sociopolitical themes and their connections to wider cultural phenomena. This is where students have the opportunity to develop their listening comprehension, reading and communication skills. The language class reinforces and deepens the knowledge of contemporary German language usage and grammatical structures. 
Students gain an increased level of competency in all four macro skills—listening to, speaking, reading and writing German—corresponding to Levels A2/B1 of the Common European Framework of Reference for Languages (Gemeinsamer Europaischer Referenzrahmen). Students also develop an increased awareness of intercultural understanding and language learning, as well as research skills and communication strategies.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN2403 German Studies 3</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1295">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to Levels A2/B1 of the Common European Framework of Reference for Languages.</hasOutcomeDescription>
</owl:NamedIndividual>

