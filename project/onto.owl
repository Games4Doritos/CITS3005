</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply high-level critical thinking and problem-solving skills to independently and collaboratively address challenges, crises and change in media's relations with the government and political actors.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply high-level critical thinking and problem-solving skills to independently and collaboratively address challenges, crises and change in media's relations with the government and political actors.</hasOutcomeDescription>
</owl:NamedIndividual>

