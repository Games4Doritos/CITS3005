<owl:NamedIndividual rdf:about="#MJD-QCOMP">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#evaluate the efficiency and complexity of both traditional and quantum algorithms."/>
  <hasMajorOutcomes rdf:resource="#design, implement, verify, test, and document robust and secure computer programs that can be executed on both traditional and quantum computers."/>
  <hasMajorOutcomes rdf:resource="#perform effectively in a quantum computing project team."/>
