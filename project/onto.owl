  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply research skills to link theoretical approaches and frameworks and appropriate methods to specific archaeological case studies.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#create research outputs in appropriate written and oral forms based on the collection and interpretation of archaeological information.">
