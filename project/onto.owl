  <hasPrerequisiteUnits rdf:resource="#GENG3000"/>
  <hasPrerequisiteUnits rdf:resource="#MINE3401"/>
  <hasPrerequisiteUnits rdf:resource="#MINE3503"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINE4001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mining Engineering Services</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines some of the service technologies typically involved at most mines. Topics include: (1) Dewatering for surface and underground operations; (2) surveying – technologies and processes for surface and underground survey; (3) electrification in surface and underground operations.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of GENG3000 Engineering Practice 3 and MINE3401 Underground Mining 1 and MINE3503 Surface Mining</hasPrerequisiteText>
</owl:NamedIndividual>

