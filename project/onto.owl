  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and describe the histological organisation and structure of human organs and.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply learning to differentiate human organs at the level of cells, tissues and organs by identifying, contrasting and describing key structural and functional features.">
