<owl:NamedIndividual rdf:about="#ENVE2606">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EENVE"/>
  <hasUnitOutcomes rdf:resource="#identify the emerging challenges the environmental engineering profession addresses."/>
  <hasUnitOutcomes rdf:resource="#access and analyse environmental and politico-social data and utilise them appropriately in the design process."/>
  <hasUnitOutcomes rdf:resource="#evaluate potential solutions from social, economic, environmental, ethical and regulatory/policy perspectives."/>
  <hasUnitOutcomes rdf:resource="#demonstrate awareness of their own learning and educational progress as engineers."/>
  <hasUnitAssessments rdf:resource="#challenge hackathons"/>
  <hasUnitAssessments rdf:resource="#client reports"/>
  <hasUnitAssessments rdf:resource="#reflective vlogs on the engineering method in everyday life"/>
  <hasContactRequirement rdf:resource="#contactrequirement1123"/>
  <hasPrerequisiteUnits rdf:resource="#GENG1010"/>
  <hasPrerequisiteUnits rdf:resource="#GENG1000"/>
  <hasPrerequisiteUnits rdf:resource="#GENG1014"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVE2606</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grand Challenges in Environmental Engineering</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is the third in a vertically integrated series of design units forming the “Design Spine” of the Environmental Engineering Major. You will already have completed GENG1000 Engineering Practice 1 and GENG1010 Introduction to Engineering. You may also have completed GENG2000 Engineering Practice 2.
In this unit, you will work on somewhat-constrained problems in a guided design process. The first step of any design process is to clearly understand the context and specifics of an issue, prior to stepping into the “solution space”. You will explore case studies of key challenges in environmental engineering, with a particular emphasis on recreating an authentic engineering problem solving scenarios that replicate the demands of engineering roles in industry (e.g., including simulated client and co-worker interactions).
The unit draws on the foundational knowledge and technical skills you have developed in years 1 and 2 and will prepare you for the Level 3 unit in the design spine sequence, “Designing as an Environmental Engineer”.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of GENG1010 Introduction to Engineering and GENG1000 Engineering Practice 1 and GENG1014 Earth Systems Engineering</hasPrerequisiteText>
</owl:NamedIndividual>

