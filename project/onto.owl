  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">justify the gas processing needs in the production of hydrogen from various sources.</hasOutcomeDescription>
