<owl:NamedIndividual rdf:about="#ITAL1404">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ITLNI"/>
  <hasUnitOutcomes rdf:resource="#demonstrate a degree of competency in spoken and written Italian that enables them to be confident users of the language in most situations they are likely to encounter in everyday life."/>
  <hasUnitOutcomes rdf:resource="#produce a narrative text."/>
  <hasUnitOutcomes rdf:resource="#describe people, places, events, opinions."/>
  <hasUnitOutcomes rdf:resource="#read and comprehend texts from contemporary literary and non-literary sources."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an increased awareness of how language works in general."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of certain historical, social and cultural aspects of Italian society."/>
  <hasUnitOutcomes rdf:resource="#demonstrate interpersonal communication skills including the ability to work effectively in pairs and small groups."/>
  <hasUnitOutcomes rdf:resource="#work independently."/>
