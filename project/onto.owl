  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1054</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theory for Electronic Musicians</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides a theoretical foundation for electronic music composition through practical engagement with the fundamental concepts of music theory, acoustics and digital audio. Students learn to play and recognise rhythmic patterns, scales, modes and fundamental chord progressions, with examples displayed within various notational systems. The fundamentals of digital audio are introduced, including sampling theory, as well as standard communication protocols such as MIDI. Students also examine the physical properties of sound as they relate to electronic music production, for instance in sound synthesis and effects processing.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1828">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a theoretical understanding of the fundamental concepts of rhythm including tempo, time signatures and rhythmic subdivision.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1829">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise basic rhythmic patterns by sight and by ear, and play these back through tapping, hand-drumming or other means.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1830">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of fundamental concepts of rhythm to create and improvise with basic rhythmic patterns.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1831">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a theoretical understanding of the fundamentals of scales, modes and chord progressions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1832">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge perform basic scales, modes and chord progressions on standard MIDI keyboard controller.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1833">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply knowledge of MIDI and digital audio hardware connectivity.</hasOutcomeDescription>
</owl:NamedIndividual>

