  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically explain and evaluate relevant ideas, theories and concepts that seek to explain cross-national variation in political and policy dynamics.</hasOutcomeDescription>
</owl:NamedIndividual>

