<owl:NamedIndividual rdf:about="#ELEC4402">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#apply filtering of random signals in the design of communication systems in the presence of random noise."/>
  <hasUnitOutcomes rdf:resource="#carry out noise analysis for analogue communication systems."/>
  <hasUnitOutcomes rdf:resource="#analyse and design digital communication systems over various channels."/>
  <hasUnitOutcomes rdf:resource="#analyse various analog modulation schemes in terms of system performance."/>
  <hasUnitOutcomes rdf:resource="#carry out performance analysis."/>
  <hasUnitOutcomes rdf:resource="#apply the basics of information theory in digital communications, and explain the basics of source coding and channel coding using simple examples."/>
  <hasUnitOutcomes rdf:resource="#work effectively in a team."/>
  <hasUnitAssessments rdf:resource="#laboratory reports"/>
  <hasUnitAssessments rdf:resource="#class tests and assignment"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasPrerequisiteDegrees rdf:resource="#62550"/>
