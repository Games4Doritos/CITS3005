  <hasUnitOutcomes rdf:resource="#analyse technical and literary aspects of films."/>
  <hasUnitOutcomes rdf:resource="#analyse representations of historical events in film, in the context of the time of production."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of Italian films in terms of the historical development of the genre."/>
  <hasUnitOutcomes rdf:resource="#use the Italian language in spoken and written form at Level B2/C1 of the Common European Framework of Reference for Languages."/>
  <hasUnitAssessments rdf:resource="#test"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#research essay"/>
  <hasContactRequirement rdf:resource="#contactrequirement337"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITAL3817</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Modern Italy in Film</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit studies social, historical and cultural aspects of Italian society through the analysis of Italian feature films. The unit covers the major periods of Italian cinematography in the last hundred years, focussing on major periods and directors. Secondary texts from the directors and their associates are also used as documentary and illustrative material.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Level 2 Italian unit</hasPrerequisiteText>
</owl:NamedIndividual>

