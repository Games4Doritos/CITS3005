  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement1151"/>
  <hasContactRequirement rdf:resource="#contactrequirement1152"/>
  <hasPrerequisiteUnits rdf:resource="#MINE2001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINE3503</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surface Mining</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers methods of surface mining and their development; how to understand and apply mine planning concepts including cut-off grades, pit optimisation and scheduling; how to select appropriate equipment for surface mining operations; how to select and design methods of drill-and-blast; and how to efficiently express technical information verbally and orally. Students are also trained for industry-standard mine design software to utilize as part of their learning activities.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of MINE2001 Fundamentals of Mining Engineering</hasPrerequisiteText>
</owl:NamedIndividual>

