<owl:NamedIndividual rdf:about="#EMPL3270">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-HRSMT"/>
  <isInMajors rdf:resource="#MJD-WKERL"/>
  <hasUnitOutcomes rdf:resource="#develop an informed and critical understanding of negotiation and conflict management processes."/>
  <hasUnitOutcomes rdf:resource="#develop improved negotiation skills, knowledge of negotiation theory, and the ability to reflect on the actual practice of negotiation."/>
  <hasUnitOutcomes rdf:resource="#work in teams in order to develop an original case study and then to apply and test relevant concepts from the academic literature on negotiation and conflict management."/>
  <hasUnitOutcomes rdf:resource="#develop interactive and cooperative negotiation skills."/>
  <hasUnitOutcomes rdf:resource="#develop effective reflection, presentation and report writing skills."/>
  <hasUnitAssessments rdf:resource="#tutorial activities"/>
  <hasUnitAssessments rdf:resource="#written assignment"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement545"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL3270</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Negotiation: Theory and Practice</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the collective and individual significance of negotiation and conflict management with particular reference to employment relations. It considers theories of conflict and various approaches to conflict resolution.  It also provides an introduction to negotiation as a process, including, among other topics, consideration of competitive and cooperative approaches to negotiation, social context, preparation, strategy and ethics.  Students examine case studies and undertake negotiation exercises to experience the practical aspects of the subject.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any two Level 2 units in the Human Resource Management major, Management major or Work and Employment Relations major</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#develop an informed and critical understanding of negotiation and conflict management processes.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an informed and critical understanding of negotiation and conflict management processes.</hasOutcomeDescription>
</owl:NamedIndividual>

