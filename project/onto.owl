  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collect quantitative environmental data through sampling and analysis of water, soil, sediment and biological samples.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2738">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically appraise such data using appropriate statistical methods and spatial analysis in RStudio such as ANOVA, regression analysis, non-parametric methods, and simple spatial analysis.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2739">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">convey environmental information quantitatively, based on rigorous statistical and scientific analysis.</hasOutcomeDescription>
