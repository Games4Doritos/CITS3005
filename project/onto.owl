<owl:NamedIndividual rdf:about="#PHIL3001">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-PHILY"/>
  <hasUnitOutcomes rdf:resource="#demonstrate a critical understanding of central topics in metaphysics."/>
  <hasUnitOutcomes rdf:resource="#independently interpret complex philosophical texts in metaphysics from a variety of historical and contemporary sources."/>
  <hasUnitOutcomes rdf:resource="#evaluate and compare complex philosophical arguments and positions in central topics in metaphysics."/>
  <hasUnitOutcomes rdf:resource="#demonstrate advanced written communication and research skills in argument construction about metaphysical concepts."/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement471"/>
  <hasContactRequirement rdf:resource="#contactrequirement472"/>
  <hasPrerequisiteUnits rdf:resource="#PPHE2211"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL3001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metaphysics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a unit that introduces you to the central problems of metaphysics. Students gain the resources to understand and critically engage with important philosophical arguments about such topics in metaphysics as time, personal identity, causation, emergence, and mereology. The unit may also explore important connections between metaphysics and other key areas of philosophy, such as epistemology and the philosophy of language.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any Level 2 Philosophy unit or PPHE2211</hasPrerequisiteText>
</owl:NamedIndividual>

