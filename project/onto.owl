  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSYC2203</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Research Methods and Analysis in Psychology I</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces a range of psychological research techniques and illustrates their strengths and weaknesses through the discussion of psychological research in areas such as cognition, clinical and developmental psychology. Students are instructed in the basic principles of research design and inferential decision making.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
