  <hasMajorOutcomes rdf:resource="#demonstrate effective networking and communication skills."/>
  <hasMajorOutcomes rdf:resource="#demonstrate competency in laboratory practice, report writing, oral presentation and team work skills suited to gain employment in the discipline of Agricultural Tecnology."/>
  <isAvailableInDegree rdf:resource="#BP004"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasBridgingUnits rdf:resource="#CHEM1003"/>
  <hasBridgingUnits rdf:resource="#MATH1720"/>
