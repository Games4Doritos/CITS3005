<owl:NamedIndividual rdf:about="#MJD-PHILY">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#analyse and evaluate arguments."/>
  <hasMajorOutcomes rdf:resource="#distinguish between good arguments and bad arguments, irrespective of their subject matter, and thus make informed decisions and recommendations on contentious issues."/>
  <hasMajorOutcomes rdf:resource="#demonstrate clarity of thought."/>
  <hasMajorOutcomes rdf:resource="#separate distinct issues, consider them independently and think out the consequences of positions on them."/>
  <hasMajorOutcomes rdf:resource="#demonstrate the general skills for thinking about problems and tasks, and framing and evaluating solutions."/>
  <hasMajorOutcomes rdf:resource="#frame, express and convey ideas, their own and other people's, in a clear and convincing way."/>
