  <hasOutcome rdf:resource="#outcome2746"/>
  <hasOutcome rdf:resource="#outcome2747"/>
  <hasOutcome rdf:resource="#outcome2748"/>
  <isInMajor rdf:resource="#MJD-SPTSC"/>
  <isInMajor rdf:resource="#MJD-EXHSC"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SSEH1101</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Musculoskeletal System and Movement</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers the following areas of study: (1) human movement—introduction to the anatomical basis of human movement via a series of lectures concurrently demonstrated by laboratory and field experiences; and (2) musculoskeletal anatomy—the principles of gross functional anatomy with special reference to the locomotor system.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

