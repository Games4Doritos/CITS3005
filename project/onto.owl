<owl:NamedIndividual rdf:about="#MATH3023">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#understand and employ the fundamental theorems of multivariable calculus."/>
  <hasUnitOutcomes rdf:resource="#understand and apply Green's theorem, Stokes' theorem and the Divergence theorem."/>
  <hasUnitOutcomes rdf:resource="#understand and employ complex analysis, particularly the method of residues."/>
  <hasUnitOutcomes rdf:resource="#understand and employ techniques of Fourier series."/>
  <hasUnitOutcomes rdf:resource="#employ methods of solution of both ordinary and partial differential equations."/>
  <hasUnitOutcomes rdf:resource="#understand any apply Sturm-Liouville theory."/>
  <hasUnitAssessments rdf:resource="#in-semester tests"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1011"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1011"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH3023</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Mathematics Applications</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from MATH1011 Multivariable Calculus and MATH1012 Mathematical Theory and Methods. It provides a foundation in some of the more advanced concepts and techniques of mathematics which are required in engineering. theory and applications are illustrated using examples from engineering in, for example, electromagnetism and fluid mechanics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus</hasPrerequisiteText>
</owl:NamedIndividual>

