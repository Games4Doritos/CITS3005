</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GRMN2403">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-GRMNB"/>
  <hasUnitOutcome rdf:resource="#outcome1294"/>
  <hasUnitOutcome rdf:resource="#outcome1154"/>
