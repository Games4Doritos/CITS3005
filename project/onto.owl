  <hasPrerequisiteUnit rdf:resource="#EART1105"/>
  <hasPrerequisiteUnit rdf:resource="#BIOL1131"/>
  <isInMajor rdf:resource="#MJD-MARCP"/>
  <isInMajor rdf:resource="#MJD-MBIOL"/>
  <hasPrerequisite rdf:resource="#EART1105"/>
  <hasPrerequisite rdf:resource="#SCIE2204"/>
  <hasPrerequisite rdf:resource="#BIOL1131"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3307</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oceanography</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers an introduction to the physics of the ocean; physical properties of sea water; global distribution of temperature and salinity; dynamics governing motion in the ocean; barotropic and baroclinic ocean circulation; heat and salt budgets; water mass formation; major ocean biogeochemical cycles; the dynamics of coastal primary to secondary biological production; and the interaction of ocean processes with benthic biological communities.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) SCIE2204 Marine Systems</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2880">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an appreciation for the basic laws of physics that describe fluid motion in the ocean.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2881">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the major driving forces of ocean circulation.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2882">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how the ocean's physical processes influence its biological characteristics.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2883">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse and interpret physical and biological oceanographic datasets in real world applications.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SCIE3304">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#Albany"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
