<owl:NamedIndividual rdf:about="#ARCY3003">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ARCGY"/>
  <hasUnitOutcomes rdf:resource="#understand how archaeological laboratory analysis informs archaeological analysis and theory."/>
  <hasUnitOutcomes rdf:resource="#understand the ethical issues related to different types of archaeological evidence."/>
  <hasUnitOutcomes rdf:resource="#apply specialised knowledge to operate within a laboratory environment proficiently and safely,."/>
  <hasUnitOutcomes rdf:resource="#apply specialised knowledge to correctly use appropriate equipment and procedures in relation to archaeological analytical categories such as stone tools, historical artefacts, sediments, stratigraphy, faunal and botanical remains, rock art and so on,."/>
  <hasUnitOutcomes rdf:resource="#create appropriate reports to professional standards on specific archaeological analytical topics."/>
  <hasUnitOutcomes rdf:resource="#evaluate different types of archaeological data with appropriate quantitative methods."/>
