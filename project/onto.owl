  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate the ability to evaluate the capital structures of particular companies and an awareness of current developments in this area.</hasOutcomeDescription>
</owl:NamedIndividual>

