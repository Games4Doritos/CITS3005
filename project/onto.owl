  <hasUnitOutcome rdf:resource="#outcome1913"/>
  <hasUnitOutcome rdf:resource="#outcome1914"/>
  <hasUnitOutcome rdf:resource="#outcome1915"/>
  <hasUnitOutcome rdf:resource="#outcome1916"/>
  <hasUnitOutcome rdf:resource="#outcome1917"/>
  <hasUnitOutcome rdf:resource="#outcome1918"/>
  <hasUnitAssessment rdf:resource="#assessment305"/>
  <hasUnitAssessment rdf:resource="#assessment306"/>
