  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the fundamental conservation laws of fluid mechanics.</hasOutcomeDescription>
</owl:NamedIndividual>

