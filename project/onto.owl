  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the operational characteristics of a range of chemical, electrical and pumped hydro energy storage technologies.</hasOutcomeDescription>
</owl:NamedIndividual>

