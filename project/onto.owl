  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the principles and concepts related to the preparation, structure, bonding and reactivity of metal complexes.</hasOutcomeDescription>
</owl:NamedIndividual>

