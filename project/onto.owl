  <hasCoreUnits rdf:resource="#SCIE1104"/>
  <hasCoreUnits rdf:resource="#SCIE1106"/>
  <hasCoreUnits rdf:resource="#GENE2220"/>
  <hasCoreUnits rdf:resource="#GENE2250"/>
  <hasCoreUnits rdf:resource="#AGRI3310"/>
  <hasCoreUnits rdf:resource="#BIOL3364"/>
  <hasCoreUnits rdf:resource="#GENE3350"/>
  <hasCoreUnits rdf:resource="#GENE3370"/>
  <hasMajorCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-GENET</hasMajorCode>
  <hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetics</hasMajorTitle>
  <hasMajorSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Sciences</hasMajorSchool>
  <hasMajorDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetics is the science of how traits are inherited and expressed by living organisms. This major encompasses the universal principles, potentials and problems associated with how biological information is encoded in nucleic acids. Students will learn how traits are inherited, how genetic processes control development and diseases, and how genomes evolve. Through a combination of hands-on laboratory sessions, independent and group work, interactive workshops and theoretical foundations, students will develop skills in critical thinking, experimental design, data interpretation, communication and evidence-based decision-making. As a cornerstone of the biological sciences, this major equips students with an adaptable and universal skillset applicable to a wide range of careers or further study.  Employment destinations include agricultural science, biodiversity and conservation, molecular diagnostics, pharmaceuticals, animal and plant breeding, fundamental and applied research, patent law, policy development and more.</hasMajorDescription>
</owl:NamedIndividual>

