<owl:NamedIndividual rdf:about="#ENVT3362">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ENVSC"/>
  <isInMajors rdf:resource="#major26"/>
  <isInMajors rdf:resource="#major5"/>
  <isInMajors rdf:resource="#major6"/>
  <isInMajors rdf:resource="#MJD-ENVMT"/>
  <isInMajors rdf:resource="#MJD-MARCP"/>
  <isInMajors rdf:resource="#major8"/>
  <isInMajors rdf:resource="#major2"/>
  <hasUnitOutcomes rdf:resource="#demonstrate a good knowledge of systems analysis, its terminology, core concepts and its use in environmental science."/>
  <hasUnitOutcomes rdf:resource="#develop an overview of model approaches and the utility of different types of models for understanding environmental systems."/>
  <hasUnitOutcomes rdf:resource="#develop conceptual models describing interactions and processes relevant to environmental systems, ranging from catchment to coast and considering both physical and ecological dimensions."/>
  <hasUnitOutcomes rdf:resource="#translate conceptual models into simple quantitative compartment models and demonstrate use of more advanced modelling packages."/>
  <hasUnitOutcomes rdf:resource="#assess how models can be used as decision support tools for environmental management, and understand the basic principles of model sensitivity and uncertainty assessment."/>
  <hasUnitAssessments rdf:resource="#modelling workbook"/>
  <hasUnitAssessments rdf:resource="#online theory quiz"/>
  <hasUnitAssessments rdf:resource="#written report"/>
  <hasContactRequirement rdf:resource="#contactrequirement708"/>
  <hasContactRequirement rdf:resource="#contactrequirement709"/>
  <hasPrerequisiteUnits rdf:resource="#ENVT2250"/>
  <hasPrerequisiteUnits rdf:resource="#ENVT2220"/>
  <hasPrerequisiteUnits rdf:resource="#ENVT2251"/>
  <hasPrerequisiteUnits rdf:resource="#SCIE2204"/>
  <hasPrerequisiteUnits rdf:resource="#EART2204"/>
  <hasPrerequisiteUnits rdf:resource="#SCIE2267"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT3362</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental Dynamics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agriculture and Environment</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decision making for managing environmental systems is increasingly guided by modelling studies in which risks to environmental condition are quantified and future scenarios are assessed. Students are introduced step-by-step to model building of environmental systems drawn from examples such as climate change and land-use change impacts on biodiversity, water and contaminant movement in natural and disturbed landscapes, rivers and also coastal systems. The unit covers issues including the use of models in decision support frameworks, uncertainty and model assessment methods.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) ENVT2250 Ecology or Unit(s) ENVT2220 The Climate System or Unit(s) ENVT2251 Hydrology and Water Resource Management or Unit(s) SCIE2204 Marine Systems or Unit(s) EART2204 Coastal Processes or Unit(s) SCIE2267 Quantitative Methods in Environmental Management</hasPrerequisiteText>
</owl:NamedIndividual>

