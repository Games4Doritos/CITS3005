  <hasUnitOutcomes rdf:resource="#appraise surface mining methods with respect to productivity, safety, efficiency, risks and sustainability."/>
  <hasUnitOutcomes rdf:resource="#describe major surface mining methods and their related equipment, supporting infrastructure, performance drivers, and constraints."/>
  <hasUnitOutcomes rdf:resource="#design deposit access and extraction layouts with respect to different surface mining methods."/>
  <hasUnitOutcomes rdf:resource="#demonstrate awareness of the major technological trends in surface mining methods and equipment."/>
  <hasUnitOutcomes rdf:resource="#identify major problems associated with surface mining and use systematic methods to resolve them."/>
  <hasUnitOutcomes rdf:resource="#produce high quality engineering communications related to surface mining operations."/>
  <hasUnitAssessments rdf:resource="#individual portfolio"/>
