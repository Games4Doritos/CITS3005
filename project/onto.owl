  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify further initiatives for Indigenous study in their respective university learning programs, community service activities, or future professional practices.</hasOutcomeDescription>
</owl:NamedIndividual>

