  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how the environment can be valued.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2693">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the importance of economic incentives to solving environmental problems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2694">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the essential elements of preparing a report on the economics of an environmental problem.</hasOutcomeDescription>
</owl:NamedIndividual>

