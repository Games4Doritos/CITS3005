  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deliver persuasive data narratives to varied business and professional audiences.</hasOutcomeDescription>
</owl:NamedIndividual>

