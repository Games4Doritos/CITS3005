<owl:NamedIndividual rdf:about="#ANHB3322">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#understand clearly defined questions and problems in human/primate socioecology."/>
  <hasUnitOutcomes rdf:resource="#acquire techniques for seeking out information or designing observations or experiments to answer such questions."/>
  <hasUnitOutcomes rdf:resource="#critically assimilate, analyse and discuss information acquired."/>
  <hasUnitOutcomes rdf:resource="#present findings in written and oral form."/>
  <hasUnitOutcomes rdf:resource="#develop an awareness of how the principles of human/primate socioecology can inform the study of human biology."/>
  <hasUnitOutcomes rdf:resource="#develop new scientific questions based on theory and literature, and methods to test such questions."/>
  <hasUnitAssessments rdf:resource="#tutorial participation"/>
  <hasUnitAssessments rdf:resource="#mid-semester theory examination"/>
  <hasUnitAssessments rdf:resource="#10- to 15-page semester paper"/>
  <hasContactRequirement rdf:resource="#contactrequirement592"/>
  <hasContactRequirement rdf:resource="#contactrequirement593"/>
  <hasPrerequisiteUnits rdf:resource="#ANHB2215"/>
  <hasPrerequisiteUnits rdf:resource="#ANHB3321"/>
  <hasPrerequisiteUnits rdf:resource="#ANHB3315"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB3322</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human/Primate Social Organisation</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit runs in even years only and complements ANHB3315 Human Evolutionary Ecology, which runs in odd years only. Emphasis is placed on applying evolutionary thinking to human/primate social organisation and its underlying individual strategies as well as the cognitive and cultural underpinnings of sociality. Topics to be covered include mate choice strategies, cooperation and conflict within and between groups, social learning and culture as well as cultural cognition.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) ANHB2215 Biological Anthropology: Human Adaptation and Variation or Unit(s) ANHB3321 Biological Anthropology: Genes and Society or Unit(s) ANHB3315 Human Evolutionary Ecology</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#understand clearly defined questions and problems in human/primate socioecology.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand clearly defined questions and problems in human/primate socioecology.</hasOutcomeDescription>
</owl:NamedIndividual>

