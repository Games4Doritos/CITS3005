  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL2002</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Logic: How to Defeat Your Foes with Reasoning</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Logic is the study of what follows from what. Understanding formal logic is therefore valuable for anyone wishing to construct persuasive arguments or evaluate the reasoning of others. This unit introduces students to powerful techniques for translating natural language arguments into formal logic and for testing those arguments for validity. As well as its general use in evaluating arguments, a knowledge of formal logic is essential to understanding a great deal of important twentieth-century philosophy.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 points of Level 1 units</hasPrerequisiteText>
</owl:NamedIndividual>

