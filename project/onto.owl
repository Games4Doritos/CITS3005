  <hasPrerequisiteUnit rdf:resource="#AGRI1001"/>
  <hasOutcome rdf:resource="#outcome2374"/>
  <hasOutcome rdf:resource="#outcome2372"/>
  <hasOutcome rdf:resource="#outcome2370"/>
  <hasOutcome rdf:resource="#outcome2375"/>
  <hasOutcome rdf:resource="#outcome2373"/>
  <hasOutcome rdf:resource="#outcome2371"/>
  <hasLocation rdf:resource="#Albany"/>
  <hasPrerequisite rdf:resource="#AGRI1001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIE3314</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crops and Cropping Systems</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on how agricultural systems in Western Australia are rapidly changing in response to the need for more environmentally responsible production methods and a changing climate.  The unit introduces the main temperate crop species and then uses a systems approach to provide an understanding of the relationships between crops, pastures, livestock, weeds, plant diseases and the environment. There is in-depth consideration of crop agronomy, conservation cropping, no-tillage and weed and disease control. Modelling as a tool to improve our understanding of complex agricultural systems is discussed and models evaluated.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) AGRI1001 Feeding the World</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2370">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the role of Australian and Western Australian grain production within global food supply systems, and identify the environmental, economic, and social factors that shape the structure and management of broadacre cropping enterprises.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2371">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse how Mediterranean-type climate patterns, soil constraints, and seasonal water balance dynamics in WA interact to determine crop management timing, variety selection, and production risk.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2372">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply principles of conservation agriculture, soil fertility management, cereal phenology, and break-crop agronomy to develop management recommendations appropriate to the conditions and constraints of WA broadacre farming systems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2373">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess the biological and economic impact of weeds, fungal diseases, insect pests, and soil-borne pathogens on grain production in WA, and formulate integrated management strategies that account for resistance mechanisms, economic thresholds, and environmental conditions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2374">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competence in using a process-based crop simulation model to predict crop growth, water use, and nitrogen response under varying management and climate scenarios, and critically evaluate model outputs to inform agronomic decision-making.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2375">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesise agronomic, environmental, financial, and crop protection knowledge to construct a professional agronomic management package for a major WA grain crop, including a gross margin analysis and a quantitative nitrogen management strategy.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment396">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agronomy report - Farm Interview and Agronomic Package report</hasAssessmentDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment397">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glasshouse trial - Cereal Derby</hasAssessmentDescription>
</owl:NamedIndividual>

