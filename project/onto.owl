  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collect quantitative environmental data through sampling and analysis of water, soil, sediment and biological samples.</hasOutcomeDescription>
</owl:NamedIndividual>

