  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMEG5552</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Engineering Design Project 2</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit is a capstone experience in which students integrate and apply knowledge and skills acquired in earlier units to a substantial real-world design challenge relevant to their discipline. Students work in teams, typically with four to six members, and are supervised by an academic and/or industry mentor. Teams are responsible for managing their project as well as reporting against milestones and preparing the necessary design documentation. The academic objectives of the unit are to lead students through a systematic engineering design and synthesis process and to better prepare them for professional practice as engineers. The focus of this unit is the delivery of outcomes to a professional standard.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMEG5551 Biomedical Engineering Design Project 1</hasPrerequisiteText>
</owl:NamedIndividual>

