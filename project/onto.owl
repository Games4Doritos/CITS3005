  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">laboratory reports and in-class quizzes</hasAssessmentDescription>
</owl:NamedIndividual>

