  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop efficient code and algorithms for robot manipulation and automation systems.</hasOutcomeDescription>
</owl:NamedIndividual>

