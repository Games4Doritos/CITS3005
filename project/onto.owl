  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify measurable physiological parameters relevant to human health.</hasOutcomeDescription>
</owl:NamedIndividual>

