  <hasPrerequisite rdf:resource="#MINE3401"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINE4504</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mine Ventilation</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In this unit, students develop technical competence and skills relevant to the ventilation planning of underground mining operations. They understand the key considerations associated with the development of an underground mine and its ventilation requirements. They gain experience in identifying the major problems associated with ventilation planning and in the use of systematic methods to resolve these issues.  
Topics covered and discussed in this unit are the fundamentals of mine ventilation, including principles of airflow, gas, dust and pollutants transport, ventilation network theory and mine ventilation system design, with the emphasis on analysis, systems design and practical application.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of MINE3401 Underground Mining</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4367">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical thinking and information literacy on mine ventilation engineering.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4368">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply engineering synthesis and design processes relevant to mine ventilation engineering.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4369">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the fundamental ventilation principles for underground mining operations.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4370">
