  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">investigate the inventive application of concepts and processes in drawing.</hasOutcomeDescription>
</owl:NamedIndividual>

