  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">work effectively as individuals and in diverse groups to produce effective key process design documentation and activities.</hasOutcomeDescription>
</owl:NamedIndividual>

