  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and apply practical skills and theoretical knowledge learned in their undergraduate degree to a workplace setting.</hasOutcomeDescription>
</owl:NamedIndividual>

