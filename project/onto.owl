  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">research a chosen neuroscience topic in depth and deliver a seminar on that topic.</hasOutcomeDescription>
</owl:NamedIndividual>

