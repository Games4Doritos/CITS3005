  <hasPrerequisiteUnits rdf:resource="#MATH1012"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1012"/>
  <hasPrerequisiteUnits rdf:resource="#CITS1401"/>
  <hasPrerequisiteUnits rdf:resource="#CITS2401"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2012</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data Collection and Analysis</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit helps students develop an understanding of how to collect and analyse data to characterise natural systems. Students are introduced to each step of the investigative process, starting from asking a scientific and sound question, developing a sampling strategy, collecting the data, analysing the data, testing the hypothesis and eventually drawing one or more conclusions.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of ( ( MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods and CITS1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation ) or  Enrolment in 62570 Master of Offshore and Coastal Engineering</hasPrerequisiteText>
</owl:NamedIndividual>

