  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of elementary Greek sentence structure.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#translate from Greek, without the aid of dictionaries, simple passages composed of a set vocabulary.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">translate from Greek, without the aid of dictionaries, simple passages composed of a set vocabulary.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#compose simple Greek sentences from a set vocabulary.">
  <rdf:type rdf:resource="#Outcome"/>
