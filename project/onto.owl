  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG2003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluid Mechanics</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the principles of conservation and momentum transfer in the flow of fluids. Topics discussed include the fundamental properties of fluids, hydrostatics, the general equations of fluid motion, dimensional analysis, fluid friction, pumps, pipe systems, flow in porous media and compressible flow.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62560 Master of Renewable and Future Energy or  Enrolment in 62570 Master of Offshore and Coastal Engineering or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of ( ( MATH1011 Multivariable Calculus and PHYS1001 Physics for Scientists and Engineers or MATX1011 Multivariable Calculus and PHYX1001 Physics for Scientists and Engineers ) )</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3815">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understanding the fundamental properties of fluids and their variations with changing state.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3816">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understanding the characteristics and analysis of laminar and turbulent flows.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3817">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deriving and applying the Navier-Stokes equations to develop and solve differential equations describing simple laminar flows and pressure fields in static fluids.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3818">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understanding and applying the macroscale mass, momentum and energy balances for incompressible and compressible fluid flows.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3819">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">developing and applying dimensional analyses to characterise complex flow phenomena.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3820">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analysis and basic design of pump and pipework systems.</hasOutcomeDescription>
</owl:NamedIndividual>

