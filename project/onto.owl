  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and apply basic science and engineering fundamentals to mine geotechnical engineering.</hasOutcomeDescription>
</owl:NamedIndividual>

