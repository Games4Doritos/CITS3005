  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe key global and Australian agricultural systems and the foods they produce to feed the world.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#investigate how agricultural research, combined with innovative technologies and farming systems, can meet global food and environmental challenges.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">investigate how agricultural research, combined with innovative technologies and farming systems, can meet global food and environmental challenges.</hasOutcomeDescription>
