  <isInMajor rdf:resource="#major25"/>
  <hasUnitOutcome rdf:resource="#outcome1947"/>
  <hasUnitOutcome rdf:resource="#outcome1948"/>
  <hasUnitOutcome rdf:resource="#outcome1949"/>
  <hasUnitOutcome rdf:resource="#outcome1950"/>
  <hasUnitOutcome rdf:resource="#outcome1917"/>
  <hasUnitOutcome rdf:resource="#outcome1918"/>
  <hasUnitAssessment rdf:resource="#assessment305"/>
  <hasUnitAssessment rdf:resource="#assessment313"/>
