  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEUR3310</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroscience</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with advanced knowledge of the physiology, pharmacology and function of the nervous system. Students will learn the cellular physiology of neural circuits in detail, contemporary techniques used to study the nervous system, select neurological disorders and their pharmacological and non-pharmacological treatments. In addition, students will learn how to conduct and analyse neuroscience experiments using modern techniques.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of Unit(s) PHYL2002 Cellular Physiology or PHAR2220 Human Pharmacology or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2948">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the cellular, molecular and/or genetic principles relevant to nervous system function.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2949">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain selected research techniques used to study the nervous system.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2950">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the physiological and behavioural mechanisms of selected neurological disorders, as well as the experimental models used to study them, and their pharmacological and non-pharmacological treatments.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2951">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse,visualise, and interpret neuroscience behavioural data.</hasOutcomeDescription>
</owl:NamedIndividual>

