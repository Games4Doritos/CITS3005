<owl:NamedIndividual rdf:about="#MECH4502">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EMECH"/>
  <hasUnitOutcomes rdf:resource="#analyse selected machine components and assemblies for static strength, fatigue failure and failure due to elastic instability."/>
  <hasUnitOutcomes rdf:resource="#apply the rudimentary design process for selected machine components and assemblies."/>
  <hasUnitOutcomes rdf:resource="#make design decisions supported by logical reasoning, knowledge and creativity when provided with uncertain, ambiguous, imprecise and/or redundant information."/>
  <hasUnitOutcomes rdf:resource="#incorporate fatigue in analysis and design and quantify the non-static failure mechanism of fatigue."/>
  <hasUnitOutcomes rdf:resource="#describe common mechanical components using the principles of solid mechanics and mathematical models."/>
  <hasUnitOutcomes rdf:resource="#source reliable and accurate information relevant to design of mechanical components."/>
  <hasUnitOutcomes rdf:resource="#work effectively in a team to achieve professional outcomes."/>
