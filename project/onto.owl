  <hasUnitOutcome rdf:resource="#outcome1245"/>
  <hasUnitOutcome rdf:resource="#outcome1246"/>
  <hasUnitOutcome rdf:resource="#outcome1247"/>
  <hasUnitOutcome rdf:resource="#outcome932"/>
  <hasUnitAssessment rdf:resource="#assessment72"/>
  <hasUnitAssessment rdf:resource="#assessment184"/>
  <hasUnitAssessment rdf:resource="#assessment3"/>
