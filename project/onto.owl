  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe  antigen recognition in innate and adaptive immunity.</hasOutcomeDescription>
</owl:NamedIndividual>

