  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise, analyse, and utilise key interactive- and trans-media elements.</hasOutcomeDescription>
</owl:NamedIndividual>

