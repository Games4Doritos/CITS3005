  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased awareness of intercultural understanding and language learning, as well as research skills and communication strategies.</hasOutcomeDescription>
</owl:NamedIndividual>

