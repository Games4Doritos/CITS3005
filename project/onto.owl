  <hasUnitOutcomes rdf:resource="#create computer algorithms for novel problems."/>
  <hasUnitOutcomes rdf:resource="#analyse the correctness and complexity of algorithms."/>
  <hasUnitOutcomes rdf:resource="#implement algorithms in code and test them for correctness and efficiency."/>
  <hasUnitOutcomes rdf:resource="#evaluate and apply common algorithmic problem-solving techniques."/>
  <hasUnitOutcomes rdf:resource="#evaluate and apply well-known algorithms."/>
  <hasUnitAssessments rdf:resource="#mid-semester test"/>
  <hasUnitAssessments rdf:resource="#labs and project"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement667"/>
  <hasContactRequirement rdf:resource="#contactrequirement668"/>
  <hasPrerequisiteUnits rdf:resource="#CITS2200"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CITS3001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Algorithms</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit reinforces key concepts from CITS2200 Data Structures and Algorithms then builds and expands on them. The design and analysis of algorithms is covered. Students learn algorithmic problem-solving techniques through exposure to well-known algorithms. Topics including sorting algorithms, graph algorithms, dynamic programming, string algorithms, greedy algorithms, NP vs P, and problem-motivated design and analysis of novel algorithms.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of CITS2200 Data Structures and Algorithms</hasPrerequisiteText>
</owl:NamedIndividual>

