  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">record, edit and manipulate sound samples to professional quality for use in electronic music and other sound design contexts.</hasOutcomeDescription>
</owl:NamedIndividual>

