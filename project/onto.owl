<owl:NamedIndividual rdf:about="#ELEC4408">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EELEC"/>
  <hasUnitOutcomes rdf:resource="#determine the validity of the assumptions necessary for the application of circuit theory to the analysis of electrical networks in specific instances."/>
  <hasUnitOutcomes rdf:resource="#apply circuit theory to develop the two-port voltage-current characteristics of uniform distributed systems with small ports."/>
  <hasUnitOutcomes rdf:resource="#analyse distributed multiport networks in the time and frequency domains."/>
  <hasUnitOutcomes rdf:resource="#deduce the s-parameters for small port circuit elements."/>
  <hasUnitOutcomes rdf:resource="#design high frequency transistor amplifiers."/>
  <hasUnitOutcomes rdf:resource="#estimate the power efficiency of high frequency transistor amplifiers."/>
  <hasUnitAssessments rdf:resource="#laboratory practice and reports"/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasUnitAssessments rdf:resource="#quizzes, mid-semester exam, and final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement1119"/>
  <hasContactRequirement rdf:resource="#contactrequirement1120"/>
  <hasPrerequisiteUnits rdf:resource="#ELEC3021"/>
  <hasPrerequisiteUnits rdf:resource="#MATH3023"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELEC4408</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High Frequency Circuits and Systems</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is concerned with the application of circuit theory to the analysis and modelling of electronic circuits and systems, with emphasis on high frequency and distributed circuit elements. The topics covered are distributed circuit elements such as transmission lines, s-parameter characterization of circuit elements, high frequency transistor amplifier design, efficiency and classification.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of ELEC3021 Circuits and Electronics and MATH3023 Advanced Mathematics Applications</hasPrerequisiteText>
</owl:NamedIndividual>

