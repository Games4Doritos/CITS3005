  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding and appreciation of Indigenous perspectives and methods across different forms of cultural production.</hasOutcomeDescription>
</owl:NamedIndividual>

