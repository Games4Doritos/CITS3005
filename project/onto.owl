  <hasUnitAssessment rdf:resource="#assessment422"/>
  <hasContactRequirement rdf:resource="#contactrequirement36"/>
  <hasContactRequirement rdf:resource="#contactrequirement11"/>
  <hasContactRequirement rdf:resource="#contactrequirement45"/>
  <hasOutcome rdf:resource="#outcome2428"/>
  <hasOutcome rdf:resource="#outcome2430"/>
  <hasOutcome rdf:resource="#outcome2429"/>
  <hasOutcome rdf:resource="#outcome2427"/>
  <hasOutcome rdf:resource="#outcome2431"/>
  <hasOutcome rdf:resource="#outcome2426"/>
  <isInMajor rdf:resource="#MJD-ANHBY"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANHB3310</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Biology: Applications and Investigations I</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In this unit students establish necessary skills for the investigative process including rigorous definition of problems and questions; careful and appropriate design of experiments and selection of method; creative thinking; careful acquisition of data (from literature, field or laboratory work); rigorous but imaginative validation, manipulation and interpretation of data; and presentation of investigations both as written and verbal reports. Using these techniques, students carry out their own group projects to independently investigate the organisation of a specific issue arising from their studies in other Level 3 units in Anatomy and Human Biology. The flexible structure of the unit allows for reading, tutorials and practical project work in areas of particular interest to individuals or small groups of students. Some flexibility of scheduling is also possible, with the consultation and consent of the unit coordinator.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-ANHBY Anatomy and Human Biology or MJD-HSNEM Human Science and Neuroscience</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2426">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the scientific method, including the history and philosophy of science, and its application to scientific investigation.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2427">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the ethical principles governing scientific research involving humans and animals, including ethics approval requirements and responsible research conduct.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2428">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">design scientific investigations by developing research questions, selecting appropriate methodologies, applying experimental controls, and recognising the strengths and limitations of different research approaches.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2429">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collect, analyse and interpret scientific data from a range of sources, including literature, laboratory, field and survey investigations, using appropriate analytical techniques.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2430">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate scientific information effectively through written reports, oral presentations, and the preparation of scientific and professional documents.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2431">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply critical thinking and professional scientific skills by working collaboratively, evaluating scientific evidence, responding constructively to feedback, and demonstrating a commitment to ethical practice and lifelong learning.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment420">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group project work</hasAssessmentDescription>
</owl:NamedIndividual>

