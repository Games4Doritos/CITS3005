<owl:NamedIndividual rdf:about="#ENGL1501">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-EGCST"/>
  <isInMajors rdf:resource="#major10"/>
  <hasUnitOutcomes rdf:resource="#critique major creative works."/>
  <hasUnitOutcomes rdf:resource="#craft a completed literary work."/>
  <hasUnitOutcomes rdf:resource="#produce creative, original forms of thought and expression."/>
  <hasUnitOutcomes rdf:resource="#express ideas concisely and clearly in both oral and written formats."/>
  <hasUnitOutcomes rdf:resource="#apply a range of reading strategies important in theory and culture."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of major literary techniques and their effects."/>
  <hasUnitAssessments rdf:resource="#tutorial participation"/>
  <hasUnitAssessments rdf:resource="#analysis and project planning"/>
  <hasUnitAssessments rdf:resource="#creative project"/>
  <hasContactRequirement rdf:resource="#contactrequirement130"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENGL1501</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reading Creatively/Writing Creatively</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit engages with the joy and power of the written word. Investigating several aspects of writing  practice, it aims to develop craft and narrative technique. Students work throughout the semester to plan and then write one or more pieces of creative work (fiction, creative non-fiction, poetry or script). The use of a range of creative techniques and strategies is explored through the discussion in lectures and tutorials of a selection of creative texts, as well as in reference to the students' own writing through a series of creative exercises across the unit. Students are encouraged to read widely as a further important tool to develop their creative writing skills. Please note that this unit does not deal with journalism or standard non-fiction.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

