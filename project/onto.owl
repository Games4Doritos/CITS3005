<owl:NamedIndividual rdf:about="#CLAN1201">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-CLANH"/>
  <hasUnitOutcomes rdf:resource="#recognise and describe the forms and functions of a basic variety of Greek nouns, adjectives, pronouns and verbs."/>
  <hasUnitOutcomes rdf:resource="#demonstrate understanding of elementary Greek sentence structure."/>
  <hasUnitOutcomes rdf:resource="#translate from Greek, without the aid of dictionaries, simple passages composed of a set vocabulary."/>
  <hasUnitOutcomes rdf:resource="#compose simple Greek sentences from a set vocabulary."/>
  <hasUnitOutcomes rdf:resource="#use correct grammatical terminology in the analysis of Greek words and sentences."/>
  <hasUnitAssessments rdf:resource="#class test"/>
  <hasUnitAssessments rdf:resource="#tutorial performance"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement77"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN1201</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Greek 1: An Introduction to Ancient Greek</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is an introduction to Ancient Greek for students who have never before studied this language or who have had minimal instruction in it, so there are no prerequisites. It introduces students to the changing forms of Greek words (their 'inflected morphology') and in so doing provides a grounding in basic grammar which is of fundamental benefit to English expression (as well as being of great utility for the acquisition of other modern European languages). Students will be taught via a combination of translation and grammar exercises. This unit is an ideal introduction to one of the most important ancient written languages, and is the gateway unit for the study of Greek literature, as well as for those students interested in Greek and Roman History, or historical linguistics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#recognise and describe the forms and functions of a basic variety of Greek nouns, adjectives, pronouns and verbs.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and describe the forms and functions of a basic variety of Greek nouns, adjectives, pronouns and verbs.</hasOutcomeDescription>
</owl:NamedIndividual>

