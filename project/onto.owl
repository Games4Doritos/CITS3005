<owl:NamedIndividual rdf:about="#CHPR2007">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ECHEM"/>
  <hasUnitOutcomes rdf:resource="#1)	demonstrate writing that is clear, well-structured and appropriate to audience and purpose."/>
  <hasUnitOutcomes rdf:resource="#analyse steady state thermal conduction and convection problems."/>
  <hasUnitOutcomes rdf:resource="#estimate the convective heat and/or mass transfer coefficients for flows over an external surface and flows within conduits."/>
  <hasUnitOutcomes rdf:resource="#analyse radiative heat transfer problems."/>
  <hasUnitOutcomes rdf:resource="#appreciate the similarity between conduction heat transfer and diffusive mass transfer under many situations and analyse diffusive mass transfer problems."/>
  <hasUnitOutcomes rdf:resource="#think logically, understand the consequences of assumptions made during analyses and synthesise solutions to new problems."/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#individual formal laboratory report"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasPrerequisiteDegrees rdf:resource="#62520"/>
  <hasContactRequirement rdf:resource="#contactrequirement1035"/>
  <hasContactRequirement rdf:resource="#contactrequirement1036"/>
  <hasContactRequirement rdf:resource="#contactrequirement1037"/>
  <hasPrerequisiteUnits rdf:resource="#CHPR1005"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR2007</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heat and Mass Transfer</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces the fundamental elements of heat and mass transfer. Students investigate heat transfer by conduction, convection and radiation. The analogy between heat and mass transfer is covered and applied in the analysis of convective and diffusive mass transfers.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of ( CHPR1005 Mass and Energy Balances and ( MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus ) ) or  Enrolment in 62520 Master of Low Emission Energy Technologies</hasPrerequisiteText>
</owl:NamedIndividual>

