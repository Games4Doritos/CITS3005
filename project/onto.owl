</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome143">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate foundational knowledge of key issues relating to music that include music psychology, musical memory,  practice strategies, composition techniques.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome144">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an intermediate level of musicianship in  presentation of works within solo, small and/or large ensemble settings.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome145">
