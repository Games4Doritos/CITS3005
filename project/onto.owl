</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#describe why and how ethics and corporate social responsibility vary when managing organisations internationally.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe why and how ethics and corporate social responsibility vary when managing organisations internationally.</hasOutcomeDescription>
</owl:NamedIndividual>

