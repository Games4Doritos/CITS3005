<owl:NamedIndividual rdf:about="#ARTF3020">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FNART"/>
  <hasUnitOutcomes rdf:resource="#locate your creative work within critical/theoretical, historical and contemporary contexts relevant to film."/>
  <hasUnitOutcomes rdf:resource="#self-generate modes of creative inquiry using various approaches to support an individualised creative art practice."/>
  <hasUnitOutcomes rdf:resource="#produce a coherently evolving body of creative work that advances a personal vocabulary and vision."/>
  <hasUnitOutcomes rdf:resource="#demonstrate advanced technical mastery to articulate your creative work in film."/>
  <hasUnitOutcomes rdf:resource="#critically evaluate your practice within the relevant contemporary cultural, historical, social and professional contexts through the use of a range of presentation skills."/>
  <hasUnitOutcomes rdf:resource="#synthesise critical and analytical thinking effectively in written, oral and creative modes."/>
  <hasUnitAssessments rdf:resource="#creative work"/>
  <hasUnitAssessments rdf:resource="#written work"/>
  <hasUnitAssessments rdf:resource="#oral presentation"/>
  <hasContactRequirement rdf:resource="#contactrequirement174"/>
  <hasPrerequisiteUnits rdf:resource="#ARTF2021"/>
  <hasPrerequisiteUnits rdf:resource="#ARTF2020"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF3020</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Studio: Digital Arts and Filmmaking</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Design School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit extends the skills and knowledge acquired in Level 2 and focuses on new digital and immersive forms of cinematic experiences. It studies contemporary emerging media that include and are not limited to generative AI, interactive cinema, virtual and augmented reality (VR&amp;AR), transmedia storytelling, projection mapping, interactive audio; experimental gaming, animation, narrative and documentary film. By engaging in experiential and problem based learning, students will be developing and researching artistic approaches, methodologies and aesthetics that led to the advancements in the world of digital filmmaking. This final year unit enables students to become more independent in their own artistic research, concept development and production.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARTF2021 Animation and Video or ARTF2020 Moving Images</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#locate your creative work within critical/theoretical, historical and contemporary contexts relevant to film.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locate your creative work within critical/theoretical, historical and contemporary contexts relevant to film.</hasOutcomeDescription>
</owl:NamedIndividual>

