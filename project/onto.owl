<owl:NamedIndividual rdf:about="#COMM2001">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-CMMST"/>
  <isInMajors rdf:resource="#major10"/>
  <hasUnitOutcomes rdf:resource="#research and analyse media content through collection, analysis and interpretation of data."/>
  <hasUnitOutcomes rdf:resource="#explain how technology and the desire to create influential messages has effected the production and construction of media texts."/>
  <hasUnitOutcomes rdf:resource="#express research findings and ideas coherently and logically in oral and written formats."/>
  <hasUnitOutcomes rdf:resource="#demonstrate cooperation and leadership in peer learning group contexts and participation in discussion settings."/>
  <hasUnitAssessments rdf:resource="#presentations"/>
  <hasUnitAssessments rdf:resource="#written assessment"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement98"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMM2001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Media Influence</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From brand ambassadors to 'fake news', the media can have a powerful influence on our views and behaviour. In this unit we examine the impact of technological change upon information sharing and the broader discourses of news and advertising. By analysing aspects of media reach, engagement and effects students are able to improve their own capacity to craft influential media messages and act as critical and empowered participants in the world of mass communication.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of 24 points of level 1 units from any discipline</hasPrerequisiteText>
</owl:NamedIndividual>

