  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an advanced level of practical skill in performing, composing, and/or recording contemporary popular music.</hasOutcomeDescription>
</owl:NamedIndividual>

