  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA3307</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trading in Securities Markets</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the theory and practice of securities trading at exchanges and in dealer markets. In contrast to traditional models of finance that assume perfect markets, the unit examines how trading and the design of markets affect volatility, liquidity, trading costs, price efficiency and trading outcomes.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any level 2 Finance unit</hasPrerequisiteText>
</owl:NamedIndividual>

