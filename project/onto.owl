<owl:NamedIndividual rdf:about="#MJD-MEMSD">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#demonstrate an established compositional technique with respect to rhythm, harmony and form, identify relevant historical and stylistic conventions."/>
  <hasMajorOutcomes rdf:resource="#articulate broad historical perspectives on the nature and contexts of electronic music and sound art,."/>
  <hasMajorOutcomes rdf:resource="#critically engage with key works from the early twentieth century to the present day."/>
  <hasMajorOutcomes rdf:resource="#demonstrate understanding of the physical properties of sound."/>
  <hasMajorOutcomes rdf:resource="#demonstrate an experimental and creative orientation in the production and presentation of original electronic music and sound artworks."/>
  <hasMajorOutcomes rdf:resource="#develop specialised sound design techniques applicable in key industries of film/tv, documentary, commercials and video gaming."/>
  <hasMajorOutcomes rdf:resource="#develop specialised computer programming techniques for the development of custom interactive software and hardware instruments."/>
  <hasMajorOutcomes rdf:resource="#develop transferable skills in creative and critical thinking, research, project planning and presentation."/>
  <isAvailableInDegree rdf:resource="#BP001"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasCoreUnits rdf:resource="#MUSC1054"/>
  <hasCoreUnits rdf:resource="#MUSC1055"/>
  <hasCoreUnits rdf:resource="#MUSC1350"/>
  <hasCoreUnits rdf:resource="#MUSC2273"/>
  <hasCoreUnits rdf:resource="#MUSC2274"/>
  <hasCoreUnits rdf:resource="#MUSC2276"/>
  <hasCoreUnits rdf:resource="#MUSC2277"/>
  <hasCoreUnits rdf:resource="#MUSC3571"/>
  <hasCoreUnits rdf:resource="#MUSC3572"/>
  <hasMajorCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-MEMSD</hasMajorCode>
  <hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music: Electronic Music and Sound Design</hasMajorTitle>
  <hasMajorSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasMajorSchool>
  <hasMajorDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Music and Sound Design is a creative-focused major. Students develop expertise in electronic music composition, sound design and production, programming, and software/hardware instrument design—skills applicable to a range of creative and technical professions. Studio and lab-based units permit students to think creatively, to invent and to innovate, exploring and developing ideas toward the formation of new electronic music and sound art works. The Electronic Music and Sound Design major culminates in a major project of the student's choosing, such as an album of electronic works, a sound installation, a film score, or live performance.</hasMajorDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate an established compositional technique with respect to rhythm, harmony and form, identify relevant historical and stylistic conventions.">
