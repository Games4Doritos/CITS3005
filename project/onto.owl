  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate and apply a wide-range of primary analytical concepts and terms that relate to cinema.</hasOutcomeDescription>
</owl:NamedIndividual>

