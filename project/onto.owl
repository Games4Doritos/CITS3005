  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the structure and function of the immune system.</hasOutcomeDescription>
</owl:NamedIndividual>

