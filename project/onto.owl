  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse compositional aspects of musical theatre.</hasOutcomeDescription>
</owl:NamedIndividual>

