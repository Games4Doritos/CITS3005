  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise ethical issues in various fields of study and professions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3566">
