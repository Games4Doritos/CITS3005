  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply an understanding of the fundamental principles of nutrition and their roles in supporting health, physical activity, and human performance.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2776">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply evidence-based strategies to optimise nutrition for individuals engaged in sport, exercise, and health-related activities.</hasOutcomeDescription>
</owl:NamedIndividual>

