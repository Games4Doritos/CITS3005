  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deliver oral presentations that are clear and coherent.</hasOutcomeDescription>
</owl:NamedIndividual>

