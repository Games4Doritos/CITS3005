  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce an accurate English translation of the set Greek texts with the aid of reference materials.</hasOutcomeDescription>
</owl:NamedIndividual>

