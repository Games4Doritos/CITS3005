  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of key creative and organisational principles of media production.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome855">
  <rdf:type rdf:resource="#Outcome"/>
