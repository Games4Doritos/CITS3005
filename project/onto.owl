  <hasUnitLocations rdf:resource="#China"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN2801</hasUnitCode>
