  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse recent examples of emerging crime challenges.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome923">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the nature and impact of technology on crime.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome924">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically assess legal and policy prevention responses to new crime challenges.</hasOutcomeDescription>
</owl:NamedIndividual>

