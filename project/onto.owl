  <isInMajors rdf:resource="#MJD-AGBUS"/>
  <hasUnitOutcomes rdf:resource="#identify core theoretical economic perspectives and how these influence business decisions and strategies."/>
  <hasUnitOutcomes rdf:resource="#explain the principles of prices and markets from an economic perspective."/>
  <hasUnitOutcomes rdf:resource="#apply basic analytical skills at a practical level with applications to market and firm case studies."/>
  <hasUnitOutcomes rdf:resource="#identify the key determinants of wage-setting in labour markets."/>
  <hasUnitOutcomes rdf:resource="#analyse both microeconomic and macroeconomic policy."/>
  <hasUnitAssessments rdf:resource="#project"/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement548"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON1000</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Economics for Business</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit addresses core microeconomic and macroeconomic principles that underlie strategic business decision making and national/international policy formulations. Students discuss how individual firms and households make economic decisions and interact in markets; develop a solid understanding of the functioning of modern macroeconomic and financial markets; and acquire a deep insight of major historical and contemporary economic issues.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

