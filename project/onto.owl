  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of KORE1401 Korean 1 or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1718">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate at upper beginner level in written and oral Korean on everyday topics.</hasOutcomeDescription>
</owl:NamedIndividual>

