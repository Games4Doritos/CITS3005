  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT3346</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Managing Organisational Change</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to theories of organisational change and methodologies for managing organisational change in Australia. The theories include organisational development (OD); OD consulting; organisational transformation (OT); the impact of the environment on the organisation; and new wave contemporary theories. Methodologies include managing responses to change; creating readiness for change; and adaptive organisational strategies and capabilities. The theories and methodologies are reinforced through analysis of case studies designed to strengthen students' analytical and problem-solving skills.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any two Level 2 units in the Management major</hasPrerequisiteText>
</owl:NamedIndividual>

