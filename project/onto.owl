  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the objectives of financial management in a corporation.</hasOutcomeDescription>
</owl:NamedIndividual>

