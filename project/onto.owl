<owl:NamedIndividual rdf:about="#SCIE3314">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-AGSCI"/>
  <isInMajors rdf:resource="#MJD-AGTDM"/>
  <isInMajors rdf:resource="#MJD-AGTEC"/>
  <isInMajors rdf:resource="#major7"/>
  <hasUnitOutcomes rdf:resource="#explain the role of Australian and Western Australian grain production within global food supply systems, and identify the environmental, economic, and social factors that shape the structure and management of broadacre cropping enterprises."/>
  <hasUnitOutcomes rdf:resource="#analyse how Mediterranean-type climate patterns, soil constraints, and seasonal water balance dynamics in WA interact to determine crop management timing, variety selection, and production risk."/>
  <hasUnitOutcomes rdf:resource="#apply principles of conservation agriculture, soil fertility management, cereal phenology, and break-crop agronomy to develop management recommendations appropriate to the conditions and constraints of WA broadacre farming systems."/>
  <hasUnitOutcomes rdf:resource="#assess the biological and economic impact of weeds, fungal diseases, insect pests, and soil-borne pathogens on grain production in WA, and formulate integrated management strategies that account for resistance mechanisms, economic thresholds, and environmental conditions."/>
  <hasUnitOutcomes rdf:resource="#demonstrate competence in using a process-based crop simulation model to predict crop growth, water use, and nitrogen response under varying management and climate scenarios, and critically evaluate model outputs to inform agronomic decision-making."/>
  <hasUnitOutcomes rdf:resource="#synthesise agronomic, environmental, financial, and crop protection knowledge to construct a professional agronomic management package for a major WA grain crop, including a gross margin analysis and a quantitative nitrogen management strategy."/>
  <hasUnitAssessments rdf:resource="#agronomy report - Farm Interview and Agronomic Package report"/>
  <hasUnitAssessments rdf:resource="#glasshouse trial - Cereal Derby"/>
  <hasUnitAssessments rdf:resource="#computer practicals and online learning"/>
  <hasContactRequirement rdf:resource="#contactrequirement573"/>
  <hasPrerequisiteUnits rdf:resource="#AGRI1001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIE3314</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crops and Cropping Systems</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agriculture and Environment</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on how agricultural systems in Western Australia are rapidly changing in response to the need for more environmentally responsible production methods and a changing climate.  The unit introduces the main temperate crop species and then uses a systems approach to provide an understanding of the relationships between crops, pastures, livestock, weeds, plant diseases and the environment. There is in-depth consideration of crop agronomy, conservation cropping, no-tillage and weed and disease control. Modelling as a tool to improve our understanding of complex agricultural systems is discussed and models evaluated.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) AGRI1001 Feeding the World</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#explain the role of Australian and Western Australian grain production within global food supply systems, and identify the environmental, economic, and social factors that shape the structure and management of broadacre cropping enterprises.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the role of Australian and Western Australian grain production within global food supply systems, and identify the environmental, economic, and social factors that shape the structure and management of broadacre cropping enterprises.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#analyse how Mediterranean-type climate patterns, soil constraints, and seasonal water balance dynamics in WA interact to determine crop management timing, variety selection, and production risk.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse how Mediterranean-type climate patterns, soil constraints, and seasonal water balance dynamics in WA interact to determine crop management timing, variety selection, and production risk.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply principles of conservation agriculture, soil fertility management, cereal phenology, and break-crop agronomy to develop management recommendations appropriate to the conditions and constraints of WA broadacre farming systems.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply principles of conservation agriculture, soil fertility management, cereal phenology, and break-crop agronomy to develop management recommendations appropriate to the conditions and constraints of WA broadacre farming systems.</hasOutcomeDescription>
</owl:NamedIndividual>

