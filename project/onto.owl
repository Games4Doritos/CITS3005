<owl:NamedIndividual rdf:about="#MJD-EXHSC">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#apply physiological, anatomical and behavioural concepts to assess and improve health and exercise performance."/>
  <hasMajorOutcomes rdf:resource="#utilise evidence-based exercise science principles to design effective training programs to enhance physical fitness and health."/>
