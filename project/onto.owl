<owl:NamedIndividual rdf:about="#MJD-CMMST">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#analyse the history, context and practices of media and communication."/>
  <hasMajorOutcomes rdf:resource="#apply creative, critical and reflective thinking."/>
  <hasMajorOutcomes rdf:resource="#effectively read, speak and write about complex ideas."/>
  <hasMajorOutcomes rdf:resource="#create a variety of media content."/>
  <hasMajorOutcomes rdf:resource="#work with others, organise complex tasks and manage workloads."/>
  <hasMajorOutcomes rdf:resource="#evaluate the social, cultural and legal implications of their actions."/>
  <hasMajorOutcomes rdf:resource="#apply reflective practice and engage in continuous learning."/>
  <isAvailableInDegree rdf:resource="#BP001"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasCoreUnits rdf:resource="#COMM1001"/>
  <hasCoreUnits rdf:resource="#COMM1002"/>
