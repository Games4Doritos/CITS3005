  <hasLocation rdf:resource="#Albany"/>
  <hasPrerequisiteUnit rdf:resource="#EART1105"/>
  <hasPrerequisiteUnit rdf:resource="#BIOL1131"/>
  <hasPrerequisite rdf:resource="#CHEM1003"/>
  <hasPrerequisite rdf:resource="#EART1105"/>
  <hasPrerequisite rdf:resource="#SCIE2204"/>
  <hasPrerequisite rdf:resource="#BIOL1131"/>
  <hasPrerequisite rdf:resource="#CHEX1003"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIOL2204</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Biology</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the diversity of algae, seagrasses and animals that inhabit our oceans. Students attain a broad general knowledge of the biology and life histories of marine species plus specific knowledge of certain focus groups. They learn identification skills that will enable them to identify common species in the field and work with collections in the laboratory. There is an emphasis on local species. Contact hours (nominally called workshops) consist of tutorial-style discussions, occasional guest lectures, practical exercises, field excursions and computer laboratories. Background information is provided online. Attendance at workshops is compulsory.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of SCIE2204 Marine Systems and ATAR Subject(s) Chemistry or  Successful completion of CHEM1003 Introductory Chemistry or equivalent or CHEX1003 Introductory Chemistry</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2887">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a knowledge of the diversity of marine organisms.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2888">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify common species by sight and less common species using keys and/or pictorial guides.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2889">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the biological requirements of marine species and the way these are met in the marine environment.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2890">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a knowledge of the form and function of marine organisms, and the consequences of uniquely marine lifestyles.</hasOutcomeDescription>
</owl:NamedIndividual>

