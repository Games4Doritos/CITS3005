  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART2201</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Art and Urban Experience</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the theoretical and visual understanding of urban experience in France during the second half of the nineteenth century. Building on Baudelaire's definition of modernity as the transient experience of urban living, the unit explores how the city shaped the European visual imagination after 1850. Conceived as a simulated stroll through late nineteenth-century Paris, the unit explores how civic planning, industry, material consumption, and politics redefined spatial and visual form.  Though the unit is grounded in the art of painting, it also explores how new visual developments, particularly photography, challenged and shaped the definition of modern France. As part of this visual exploration of the city, the unit also considers how theories of Cosmopolitanism, gender equality, and class struggle informed the nineteenth-century notion of urban life.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART1000 Great Moments in Art (formerly VISA1000) or HART1003 Ways of Seeing: Themes and Theories in Art</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1421">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify key artists and artworks associated with nineteenth-century modernity in France.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1422">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate how the changing experience of the nineteenth-century city—its streets, sights and scenes—shaped the understanding and definition of urban experience.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1423">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply this notion of urban experience to the interpretation of painting and other visual forms.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1424">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">incorporate multicultural, class and gender theories into an historical understanding of the late nineteenth century.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1425">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">make arguments about late nineteenth-century visual culture and painting.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1426">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate knowledge about relevant artworks and their relationship to theories of urban experience.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HART2207">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
