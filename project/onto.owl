  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Students are encouraged to explore the story and science behind the health benefits of engaging in physical activity. Through applied laboratory sessions, supported by lectures, questions are answered and raised about the benefits of physical activity across the lifespan.</hasUnitDescription>
