  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit continues to develop the four basic language skills (listening, speaking, reading and writing). The unit also consolidates students' current Chinese language foundation. Students are able to discuss and express their opinions on a number of social issues, negotiate a range of Chinese texts (news items, short essays, television programs, etc.) with the aid of a dictionary, and write short essays on a variety of topics with some depth.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN1403 Chinese 3 or CHIN1103 Chinese Intermediate I</hasPrerequisiteText>
</owl:NamedIndividual>

