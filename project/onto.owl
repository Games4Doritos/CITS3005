  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss advanced knowledge of relevant techniques, concepts and contemporary contexts effectively in written and oral forms.</hasOutcomeDescription>
</owl:NamedIndividual>

