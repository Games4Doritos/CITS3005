  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLAN2202</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Greek 2</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit takes up the study of the language from CLAN2201 Greek 1, which is a prerequisite for it. Students continue to read Greek texts and through graded exercises extend their knowledge of Ancient Greek vocabulary and grammar. In particular, the unit concentrates on the syntax, or sentence construction, of the language, since much of the morphology, the changing forms of individual words, has been covered in CLAN2201 Greek 1.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of CLAN2201 Greek 1 or CLAN1201 Introduction to Greek 1</hasPrerequisiteText>
</owl:NamedIndividual>

