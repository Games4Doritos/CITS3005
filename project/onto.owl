  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate knowledge of the history of feminist thought including its key contexts and shifts, major theorists and significant faultlines.</hasOutcomeDescription>
</owl:NamedIndividual>

