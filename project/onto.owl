  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3406</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Studies 6</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This language unit is designed for students who have completed FREN3405 French Studies 5. Students further develop proficiency in spoken and written French and deepen their understanding of French and francophone society and culture. The unit will help students towards attaining a level between B1 and B2 of the Common European Framework of Reference for Languages (CEFR). The unit completes the language sequence for students who started French as beginners (MJD-FRNHB). It contributes to achieving the French major's general outcomes of developing a high level of competency in the four language learning skills of reading, writing, listening and speaking and gaining an increased understanding of the cultural contributions of France and other French-speaking societies.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3405 French Studies 5 or FREN3305 French Advanced I</hasPrerequisiteText>
</owl:NamedIndividual>

