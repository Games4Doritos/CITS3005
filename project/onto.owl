  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MINE3406</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geotechnology of Mine Waste</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers the principles of designing, constructing and operating mine waste storage facilities; implementing best practice to ensure emissions are prevented; ensuring environmental compliance; case studies of failures of storage facilities; emerging technologies for reducing water and energy use; preparing a mine closure plan; and ensuring long-term geotechnical and environmental stability.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of GENG2009 Principles of Geomechanics and MINE2001 Fundamentals of Mining Engineering</hasPrerequisiteText>
</owl:NamedIndividual>

