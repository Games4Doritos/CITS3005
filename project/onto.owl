  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Topics covered include the Australian legal system; statutory interpretation; the law of torts and professional liability; the law of contracts (elements of a valid contract, vitiating factors, construction of contracts, breach of contract and remedies); and consumer protection law and product liability.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

