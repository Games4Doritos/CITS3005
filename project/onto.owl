<owl:NamedIndividual rdf:about="#outcome721">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse by learning to express their ideas and performing assigned tasks in the Chinese language.</hasOutcomeDescription>
</owl:NamedIndividual>

