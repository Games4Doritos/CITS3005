  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source reliable information and technologies on mining dewatering, surveying and electrification.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4364">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply dewatering principles to practical surface and underground operating mine scenarios.</hasOutcomeDescription>
</owl:NamedIndividual>

