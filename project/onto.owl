  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply services and architectures offered by virtualisation and cloud platforms to business and research problems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3608">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">write code to utilise application programming interfaces to interact with the cloud platform.</hasOutcomeDescription>
</owl:NamedIndividual>

