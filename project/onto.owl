  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converse in Korean on everyday topics and express own views with an intermediate understanding of Korean grammar and phonology.</hasOutcomeDescription>
</owl:NamedIndividual>

