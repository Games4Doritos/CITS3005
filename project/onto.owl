  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically reflect on the brand and the various functions of brand management.</hasOutcomeDescription>
</owl:NamedIndividual>

