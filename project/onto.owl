  <hasPrerequisiteUnits rdf:resource="#PHYL2002"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEUR3302</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Neuroscience 2</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with hands-on experience of laboratory techniques in modern neuroscience and critical reading of the latest neuroscience research literature. It forms part of a neuroscience major leading to honours and research careers.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
