  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit gives students a basic understanding of how the Australian taxation laws apply to a wide variety of business and financial transactions.</hasUnitDescription>
