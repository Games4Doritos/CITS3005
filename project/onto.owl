  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the risks involved, and precautions taken, when handling endangered species.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#critically analyse field-collected data on an endangered species, compare the data with the available literature, and present the data in a scientific report.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse field-collected data on an endangered species, compare the data with the available literature, and present the data in a scientific report.</hasOutcomeDescription>
</owl:NamedIndividual>

