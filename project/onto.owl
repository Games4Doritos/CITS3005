  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be aware of Indigenous protocols to do with the environment.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#find ways of forming a relationship with the environment through language, description and visual imagery and be able to explain this relationship in writing.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">find ways of forming a relationship with the environment through language, description and visual imagery and be able to explain this relationship in writing.</hasOutcomeDescription>
</owl:NamedIndividual>

