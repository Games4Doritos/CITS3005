  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse business requirements to design a database.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2558">
