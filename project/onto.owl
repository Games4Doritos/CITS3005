<owl:NamedIndividual rdf:about="#EMPL1206">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-WKERL"/>
  <hasUnitOutcomes rdf:resource="#describe how the purpose of work has changed throughout human history."/>
  <hasUnitOutcomes rdf:resource="#explain how different understandings of the purpose of work throughout human history are reflected in contemporary work practices and norms."/>
  <hasUnitOutcomes rdf:resource="#identify all facets of job quality and explain how these shape individual and collective meanings of work."/>
  <hasUnitOutcomes rdf:resource="#demonstrate oral communication skills through the presentation of ideas to the class."/>
  <hasUnitOutcomes rdf:resource="#evidence research design skills aimed at collecting, analysing, interpreting and reporting data."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of the changing nature of work and the historical, social, institutional and technological forces that shape contemporary work."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#written assessment"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement541"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMPL1206</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Psychology of Work</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Work is an experience that dominates human existence. This unit uncovers the nature of this experience by drawing on the insights of sociology and social psychology.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

