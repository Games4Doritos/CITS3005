  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCIE2204</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marine Systems</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to the multidisciplinary aspects of marine science. Using the framework of the local Western Australia (WA) marine environment, it outlines how the multidisciplinary aspects of marine science are essential in understanding and managing such an ecosystem. Aspects covered include oceanography, geology and geomorphology and marine biology. Students obtain an introduction to the multidisciplinary aspects of marine science; and develop an understanding of the principles of oceanography, geology and geomorphology and how marine organisms interact with the environment.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of EART1105 Dynamic Planet or BIOL1131 Plant and Animal Biology</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2875">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse the multidisciplinary components of marine systems, integrating concepts from marine biology, oceanography, geology, and geomorphology.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2876">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret physical and biological marine processes, including tides, waves, currents, and ecological interactions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2877">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply quantitative and data handling skills to organise, visualise, and interpret marine scientific data.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2878">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify major marine taxa and evaluate their ecological roles within marine ecosystems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2879">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate scientific interpretations of marine field observations and data in structured written formats.</hasOutcomeDescription>
</owl:NamedIndividual>

