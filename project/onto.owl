</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3299">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate, calculate and apply concepts and theories including that of economic growth, foreign direct investment and regional integration and.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3300">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the factors affecting economic growth in selected Asian economies.</hasOutcomeDescription>
</owl:NamedIndividual>

