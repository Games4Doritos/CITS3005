  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT3304</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied International Business Strategy</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit requires students to develop a case study of a business venture in the Asian region following a four-week coursework component that covers the issue of strategy development especially in the Asian region, as well as operational issues related to business development. Students work in teams on this exercise and are mentored by the unit coordinator. Students are then required to defend their business proposition to a panel of experts including relevant external stakeholders.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT2341 International Management</hasPrerequisiteText>
</owl:NamedIndividual>

