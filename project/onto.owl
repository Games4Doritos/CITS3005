  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of geospatial data collection and analysis techniques that are fundamental to human and physical geography, environmental sciences, agriculture and planning.</hasOutcomeDescription>
