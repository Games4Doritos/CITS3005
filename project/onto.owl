  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering Thermodynamics</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit presents a macroscopic treatment of thermodynamics from an engineering perspective, beginning with definitions of properties, forms of energy and systems.  The behaviour of ideal gases is discussed, along with the use of the compressibility factor.  The 1st law of thermodynamics is applied to both open and closed systems, leading to the steady flow energy equation and the definition of enthalpy.  The behaviour of liquid-vapour systems and use of property tables and charts are discussed.  The 2nd law of thermodynamics, the property entropy, and the Carnot cycle are introduced.  The 1st and 2nd laws of thermodynamics are then applied to typical thermodynamic systems, for example internal combustion engines, using models such as the Otto cycle, Diesel cycle, and Brayton cycle.  Issues surrounding the use of such thermodynamic systems, for example fuel sources, thermal efficiency, pollution and emissions form part of this system analysis.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of CITS1401 Computational Thinking with Python or CITS2401 Computer Analysis and Visualisation and ENSC2004 Engineering Mechanics</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4284">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpret questions, problems and instructions written in the terminology of engineering thermodynamics.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4285">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">define systems, types of energy, states of substances and properties.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4286">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply the ideal gas equations, recognising their limitations.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4287">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">retrieve appropriate data from thermodynamic property tables and charts.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4288">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse simple systems, steady-state processes and cycles using the 1st and 2nd Laws of thermodynamics.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome4289">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the social and environmental impact of typical thermodynamic systems.</hasOutcomeDescription>
</owl:NamedIndividual>

