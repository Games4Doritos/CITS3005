  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">produce practical implementations of machine learning solutions for a real-world dataset.</hasOutcomeDescription>
</owl:NamedIndividual>

