  <hasUnitOutcomes rdf:resource="#evaluate complex positions and arguments in contemporary political theory."/>
  <hasUnitOutcomes rdf:resource="#construct persuasive arguments concerning difficult issues in contemporary political theory."/>
  <hasUnitOutcomes rdf:resource="#demonstrate advanced written communication and research skills."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the importance of normative ideas in public policy, and analyse the influence of normative ideas in debates about public policy."/>
  <hasUnitAssessments rdf:resource="#essay"/>
  <hasUnitAssessments rdf:resource="#in-tutorial assessment"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement482"/>
  <hasContactRequirement rdf:resource="#contactrequirement483"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPHE3327</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contemporary Political Theory</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit considers the contributions of political philosophers and theorists to three centrally important issues: justice, liberty, and democracy. It also considers the application of these contributions to a series of real-world controversies, including the rights of the disabled, redistributive taxation, poverty, efficiency, freedom of speech, gender equality, pornography, and voting.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of any one level 2 Unit(s)</hasPrerequisiteText>
</owl:NamedIndividual>

