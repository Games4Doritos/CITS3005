  <hasUnitOutcomes rdf:resource="#demonstrate intuition and skills in topology and differential geometry and."/>
  <hasUnitOutcomes rdf:resource="#understand how these geometry techniques can be applied to mechanics and physics."/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement874"/>
  <hasContactRequirement rdf:resource="#contactrequirement875"/>
  <hasPrerequisiteUnits rdf:resource="#MATH2031"/>
  <hasPrerequisiteUnits rdf:resource="#MATH2030"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH3032</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Topology and Manifolds</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an introduction to abstract methods in a continuous setting. Topics include topology and geometry from a constructive perspective in dimensions two, three and four. Students investigate, via concrete examples, homeomorphisms and diffeomorphisms of manifolds; curvature; vector bundles; and elements of the machinery for describing space-time in physics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH2031 Introduction to Pure Mathematics or MATH2030 Metric Spaces &amp; Measure Theory</hasPrerequisiteText>
</owl:NamedIndividual>

