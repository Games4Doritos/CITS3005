  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically evaluate the modern scholarship on the Hellenistic period.</hasOutcomeDescription>
</owl:NamedIndividual>

