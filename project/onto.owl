<owl:NamedIndividual rdf:about="#PSYC2217">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-NEURS"/>
  <isInMajor rdf:resource="#major14"/>
  <isInMajor rdf:resource="#MJD-PSYCH"/>
  <isInMajor rdf:resource="#major15"/>
