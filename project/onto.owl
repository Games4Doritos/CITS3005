  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and quantify ecological engineering principles and their application to engineering design.</hasOutcomeDescription>
</owl:NamedIndividual>

