  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use a multiphysics computational modelling software to design and analyse a medical device, such as a neurostimulator.</hasOutcomeDescription>
</owl:NamedIndividual>

