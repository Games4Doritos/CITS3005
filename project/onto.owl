<owl:NamedIndividual rdf:about="#GENG2009">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#write concise technical reports."/>
  <hasUnitOutcomes rdf:resource="#identify the role of geotechnical engineering in the civil and mining engineering design process."/>
  <hasUnitOutcomes rdf:resource="#apply geotechnical design principles in civil and mining engineering design."/>
  <hasUnitOutcomes rdf:resource="#identify soil properties, compressibility and strength for soil foundation design."/>
