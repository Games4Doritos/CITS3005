  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss developments in musical theatre.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1939">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate critical reading, thinking, and communication skills in relation to musical theatre.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1940">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate knowledge of key musical theatre developments to relevant cultural and historical contexts.</hasOutcomeDescription>
</owl:NamedIndividual>

