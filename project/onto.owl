<owl:NamedIndividual rdf:about="#CHPR5550">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#apply a comprehensive understanding of design processes and methodologies to a complex, real world chemical engineering design project."/>
  <hasUnitOutcomes rdf:resource="#work with information that may be incomplete or uncertain, including quantifying the effect of this on the design and, where appropriate, presenting strategies to mitigate deficiencies."/>
  <hasUnitOutcomes rdf:resource="#generate an innovative design for processes, systems and products to fulfil new needs."/>
  <hasUnitOutcomes rdf:resource="#evaluate the proposed chemical process for environmental impact, safety, and life cycle analysis."/>
  <hasUnitOutcomes rdf:resource="#evaluate the process economics, and financial and other risks associated with the project."/>
  <hasUnitOutcomes rdf:resource="#work effectively as individuals and in diverse groups to produce effective key process design documentation and activities."/>
  <hasUnitAssessments rdf:resource="#group reports"/>
  <hasUnitAssessments rdf:resource="#individual reports"/>
  <hasUnitAssessments rdf:resource="#group presentation"/>
  <hasPrerequisiteDegrees rdf:resource="#62550"/>
  <hasContactRequirement rdf:resource="#contactrequirement1051"/>
  <hasContactRequirement rdf:resource="#contactrequirement1052"/>
  <hasPrerequisiteUnits rdf:resource="#CHPR3018"/>
  <hasPrerequisiteUnits rdf:resource="#CHPR3019"/>
  <hasPrerequisiteUnits rdf:resource="#CHPR3406"/>
  <hasPrerequisiteUnits rdf:resource="#GENG3000"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR5550</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Engineering Design Project</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHPR5550 is a capstone experience in the Chemical Engineering major in the BE(Hons) and should be taken in your last year of study.  Working in a team, typically with four to six members, you will be required to integrate and apply knowledge and skills acquired in earlier units to a substantial real-world design challenge in chemical engineering. Teams are supervised by an academic and/or industry mentor. Teams are responsible for managing their project as well as reporting against milestones and preparing the necessary design documentation. The academic objectives of the project are to lead students through a systematic engineering design and synthesis process and to better prepare them for professional practice as engineers. The focus of the unit is on teamwork skills and the design process.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 62550 Master of Professional Engineering (Chemical Engineering specialisation) and  Successful completion of CHPR4406 Reaction Engineering or Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and a WAM of at least 50 and  Successful completion of ( CHPR3018 Process Synthesis and Design 2 and CHPR3019 Unit Operations and CHPR3406 Reaction Engineering and GENG3000 Engineering Practice 3 )</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#apply a comprehensive understanding of design processes and methodologies to a complex, real world chemical engineering design project.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply a comprehensive understanding of design processes and methodologies to a complex, real world chemical engineering design project.</hasOutcomeDescription>
</owl:NamedIndividual>

