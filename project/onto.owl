<owl:NamedIndividual rdf:about="#MATH1721">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#use the language of mathematics to explain mathematical concepts."/>
  <hasUnitOutcomes rdf:resource="#solve problems involving trigonometric, exponential and logarithmic functions."/>
  <hasUnitOutcomes rdf:resource="#solve problems involving linear, quadratic and simple simultaneous equations."/>
  <hasUnitOutcomes rdf:resource="#apply methods of differentiation and integration to polynomials, exponentials and logarithms."/>
  <hasUnitAssessments rdf:resource="#weekly online quizzes and workshop participation"/>
