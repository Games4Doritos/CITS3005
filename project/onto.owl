  <hasLocation rdf:resource="#Albany"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVT2220</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Climate System</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit investigates the physical basis of the climate system and mechanisms of anthropogenic climate change and variability. Importance is placed on the role of the land surface in the climate system including the carbon cycle, land use change and urbanisation.  Processes such as the greenhouse effect, aerosols, the El Nino-Southern Oscillation, climate feedbacks and rapid climate change are examined. Paleo, historical and climate model data are presented and assessed. Likely future climate changes are addressed and option for adaptation and mitigation for human society.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2718">
