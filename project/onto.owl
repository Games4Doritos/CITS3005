  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse the resource management models.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#formulate pollution control problems as resource allocation problems to achieve optimal outcomes, and demonstrate an understanding of pollution control policies and instruments.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate pollution control problems as resource allocation problems to achieve optimal outcomes, and demonstrate an understanding of pollution control policies and instruments.</hasOutcomeDescription>
</owl:NamedIndividual>

