  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conduct appropriate health screening and risk stratification assessments to promote safe participation in an exercise program.</hasOutcomeDescription>
</owl:NamedIndividual>

