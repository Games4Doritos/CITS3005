  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate broad historical perspectives on the nature and contexts of music and the relevance of historical and stylistic conventions from various periods.</hasOutcomeDescription>
</owl:NamedIndividual>

