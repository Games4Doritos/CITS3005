  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adapt acquired knowledge concerning the observation and evaluation of fundamental and applied motor skills to practical movement settings.</hasOutcomeDescription>
</owl:NamedIndividual>

