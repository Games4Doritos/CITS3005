  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate effective communication strategies.</hasOutcomeDescription>
</owl:NamedIndividual>

