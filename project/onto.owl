  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1)	demonstrate writing that is clear, well-structured and appropriate to audience and purpose.</hasOutcomeDescription>
