<owl:NamedIndividual rdf:about="#outcome1317">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse the key issues and debates around the emergence of ideas concerning 'rights' and the specific development of the contested concept of 'human rights'.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1318">
