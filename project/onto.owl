  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">implement object-oriented design of solutions to real-world problems.</hasOutcomeDescription>
</owl:NamedIndividual>

