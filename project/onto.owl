<owl:NamedIndividual rdf:about="#MUSC1341">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MUSST"/>
  <isInMajors rdf:resource="#major25"/>
  <hasUnitOutcomes rdf:resource="#in performance—."/>
  <hasUnitOutcomes rdf:resource="#in composition—."/>
  <hasUnitAssessments rdf:resource="#performers: solo repertoire examination"/>
  <hasUnitAssessments rdf:resource="#collaborative music project"/>
  <hasUnitAssessments rdf:resource="#performance stream: learning module, or composition stream: workshop participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement449"/>
  <hasContactRequirement rdf:resource="#contactrequirement450"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1341</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Principal Studies 1</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This practical unit draws together students from different levels of musical experience at pre-tertiary level, and consolidates essential musicianship, technical skills and repertory in either performance or composition. For performers, the emphasis is on development of instrumental technique and performance skills including developing an awareness of psychological, biomechanical/performance health concepts, and preparing students for the repertoire-based focus of the next unit in the sequence, MUSC1342 Principal Studies 2. For composers, technical skills are developed through short composition exercises based on pertinent examples from the repertoire of twentieth- and twenty-first-century music. This prepares students for a study of higher level techniques introduced in the next unit in the sequence, MUSC1342 Principal Studies 2. This unit is a complementary unit in the Music Studies major (degree-specific major) in the Bachelor of Arts degree.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of Conservatorium of Music audition/composition portfolio</hasPrerequisiteText>
</owl:NamedIndividual>

