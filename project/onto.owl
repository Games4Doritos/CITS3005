  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate ideas in writing relating to advanced formulations of quantum mechanics and performed experiments, at an expert level.</hasOutcomeDescription>
</owl:NamedIndividual>

