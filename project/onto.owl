<owl:NamedIndividual rdf:about="#POLS2220">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major12"/>
  <isInMajors rdf:resource="#major9"/>
  <hasUnitOutcomes rdf:resource="#describe the evolution and operation of the major institutions, actors, and processes of the global political economy."/>
  <hasUnitOutcomes rdf:resource="#critically analyse influential ideas and concepts in global political economy and demonstrate an understanding of their significance."/>
  <hasUnitOutcomes rdf:resource="#creatively apply critical thinking and problem-solving skills to independently and collaboratively address challenges and issues in the global political economy."/>
  <hasUnitOutcomes rdf:resource="#competently apply basic Political Science and International Relations research methods and skills to designing and executing research about the global political economy."/>
  <hasUnitOutcomes rdf:resource="#effectively communicate knowledge, ideas, analyses and arguments about the global political economy in a variety of formats."/>
  <hasUnitAssessments rdf:resource="#tutorial participation"/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasUnitAssessments rdf:resource="#research essay"/>
  <hasContactRequirement rdf:resource="#contactrequirement490"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">POLS2220</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Foundations of Global Political Economy</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores how politics and economics are fundamentally connected. By locating key economic issues and questions in their broader political context, you will explore the evolution of the global political economy, and consider how it has been shaped by powerful states, such as the US and China, and influential institutions, like the World Bank and the World Trade Organisation. This unit enables students to understand the uneven nature of economic development, the persistence of poverty and inequality, as well as disputes over trade and the everyday impacts of international financial crises. By completing this unit, students can (1) develop a comprehensive understanding of the contemporary dynamics and historical evolution of the global political economy; and (2) evaluate competing explanations of its operation.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12 points of Social Sciences and/or Humanities study at level 1</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#describe the evolution and operation of the major institutions, actors, and processes of the global political economy.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the evolution and operation of the major institutions, actors, and processes of the global political economy.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#critically analyse influential ideas and concepts in global political economy and demonstrate an understanding of their significance.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse influential ideas and concepts in global political economy and demonstrate an understanding of their significance.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#creatively apply critical thinking and problem-solving skills to independently and collaboratively address challenges and issues in the global political economy.">
