  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1013</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematical Analysis</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with a foundation in mathematical analysis, including the notions of limits, continuity of functions, least upper bounds, convexity, inverse functions, uniform convergence of series. It covers the definitions, theorems and proofs that are critical to mathematical analysis, geometry, number theory and physics.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mathematics Specialist ATAR or MATH1722 Mathematics Foundations: Specialist or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3133">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain and exploit the notions of limits and continuity of functions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3134">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate rigorous proofs in foundational mathematics.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3135">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply theoretical and analytic arguments to problems in physics, geometry and number theory.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3136">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate technical ideas succinctly and effectively.</hasOutcomeDescription>
</owl:NamedIndividual>

