  <hasPrerequisite rdf:resource="#STAX1400"/>
  <hasPrerequisite rdf:resource="#ENVT1104"/>
  <hasPrerequisite rdf:resource="#STAT1400"/>
  <hasPrerequisite rdf:resource="#BIOL1131"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANIM3365</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Behavioural Ecology</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Behavioural Ecology unit covers the broad area of behavioural ecology – how an animal's behaviour is adapted to its physical and social environment. The unit comprises five modules: (1) Foundations of Behavioural Ecology; (2) Sexual Selection; (3) Predator-prey interactions; (4) Perception and Signalling; and (5) Kinship, Conflict, Cooperation and Social Behaviour. The unit is taught by a team of lecturers who combine expertise in all of these areas. The unit integrates these themes within an evolutionary framework that explores the adaptive basis of behaviour, individual plasticity and the genetic basis of behaviour, ecological interactions governing social, sexual and antipredator behaviours, along with a strong mechanistic understanding of how perceptual systems work. This is a required unit for the Zoology major, but it should also be relevant to any student with interests in animal biology, ecology, evolutionary biology and natural history.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of one Unit(s) ANIM2207 Animal Form and Function (ID 1298) or ENVT2250 Ecology (ID 1228)</hasPrerequisiteText>
</owl:NamedIndividual>

