  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop research designs utilising key theoretical, practical, and ethical principles of archaeological field work.</hasOutcomeDescription>
</owl:NamedIndividual>

