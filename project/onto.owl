<owl:NamedIndividual rdf:about="#JAPN2403">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-JPNSB"/>
  <hasUnitOutcome rdf:resource="#outcome1680"/>
  <hasUnitOutcome rdf:resource="#outcome1681"/>
  <hasUnitOutcome rdf:resource="#outcome1682"/>
  <hasUnitOutcome rdf:resource="#outcome1683"/>
  <hasUnitOutcome rdf:resource="#outcome1684"/>
  <hasUnitOutcome rdf:resource="#outcome1685"/>
