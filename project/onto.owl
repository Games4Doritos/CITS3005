  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reflect on the ethical dimensions of interpreting and misrepresenting the past.</hasOutcomeDescription>
</owl:NamedIndividual>

