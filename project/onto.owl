  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the importance of creativity, innovation and new marketplace design with respect to contemporary marketing strategy. Numerous industry examples are drawn on to enhance student understanding of the key aspects of this unit. Students can expect to build on their learning gained in the Level 2 units in marketing.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
