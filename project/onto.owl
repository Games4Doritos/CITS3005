  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">competently apply basic Political Science and International Relations methods and skills to design and execute research on the Chinese politics and international relations.</hasOutcomeDescription>
</owl:NamedIndividual>

