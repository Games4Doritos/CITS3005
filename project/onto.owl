<owl:NamedIndividual rdf:about="#MUSC1351">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MUSMS"/>
  <hasUnitOutcomes rdf:resource="#identify important women in music history and articulate their significance."/>
  <hasUnitOutcomes rdf:resource="#identify places and contexts in which women have traditionally been musically active."/>
  <hasUnitOutcomes rdf:resource="#demonstrate understanding of social, cultural and political constructions of gender and their impact on the roles women played in music."/>
  <hasUnitOutcomes rdf:resource="#describe women's experiences and accomplishments in a variety of musical roles in several musical genres."/>
  <hasUnitOutcomes rdf:resource="#discuss a number of compositions by women composers."/>
  <hasUnitAssessments rdf:resource="#seminar activities"/>
  <hasUnitAssessments rdf:resource="#portfolio"/>
  <hasUnitAssessments rdf:resource="#final exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement438"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MUSC1351</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Women in Music</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Women have played significant roles in all aspects of music throughout history. This unit explores women's musical activities in a wide variety of roles including composer, performer, patron, teacher, critic, and musical object and symbol. Students study gender ideologies in various historical times, geographic locations, and culturally diverse contexts, and examine their effect on the ways in which women have been able to participate in music. Study also takes into account how related constructions of identity (such as class, ethnicity and race) intersect with issues of gender and sexuality. Topics covered are drawn from different musical genres, historical periods and places.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#identify important women in music history and articulate their significance.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify important women in music history and articulate their significance.</hasOutcomeDescription>
</owl:NamedIndividual>

