<owl:NamedIndividual rdf:about="#GENG1014">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-ECIVL"/>
  <isInMajors rdf:resource="#MJD-EENVE"/>
  <isInMajors rdf:resource="#MJD-EMINE"/>
  <hasUnitOutcomes rdf:resource="#explain the key components of the earth systems, including the geosphere, hydrosphere, biosphere, and atmosphere, and how they relate to engineering practice."/>
  <hasUnitOutcomes rdf:resource="#describe the processes governing rock and soil formation, and the influence of the atmosphere and
hydrosphere on these processes."/>
  <hasUnitOutcomes rdf:resource="#articulate the cycle of resource exploration and extraction and how it interacts with the earth system and society."/>
  <hasUnitOutcomes rdf:resource="#articulate the relationship between the major earth system cycles and their role in providing services to
society."/>
  <hasUnitOutcomes rdf:resource="#illustrate the connectivity of the earth system cycles through a case study."/>
  <hasUnitAssessments rdf:resource="#quizzes"/>
  <hasUnitAssessments rdf:resource="#assignments"/>
  <hasUnitAssessments rdf:resource="#participation and collaborative learning"/>
  <hasContactRequirement rdf:resource="#contactrequirement1063"/>
  <hasContactRequirement rdf:resource="#contactrequirement1064"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENG1014</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Earth Systems Engineering</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Through this unit, student engineers will be able to recognise and explain the interconnectedness between the natural and built environments and society, as a foundation to design sustainable engineering solutions and to be responsible stewards of the Earth. This unit provides an introduction to the physical, geological, hydrological and ecological processes for earth systems engineering, and a holistic systems approach to how these processes respond and interact with each other. The unit covers theories and quantitative techniques to understand interactions between water, air and soil, and the ecosystem response to these interactions.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#explain the key components of the earth systems, including the geosphere, hydrosphere, biosphere, and atmosphere, and how they relate to engineering practice.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the key components of the earth systems, including the geosphere, hydrosphere, biosphere, and atmosphere, and how they relate to engineering practice.</hasOutcomeDescription>
</owl:NamedIndividual>

