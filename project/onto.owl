  <hasUnitAssessments rdf:resource="#media project"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement99"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMM2002</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Media Production Techniques</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores the practices and concepts of media production, with a particular emphasis on audiovisual storytelling. Through hands-on introductory training and activities, students develop technical and storytelling skills in media production. The unit fosters both creative engagement and critical reflection in the context of contemporary media practices.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 credit points at Level 1</hasPrerequisiteText>
</owl:NamedIndividual>

