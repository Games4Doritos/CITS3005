  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop simple models to analyse sound generation and transmission.</hasOutcomeDescription>
</owl:NamedIndividual>

