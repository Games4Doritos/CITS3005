<owl:NamedIndividual rdf:about="#FREN3409">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-FRNHA"/>
  <hasUnitOutcomes rdf:resource="#demonstrate competency in listening, speaking, reading, and writing French corresponding to level C2 of the Common European Framework of Reference for Languages."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an increased awareness of intercultural understanding and language learning."/>
  <hasUnitOutcomes rdf:resource="#use research skills and communication strategies in both French and English."/>
  <hasUnitAssessments rdf:resource="#written tests"/>
  <hasUnitAssessments rdf:resource="#oral tasks"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement183"/>
  <hasPrerequisiteUnits rdf:resource="#FREN2408"/>
  <hasPrerequisiteUnits rdf:resource="#FREN3408"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN3409</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Studies 9</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from FREN2408 French Studies 8. In this unit students develop advanced skills in French speaking, reading, writing and aural comprehension and deepen their understanding of French and francophone culture. Through analysing literary works, writing creatively, conducting interviews and making oral presentations students refine their language abilities and further extend their understanding of French-speaking societies, their literature and history. Students achieve language proficiency corresponding to Level C2 of the Common European Framework of Reference for Languages.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN2408 French Studies 8 or FREN3408 French Studies 8</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate competency in listening, speaking, reading, and writing French corresponding to level C2 of the Common European Framework of Reference for Languages.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate competency in listening, speaking, reading, and writing French corresponding to level C2 of the Common European Framework of Reference for Languages.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate an increased awareness of intercultural understanding and language learning.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased awareness of intercultural understanding and language learning.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#use research skills and communication strategies in both French and English.">
