  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mid-semester theory examination</hasAssessmentDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment417">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10- to 15-page semester paper</hasAssessmentDescription>
</owl:NamedIndividual>

