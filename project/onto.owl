  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply theoretical knowledge of and practical proficiency in creative project planning.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1923">
