  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics ATAR or PHYS1030 Physics Bridging Unit and Mathematics Methods ATAR or MATH1721 Mathematics Foundations: Methods or MATX1721 Mathematics Foundations</hasPrerequisiteText>
</owl:NamedIndividual>

