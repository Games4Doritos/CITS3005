  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON3371</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Econometric Methods and Data Analysis</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is about the application of econometric methods across a range of economics fields using a practical,  hands-on approach. Students learn how to  analyse data across different economic fields such as finance, public economics, health, and economic growth. Additionally, it offers the opportunity to develop programming skills.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECON2271 Introductory Econometrics</hasPrerequisiteText>
</owl:NamedIndividual>

