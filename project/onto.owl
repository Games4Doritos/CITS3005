  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasBridgingUnit">
  <rdfs:subPropertyOf rdf:resource="#hasUnit"/>
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDegreeLocation">
  <rdfs:subPropertyOf rdf:resource="#hasLocation"/>
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#Location"/>
  <owl:inverseOf rdf:resource="#hasDegreeAvailable"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDegreeAvailable">
  <rdfs:domain rdf:resource="#Location"/>
  <rdfs:range rdf:resource="#Degree"/>
  <owl:inverseOf rdf:resource="#hasDegreeLocation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#comprisesDegree">
  <rdfs:domain rdf:resource="#CombinedBachelorDegree"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#BachelorDegree"/>
        <rdf:Description rdf:about="#HonoursDegree"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTeachingPeriod">
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#TeachingPeriod"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnitLocation">
