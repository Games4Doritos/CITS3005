  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how archaeological laboratory analysis informs archaeological analysis and theory.</hasOutcomeDescription>
</owl:NamedIndividual>

