</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#) creatively apply critical thinking and problem-solving skills to independently and collaboratively address challenges, crises and change in South Asian and Middle Eastern politics.">
  <rdf:type rdf:resource="#Outcome"/>
