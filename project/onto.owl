<owl:NamedIndividual rdf:about="#GENG5505">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#evaluate sustainable project management theories and frameworks and apply them to real world projects."/>
  <hasUnitOutcomes rdf:resource="#identify and evaluate problems relating to initiating, planning, executing, monitoring and controlling and finalizing projects and choose appropriate frameworks and theories to solve them."/>
  <hasUnitOutcomes rdf:resource="#analyse how project alignment supports organisational goals, and evaluate the strategic importance of effective project portfolio selection."/>
  <hasUnitOutcomes rdf:resource="#identify the project stakeholders and propose effective response strategies to manage stakeholder pressure in both local and global projects."/>
  <hasUnitOutcomes rdf:resource="#formulate effective communication strategies."/>
  <hasUnitOutcomes rdf:resource="#apply leadership and management principles to guide a team through different project phases, evaluate team performance, and propose strategies to resolve conflict among team members."/>
  <hasUnitOutcomes rdf:resource="#evaluate the main normative ethical theories and apply them to specific real world projects."/>
  <hasUnitAssessments rdf:resource="#group written project report"/>
  <hasUnitAssessments rdf:resource="#group presentation"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
