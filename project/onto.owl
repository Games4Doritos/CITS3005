</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3166">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand how these geometry techniques can be applied to mechanics and physics.</hasOutcomeDescription>
</owl:NamedIndividual>

