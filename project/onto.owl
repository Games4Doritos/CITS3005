  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on the chemical principles and techniques introduced in CHEM2102-Metals in Molecules and covers several advanced topics concerned with the synthesis of molecules containing metals, or catalysed by metals, and their applications. The unit considers the chemistry of complexes that contain direct metal carbon bonds, as well as the types of ligands that are found, their stability and their reactivity. Appreciation of the roles metals play in conferring important properties to materials is also discussed.
This unit will be offered from: TBA</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of CHEM2101 Analytical Methods and CHEM2102 Metals in Molecules and CHEM3101 Workplace Safety and Advanced Analytical Methods</hasPrerequisiteText>
</owl:NamedIndividual>

