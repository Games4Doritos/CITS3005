  <hasUnitAssessments rdf:resource="#essay"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS1104"/>
  <hasPrerequisiteUnits rdf:resource="#LAWX1104"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS1111"/>
  <hasPrerequisiteUnits rdf:resource="#LAWS1120"/>
