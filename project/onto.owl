  <hasUnitOutcomes rdf:resource="#craft, revise and edit a complete literary work."/>
  <hasUnitOutcomes rdf:resource="#develop ability to apply creative technique, with an awareness of literary context."/>
  <hasUnitOutcomes rdf:resource="#gain a critical understanding of the manner in which literary concepts and theories intersect with practice in creative writing as a discipline."/>
  <hasUnitOutcomes rdf:resource="#enhance skills in reading and responding to creative writing in a workshop situation."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an historicised understanding of both fundamental critical concepts and creative writing as a cultural practice."/>
  <hasUnitOutcomes rdf:resource="#develop and practice enquiry-based learning and research as relevant specifically to creative practice."/>
  <hasUnitAssessments rdf:resource="#creative project outline"/>
  <hasUnitAssessments rdf:resource="#creative project"/>
  <hasUnitAssessments rdf:resource="#workshop and tutorial participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement140"/>
  <hasContactRequirement rdf:resource="#contactrequirement141"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENGL2501</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Creative Writing: Theory and Practice</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit of study in the writer's craft aims to stimulate and guide students' creative writing, while considering the intersection between theory and practice inherent in writing as an act. It engages with key theoretical approaches to the discipline in order to understand the relationship between the writer and society, alerting students to contemporary literary forms, discourses and language. Students attend workshops and submit writing in the genre of their choice—poetry or fiction. Lectures and workshops consider a mixture of received literature and students' own works in order to understand the complex cultural and social discourses we inherently involve ourselves in when producing writing.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 points of study</hasPrerequisiteText>
</owl:NamedIndividual>

