<owl:NamedIndividual rdf:about="#MJD-ENVSC">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#demonstrate the skills and knowledge to assess environmental systems, using field, laboratory, modelling and statistical methodologies."/>
  <hasMajorOutcomes rdf:resource="#integrate ecological, physical and chemical processes to guide decision making with respect to human intervention in the environment."/>
  <hasMajorOutcomes rdf:resource="#demonstrate the knowledge to manage and rehabilitate disturbed systems such as natural and agricultural catchments, post mining landscapes, contaminated sites, urban environments, etc."/>
  <hasMajorOutcomes rdf:resource="#demonstrate competency in laboratory practice, fieldwork study, report writing, oral presentation and team work skills suited to gain employment in the disciplines of Environmental Science."/>
  <isAvailableInDegree rdf:resource="#BP004"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasBridgingUnits rdf:resource="#CHEM1003"/>
  <hasBridgingUnits rdf:resource="#MATH1720"/>
