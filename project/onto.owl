  <hasCoreUnits rdf:resource="#ENGL3200"/>
  <hasCoreUnits rdf:resource="#ENGL3300"/>
  <hasCoreUnits rdf:resource="#ENGL3602"/>
  <hasCoreUnits rdf:resource="#ENGL3604"/>
  <hasCoreUnits rdf:resource="#ENGL3801"/>
  <hasMajorCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-EGCST</hasMajorCode>
  <hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">English and Literary Studies</hasMajorTitle>
  <hasMajorSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasMajorSchool>
  <hasMajorDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Studying English and Literary Studies enriches students' understanding, enjoyment and practice of major literary, cinematic and theatrical forms. This major includes units that span historical periods and cultures, and involves the study of literary history; creative writing and theatre; popular culture and film; and critical theory. The emphasis is on developing an understanding of how we communicate and of diverse forms of representation across time, place and media.</hasMajorDescription>
</owl:NamedIndividual>

