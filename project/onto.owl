  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand basic texts, and read for general interest or enjoyment.</hasOutcomeDescription>
</owl:NamedIndividual>

