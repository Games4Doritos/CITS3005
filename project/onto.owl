  <hasOutcome rdf:resource="#outcome1790"/>
  <hasOutcome rdf:resource="#outcome1789"/>
  <hasPrerequisiteUnit rdf:resource="#LING1002"/>
  <hasPrerequisite rdf:resource="#LING1002"/>
  <hasPrerequisite rdf:resource="#LING2002"/>
  <hasPrerequisite rdf:resource="#LING2201"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LING3003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Language Across Time</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on the investigation and explanation of language change, both as a consequence of internal forces within a language community and through contact between language communities. It considers the history of thinking about language change and its role in the development of linguistics as a science, the development of the comparative method as a means of reconstructing past language states, and theories of language classification based on historical relationships of both inheritance and diffusion.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">( LING2002 Phonetics and Phonology: the Sounds of the World's Languages or LING2201 Phonetics and Phonology)</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1789">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the process of language change and linguistic divergence.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1790">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use the comparative method to reconstruct past stages of a language.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1791">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate sub-grouping arguments and arguments about the primary genetic relationship between languages.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1792">
