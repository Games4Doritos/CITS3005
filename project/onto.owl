</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome3159">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">model and solve biological, physical and industrial problems through the use of partial differential equations.</hasOutcomeDescription>
</owl:NamedIndividual>

