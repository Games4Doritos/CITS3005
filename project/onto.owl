  <hasContactRequirement rdf:resource="#contactrequirement892"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS1104</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Introduction to Law</hasUnitTitle>
