  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse and interpret responses of process control system disturbances using control theory.</hasOutcomeDescription>
</owl:NamedIndividual>

