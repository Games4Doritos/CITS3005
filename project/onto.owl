<owl:NamedIndividual rdf:about="#CHEM2101">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major27"/>
  <isInMajors rdf:resource="#MJD-CHEMY"/>
  <hasUnitOutcomes rdf:resource="#describe the principles and concepts related to techniques for separation science."/>
  <hasUnitOutcomes rdf:resource="#describe the principles and concepts related to spectroscopic and spectrometric determination of molecular structure."/>
  <hasUnitOutcomes rdf:resource="#describe the principles and concepts related to electrochemistry."/>
  <hasUnitOutcomes rdf:resource="#demonstrate practical skills in the operation of relevant instrumentation and data analysis."/>
  <hasUnitOutcomes rdf:resource="#acquire skills in scientific writing, chemical literacy, problem solving, critical analysis and teamwork."/>
  <hasUnitAssessments rdf:resource="#laboratory reports and worksheets"/>
  <hasUnitAssessments rdf:resource="#quizzes"/>
  <hasUnitAssessments rdf:resource="#a final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement633"/>
