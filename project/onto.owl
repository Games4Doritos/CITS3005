  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate literary and cinematic texts with detailed knowledge of important sci-fi, fantasy and speculative fiction theories.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome992">
