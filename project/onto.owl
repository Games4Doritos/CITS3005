  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate advanced written communication and research skills in expressing concepts in decision theory and associated fields.</hasOutcomeDescription>
</owl:NamedIndividual>

