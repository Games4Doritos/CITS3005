  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply effective strategies for self-directed collaborative and practice music making skills.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment307">
