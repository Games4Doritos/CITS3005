  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">online tests</hasAssessmentDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ITAL3816">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 2"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-ITLNB"/>
  <isInMajor rdf:resource="#MJD-ITLNI"/>
  <isInMajor rdf:resource="#MJD-ITLNA"/>
  <hasUnitOutcome rdf:resource="#outcome1612"/>
  <hasUnitOutcome rdf:resource="#outcome1613"/>
  <hasUnitOutcome rdf:resource="#outcome1614"/>
  <hasUnitOutcome rdf:resource="#outcome1615"/>
  <hasUnitAssessment rdf:resource="#assessment260"/>
  <hasUnitAssessment rdf:resource="#assessment3"/>
  <hasUnitAssessment rdf:resource="#assessment261"/>
  <hasContactRequirement rdf:resource="#contactrequirement1"/>
  <hasOutcome rdf:resource="#outcome1614"/>
  <hasOutcome rdf:resource="#outcome1615"/>
  <hasOutcome rdf:resource="#outcome1612"/>
  <hasOutcome rdf:resource="#outcome1613"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITAL3816</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dante's Divine Comedy: a medieval masterpiece for the modern world</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is a study of one of the great works of world literature, Dante's Divine Comedy. The unit focusses on the structure of the work and the nature and meaning of Dante's journey through the otherworld. From the first line, Dante states that his individual journey is actually the universal journey of the human condition. Though it is now 700 years since the Comedy was completed, interest in Dante continues to grow. The unit will analyse what this medieval masterpiece, so deeply rooted in the Italy of Dante's own time, has to say that appeals to modern readers. The focus will be on the themes of good and evil; suffering, justice and mercy; Church and State; freedom and desire; and how Dante finds poetic expression for the deepest questions that are part of the human condition.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any Level 2 Italian unit or approval of Convener</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1612">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate understanding of this medieval text and its relevance to the contemporary world.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1613">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate single episodes in the text to the overall structure.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1614">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically compare medieval and modern attitudes to questions of individual morality and social co-existence.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1615">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse how Dante reworked biblical, classical, mythological and contemporary figures to construct his poetic universe.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment260">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-class presentation</hasAssessmentDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment261">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation in tutorials and online forum</hasAssessmentDescription>
</owl:NamedIndividual>

