</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#identify strategies to mitigate beach erosion using conventional ‘hard' and ‘soft'  engineering solutions.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify strategies to mitigate beach erosion using conventional ‘hard' and ‘soft'  engineering solutions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#design submerged structures, such as artificial reefs and submerged breakwaters, suitable for different applications.">
