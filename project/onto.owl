  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the relationship between contemporary operating systems, programming languages and systems-level application programming interfaces.</hasOutcomeDescription>
</owl:NamedIndividual>

