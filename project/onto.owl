<owl:NamedIndividual rdf:about="#MATH1014">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MATHS"/>
  <hasUnitOutcomes rdf:resource="#explain and exploit the notions of sets, functions, relations, and cardinality."/>
  <hasUnitOutcomes rdf:resource="#formulate rigorous proofs using abstract number systems and associated algebraic objects."/>
  <hasUnitOutcomes rdf:resource="#employ the axiomatic definition of an abstract vector space, of linear transformations and of linear independence."/>
  <hasUnitOutcomes rdf:resource="#explain and apply the relationship between a spectral decomposition of a vector space and the diagonalisation of certain linear transformations."/>
  <hasUnitOutcomes rdf:resource="#communicate technical ideas succinctly and effectively."/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1722"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1014</hasUnitCode>
