  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply evidence and analysis to improve environmental management decisions.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2692">
