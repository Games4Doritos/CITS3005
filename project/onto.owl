<owl:NamedIndividual rdf:about="#MJD-HISTY">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#demonstrate a capacity to understand imaginatively other times, societies and cultures."/>
  <hasMajorOutcomes rdf:resource="#demonstrate an awareness of the world we live in, through reference to important aspects of humanity's past experience."/>
  <hasMajorOutcomes rdf:resource="#demonstrate a knowledge of major historical developments in a range of times and places."/>
  <hasMajorOutcomes rdf:resource="#identify main issues in a body of complex historical material."/>
  <hasMajorOutcomes rdf:resource="#critically evaluate differences and issues in others' interpretations of historical events."/>
  <hasMajorOutcomes rdf:resource="#describe and interpret evidence of past human experience, proposing explanations for the content of such evidence with reference to concepts such as power, myth, representation, culture and social structure."/>
  <hasMajorOutcomes rdf:resource="#independently formulate a logical argument, supported by relevant evidence."/>
  <hasMajorOutcomes rdf:resource="#express ideas in clear, cogent and correct English."/>
  <hasMajorOutcomes rdf:resource="#conduct independent research by locating and organising information relating to a specific question or problem; (10) utilise historical resources for research exercises and apply critical and analytical tools to them; and (11) demonstrate a knowledge of the causes of historical change in a range of times and places."/>
  <isAvailableInDegree rdf:resource="#BP001"/>
  <isAvailableInDegree rdf:resource="#BH005"/>
  <hasCoreUnits rdf:resource="#HIST1001"/>
  <hasCoreUnits rdf:resource="#HIST1003"/>
  <hasCoreUnits rdf:resource="#HIST1103"/>
  <hasCoreUnits rdf:resource="#HIST1104"/>
  <hasCoreUnits rdf:resource="#HIST1901"/>
