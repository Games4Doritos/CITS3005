  <isInMajors rdf:resource="#MJD-EMECH"/>
  <hasUnitOutcomes rdf:resource="#draw properly annotated free body diagrams."/>
  <hasUnitOutcomes rdf:resource="#use different coordinate systems and reference frames to derive kinematic equations for rigid bodies and mechanisms undergoing planar motion."/>
  <hasUnitOutcomes rdf:resource="#apply momentum and energy methods to predict the dynamic behaviour of rigid bodies undergoing planar motion."/>
