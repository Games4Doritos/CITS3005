  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recognise and describe the forms and functions of a greater variety of Greek nouns, adjectives, pronouns and verbs.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome768">
