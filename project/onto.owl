  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corporate Accounting</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an intermediate unit in financial accounting with a primary focus on accounting for companies. Current Australian practice is examined and integrated with broader theoretical perspectives, seeking to provide the student with a comprehensive and up to date understanding of the key relevant issues in the current corporate accounting environment.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
