  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand and critically assess the various economic and geopolitical issues in relations between Australia and Asian nations and peoples.</hasOutcomeDescription>
</owl:NamedIndividual>

