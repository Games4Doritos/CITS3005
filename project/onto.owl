<owl:NamedIndividual rdf:about="#MJD-BCHMB">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#demonstrate an in-depth understanding of the theoretical basis of biochemistry and molecular biology."/>
  <hasMajorOutcomes rdf:resource="#demonstrate critical analysis and the application of scientific method to biochemical problems."/>
  <hasMajorOutcomes rdf:resource="#demonstrate technical competency in basic laboratory skills including solution preparation, qualitative and quantitative analytical methods, and operation of general laboratory equipment."/>
  <hasMajorOutcomes rdf:resource="#effectively communicate biochemical and molecular biological knowledge in both written and oral forms."/>
  <hasMajorOutcomes rdf:resource="#demonstrate competency in high-level critical thinking and communication skills suited to gaining employment in the field of  biochemistry and molecular biology."/>
