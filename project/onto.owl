  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visually and orally present the evidence for the success or failure of different evaluation and reward systems.</hasOutcomeDescription>
</owl:NamedIndividual>

