  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate the role of analysis in the design process.</hasOutcomeDescription>
</owl:NamedIndividual>

