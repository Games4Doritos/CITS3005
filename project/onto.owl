<owl:NamedIndividual rdf:about="#MGMT2311">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major22"/>
  <hasUnitOutcomes rdf:resource="#describe and discuss theories, concepts and models of organisational learning and innovation pertaining to firms in knowledge-intensive industries."/>
  <hasUnitOutcomes rdf:resource="#describe and discuss key processes and mechanisms that organisations need to develop in order to build learning and innovation capabilities to achieve long-term competitive advantage."/>
  <hasUnitOutcomes rdf:resource="#discuss the role of leadership, organisational structure and processes in facilitating organisational learning and innovation."/>
  <hasUnitOutcomes rdf:resource="#explain and identify the potential issues and problems that managers and leaders encounter in the effective management of organisational learning and innovation."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of the unit's content through its application to solving problems in real-life case studies."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#case studies"/>
  <hasUnitAssessments rdf:resource="#final examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement940"/>
  <hasPrerequisiteUnits rdf:resource="#MGMT1135"/>
  <hasPrerequisiteUnits rdf:resource="#MGMX1135"/>
  <hasPrerequisiteUnits rdf:resource="#MGMT1136"/>
  <hasPrerequisiteUnits rdf:resource="#MGMX1136"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT2311</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organisational Learning and Innovation</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the concepts and issues which influence approaches to organisational structure and design. Topics include contemporary organisational forms; organisation-environment relationships; organisational structures for effective learning and innovation; the role of organisational culture; managing dynamic processes in the workplace; and the impact of knowledge workers on organisational structure and processes. Topics are reinforced through analysis of a range of case studies designed to strengthen students' analytical and problem-solving skills.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MGMT1135 Organisational Behaviour or MGMX1135 Organisational Behaviour or MGMT1136 Management and Organisations or MGMX1136 Management and Organisations</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#describe and discuss theories, concepts and models of organisational learning and innovation pertaining to firms in knowledge-intensive industries.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe and discuss theories, concepts and models of organisational learning and innovation pertaining to firms in knowledge-intensive industries.</hasOutcomeDescription>
</owl:NamedIndividual>

