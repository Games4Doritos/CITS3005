  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use equations of state for real gases to obtain relevant thermodynamic state properties.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#relate measured, fundamental and derived thermodynamic properties to construct hypothetical paths to calculate the change in a desired thermodynamic property between two states.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relate measured, fundamental and derived thermodynamic properties to construct hypothetical paths to calculate the change in a desired thermodynamic property between two states.</hasOutcomeDescription>
</owl:NamedIndividual>

