<owl:NamedIndividual rdf:about="#BUSN2001">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 2"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <isInMajor rdf:resource="#MJD-BUSAN"/>
  <hasUnitOutcome rdf:resource="#outcome3548"/>
  <hasUnitOutcome rdf:resource="#outcome3549"/>
  <hasUnitOutcome rdf:resource="#outcome3550"/>
  <hasUnitOutcome rdf:resource="#outcome3551"/>
  <hasUnitAssessment rdf:resource="#assessment674"/>
  <hasUnitAssessment rdf:resource="#assessment675"/>
  <hasUnitAssessment rdf:resource="#assessment581"/>
  <hasPrerequisiteUnit rdf:resource="#STAT1520"/>
  <hasOutcome rdf:resource="#outcome3548"/>
  <hasOutcome rdf:resource="#outcome3550"/>
  <hasOutcome rdf:resource="#outcome3551"/>
