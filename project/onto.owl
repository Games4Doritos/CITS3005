  <hasPrerequisiteUnits rdf:resource="#PHYS3005"/>
  <hasPrerequisiteUnits rdf:resource="#PHYS4021"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHYS4022</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Advanced Quantum Computing</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers advanced topics in quantum information, computation and communication, such as quantum algorithm design and analysis, efficient quantum computation principles, quantum universality, computability and complexity, quantum simulation, quantum optimisation, quantum machine learning, quantum walks, as well as quantum communication protocols. It aims to provide students with the essential knowledge and skill set to work in the fast-evolving field of quantum computing.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in 53560 Master of Physics or 65550 Master of Quantum Technology and Computing or CM015 Bachelor of Science Frontier Physics and Master of Physics or HON-PHYSC Physics or BH008 Bachelor of Advanced Computer Science [Honours] or HON-MATHS Mathematics or HON-MATHH Mathematics or HON-STATS Statistics or HON-STATH Statistics and PHYS3005 Quantum Computation or PHYS4021 Frontiers in Quantum Computation</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#explain the design principles of efficient quantum algorithms.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the design principles of efficient quantum algorithms.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#perform general quantum algorithm analysis.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perform general quantum algorithm analysis.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#evaluate quantum algorithm efficiency and complexity.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate quantum algorithm efficiency and complexity.</hasOutcomeDescription>
</owl:NamedIndividual>

