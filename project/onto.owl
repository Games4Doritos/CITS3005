<owl:NamedIndividual rdf:about="#ANIM2220">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriod rdf:resource="#Semester 1"/>
  <hasUnitLocation rdf:resource="#UWA (Perth)"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <hasUnitOutcome rdf:resource="#outcome3049"/>
  <hasUnitOutcome rdf:resource="#outcome3050"/>
  <hasUnitOutcome rdf:resource="#outcome3051"/>
  <hasUnitOutcome rdf:resource="#outcome3052"/>
