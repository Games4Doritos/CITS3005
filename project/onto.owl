  <hasPrerequisiteUnits rdf:resource="#ENSC2003"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELEC3014</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Materials and Devices</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Engineering</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides an understanding of electron behaviour as particles and as waves; properties and carrier dynamics of electrons in solids, particularly in semiconductors; the behaviour of pn junctions; and the operation, modelling and design of diodes and transistors.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enrolment in Bachelor of Engineering (Honours) or an associated Combined Degree and  Successful completion of MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods and PHYS2003 Physics for Electrical Engineers and ENSC2003 Engineering Electrical Fundamentals</hasPrerequisiteText>
</owl:NamedIndividual>

