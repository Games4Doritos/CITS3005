  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhibit evidence of skill development in the field of drawing.</hasOutcomeDescription>
</owl:NamedIndividual>

