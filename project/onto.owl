  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is designed for students who have completed ITAL1402 Italian Studies 2 or who have equivalent knowledge of the language. It develops the students' ability to communicate in Italian by providing intensive practice in oral and written language, and enriches students' understanding of the culture of modern Italy. The unit leads to ITAL2404 Italian Studies 4. 
Students achieve language proficiency equivalent to Level A2 of the Common European Framework of Reference for Languages (Quadro Comune Europeo di Riferimento per le Lingue).</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ITAL1402 Italian Studies 2 or ITAL1102 Italian Beginners 2</hasPrerequisiteText>
</owl:NamedIndividual>

