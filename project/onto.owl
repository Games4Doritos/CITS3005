<owl:NamedIndividual rdf:about="#GRMN1405">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-GRMNA"/>
  <hasUnitOutcomes rdf:resource="#demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to proficiency Level B1 and upwards of the Common European Framework of Reference for Languages."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies."/>
  <hasUnitAssessments rdf:resource="#tests and quizzes"/>
  <hasUnitAssessments rdf:resource="#written assignment"/>
  <hasUnitAssessments rdf:resource="#oral tasks"/>
  <hasContactRequirement rdf:resource="#contactrequirement220"/>
  <hasContactRequirement rdf:resource="#contactrequirement221"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRMN1405</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">German Studies 5</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit is the point of entry for students who are native or near-native speakers of German. It integrates speaking, listening comprehension, reading and writing with the study of materials drawn from German literary and cultural history. Focusing on the analysis and discussion of audiovisual materials and selected texts, the seminar introduces students to central issues in German history and society during the first half of the twentieth century. The language class reinforces and deepens the knowledge of contemporary German language usage and grammatical structures at an advanced level. 
Students gain an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to proficiency Level B1 and upwards of the Common European Framework of Reference for Languages (Gemeinsamer Europaischer Referenzrahmen). Students also develop an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies and increased awareness of how languages work in general.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">approval of convener</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to proficiency Level B1 and upwards of the Common European Framework of Reference for Languages.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased level of competency in all four macro skills—listening to, speaking, reading and writing German corresponding to proficiency Level B1 and upwards of the Common European Framework of Reference for Languages.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#demonstrate an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies.">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an increased awareness of intercultural understanding and of language learning, as well as research skills and communication strategies.</hasOutcomeDescription>
</owl:NamedIndividual>

