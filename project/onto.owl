  <hasUnitOutcome rdf:resource="#outcome1180"/>
  <hasUnitAssessment rdf:resource="#assessment23"/>
  <hasUnitAssessment rdf:resource="#assessment168"/>
  <hasUnitAssessment rdf:resource="#assessment64"/>
  <hasContactRequirement rdf:resource="#contactrequirement36"/>
  <hasContactRequirement rdf:resource="#contactrequirement63"/>
  <hasPrerequisiteUnit rdf:resource="#FREN1401"/>
  <hasPrerequisiteUnit rdf:resource="#FREN1101"/>
  <hasOutcome rdf:resource="#outcome1178"/>
  <hasOutcome rdf:resource="#outcome1179"/>
  <hasOutcome rdf:resource="#outcome1176"/>
  <hasOutcome rdf:resource="#outcome1177"/>
  <hasOutcome rdf:resource="#outcome1180"/>
  <hasPrerequisite rdf:resource="#FREN1401"/>
  <hasPrerequisite rdf:resource="#FREN1101"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN1402</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">French Beginners 2</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit follows on from FREN1401 French Beginners 1. It builds on the introduction to French grammar and vocabulary, further developing students' ability to communicate orally and in writing in everyday situations. It focuses on contemporary spoken and written language used in French-speaking countries and uses authentic texts and audiovisual materials to deepen students' understanding of French culture and society. Students achieve language proficiency equivalent to Level A1/A2 of the Common European Framework of Reference for Languages.
The unit leads to FREN2403 French Studies 3. In Level 2 and 3 French units, you will have the opportunity not only to increase language competency but to further engage with French and francophone history and culture (including literature, film, and contemporary society) and to take advantage of a range of exchange possibilities in France and other French-speaking countries.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FREN1401 French Studies 1 or FREN1101 French Beginners 1</hasPrerequisiteText>
</owl:NamedIndividual>

