  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asia in the World Economy</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit introduces students to the role of Asian economies in the world economy. It investigates the recent growth of these economies and current relationship between these economies and the rest of the world.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
