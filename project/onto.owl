  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">build passive and active electrical networks, measure circuit variables and explain discrepancies with mathematical models.</hasOutcomeDescription>
</owl:NamedIndividual>

