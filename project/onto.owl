  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and analyse the main ancient writers of the period.</hasOutcomeDescription>
</owl:NamedIndividual>

