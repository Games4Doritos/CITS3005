  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores current research topics in computational modelling. Students develop skills to identify problems, formulate solutions and conduct further research in open questions in this domain.</hasUnitDescription>
