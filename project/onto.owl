  <hasOutcome rdf:resource="#outcome912"/>
  <hasOutcome rdf:resource="#outcome911"/>
  <hasOutcome rdf:resource="#outcome913"/>
  <hasOutcome rdf:resource="#outcome910"/>
  <isInMajor rdf:resource="#MJD-CRIMN"/>
  <hasPrerequisite rdf:resource="#LAWS1110"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS2231</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transnational and Organised Crime</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit explores key concepts and types of transnational and organised crime in the globalised world. It considers well-understood crimes, such as drug and human trafficking, maritime piracy, cybercrime; emerging crimes, such as various environmental crimes; and enabling crimes, such as corruption, fraud and money laundering. It reviews the roles of law and policing in the international and cross-border space and draws on contemporary academic literature, and non-government and international organisations to understand the causes, vulnerabilities, nexuses, nature and extent of various transnational and organised crimes. Real-world case studies will aid a practical understanding of varying crime groups' modus operandi, alongside relevant theory.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS1110 Crime and Society</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome910">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify the main concepts and types of transnational and organised crime and theories to explain them.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome911">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">critically analyse relevant international laws and counter-measures at the international level.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome912">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assess, analyse and interpret recent trends in transnational and organised crime.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome913">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">present convincing, coherent, and consistent oral and written summaries of the outcomes of research on transnational and organised crime and criminal organisations.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#assessment119">
  <rdf:type rdf:resource="#Assessment"/>
  <hasAssessmentDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group presentation</hasAssessmentDescription>
</owl:NamedIndividual>

