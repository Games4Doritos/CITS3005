  <hasMajorCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MJD-MUSMT</hasMajorCode>
  <hasMajorTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music Theatre</hasMajorTitle>
  <hasMajorSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Music</hasMajorSchool>
  <hasMajorDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Music Theatre Studies Major allows students to develop their artistry and knowledge to engage with the professional and amateur music theatre community. Within the Major, students gain experience and skills across the three major aspects of performance, singing, dancing, and acting. As well as developing their performance skills, students will study topics in music analysis and music theatre history, allowing them to frame their performance through understanding the theoretical frameworks of music. Students will be able to work independently, as well as be given the opportunity to work collaboratively. Students should be aware that this major does not provide a pathway to an Honours.</hasMajorDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome158">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate a developing singing technique in a music theatre style.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome159">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an intermediate level of musicianship in presentation of works within solo, small group and company settings.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome160">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apply skills in singing, acting, and dancing to music theatre performance.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome161">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articulate broad historical perspectives on the nature and contexts of music theatre works and their antecedents.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome162">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">implement techniques in artistic self-management, entrepreneurship, and networking relevant to the music theatre industry.</hasOutcomeDescription>
</owl:NamedIndividual>

