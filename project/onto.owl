<owl:NamedIndividual rdf:about="#SSEH3555">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <hasUnitOutcomes rdf:resource="#explain human growth and the development of motor skills across the lifespan, and the implications for exercise."/>
  <hasUnitOutcomes rdf:resource="#integrate principles from motor control and learning with functional anatomy and biomechanics to assess fundamental movement skill proficiency."/>
  <hasUnitOutcomes rdf:resource="#apply knowledge of motor learning and skill acquisition to design an individualised motor learning program to enhance fundamental movement skills."/>
  <hasUnitOutcomes rdf:resource="#apply principles of Teaching Practice to establish a personal teaching philosophy and skills in instruction, demonstration, teaching strategies, leadership and lesson planning."/>
  <hasUnitOutcomes rdf:resource="#demonstrate professional skills to document and evaluate client progress and communicate effectively with clients, families and other health care and exercise professionals."/>
  <hasUnitOutcomes rdf:resource="#utilise observer-based and technology based assessments to evaluate motor performance, potential risks and dysfunctional motor patterns."/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasUnitAssessments rdf:resource="#practicum assessment activities"/>
  <hasUnitAssessments rdf:resource="#lab based assessments"/>
