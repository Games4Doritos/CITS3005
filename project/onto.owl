  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrate form and content in your creative work via questioning, experiment, problem solving and invention.</hasOutcomeDescription>
</owl:NamedIndividual>

