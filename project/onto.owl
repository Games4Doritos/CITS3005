<owl:NamedIndividual rdf:about="#PHIL2002">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-PHILY"/>
  <isInMajors rdf:resource="#major12"/>
  <hasUnitOutcomes rdf:resource="#locate philosophical ideas in their historical context."/>
  <hasUnitOutcomes rdf:resource="#evaluate philosophical positions, including identifying counter-examples and identifying and questioning their basic assumptions."/>
  <hasUnitOutcomes rdf:resource="#compare and contrast philosophical positions."/>
  <hasUnitOutcomes rdf:resource="#construct persuasive arguments."/>
  <hasUnitOutcomes rdf:resource="#understand the basic syntactic and semantic structure of propositional logic through to first-order predicate logic with identity."/>
  <hasUnitOutcomes rdf:resource="#translate natural language arguments into propositional logic and first-order predicate logic with identity."/>
  <hasUnitOutcomes rdf:resource="#construct truth tables in propositional logic and use them to test the validity of an argument."/>
  <hasUnitOutcomes rdf:resource="#gain a basic understanding of model theory and its set theoretic foundations."/>
  <hasUnitOutcomes rdf:resource="#understand the algebraic foundations of propositional and predicate logic."/>
  <hasUnitOutcomes rdf:resource="#construct truth-functional connectives outside of the standard connectives used in propositional and predicate logic."/>
  <hasUnitOutcomes rdf:resource="#consider possible extensions of first-order predicate logic with identity in order to enrich the expressive power of the language."/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasUnitAssessments rdf:resource="#problem set"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasContactRequirement rdf:resource="#contactrequirement460"/>
  <hasContactRequirement rdf:resource="#contactrequirement461"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL2002</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Logic: How to Defeat Your Foes with Reasoning</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Logic is the study of what follows from what. Understanding formal logic is therefore valuable for anyone wishing to construct persuasive arguments or evaluate the reasoning of others. This unit introduces students to powerful techniques for translating natural language arguments into formal logic and for testing those arguments for validity. As well as its general use in evaluating arguments, a knowledge of formal logic is essential to understanding a great deal of important twentieth-century philosophy.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24 points of Level 1 units</hasPrerequisiteText>
</owl:NamedIndividual>

