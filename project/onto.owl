  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differentiate between climate change over geological time scales.</hasOutcomeDescription>
</owl:NamedIndividual>

