  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify and critically analyse key social and cultural issues in relations between Australia and Asia.</hasOutcomeDescription>
</owl:NamedIndividual>

