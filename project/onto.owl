  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">discuss the chemical properties, terminology and conventions associated with the most important classes of biomolecules.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2520">
  <rdf:type rdf:resource="#Outcome"/>
