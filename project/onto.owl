  <hasPrerequisite rdf:resource="#LAWS1110"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAWS3374</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crime, Justice and Public Policy</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit examines the formation, implementation and evaluation of justice policy in Australia, reviewing the practical problems faced in applying criminological theory to practice. Students research contemporary policy issues that may include law reform and policy responses to specific social and institutional problems.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of LAWS2223 Criminal Justice Systems or LAWS2227 Law in Action and two Unit(s) from the MJD-LWSOC Law and Society major</hasPrerequisiteText>
</owl:NamedIndividual>

