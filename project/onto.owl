  <hasContactRequirement rdf:resource="#contactrequirement10"/>
  <hasContactRequirement rdf:resource="#contactrequirement21"/>
  <hasOutcome rdf:resource="#outcome1446"/>
  <hasOutcome rdf:resource="#outcome1450"/>
  <hasOutcome rdf:resource="#outcome1447"/>
  <hasOutcome rdf:resource="#outcome1448"/>
  <hasOutcome rdf:resource="#outcome1449"/>
  <hasOutcome rdf:resource="#outcome1405"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HART3276</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prints from Drer to Toulouse-Lautrec</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The introduction of prints on paper around 1400 is often cited as a media revolution comparable only to our own, recent transition into the digital age. Invented in China several centuries earlier, printmaking profoundly changed Western visual culture as low-cost, multiple-image prints permeated everyday life from card playing to personal devotion. Such was the significance of prints in the transmission of artistic and political ideas that they soon required regulation in the form of copyright or censorship. Within the larger context of Europe's emerging colonial and missionary ambitions, prints also communicated between 'centre' and 'periphery', with images of Christian saints being printed as far afield as Mexico and China and visual records of foreign costumes and customs streaming back into Europe. This unit examines the production and reception of prints both as exclusive, high art and as popular, low art. Particular focus is paid to the implications of their status as multiples, their impact on the dissemination of knowledge, and their role as agents in cultural exchange.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">at least one Level 2 unit from the History of Art major sequence</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1446">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distinguish between a variety of printmaking processes, their origins in China and Europe and international pathways along which technological developments travelled.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1447">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe prints produced in Asia and Europe using appropriate specialist terminology.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1448">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrate visual and aesthetic analyses of artworks into broader historical and theoretical arguments and identifying wider international trends, where appropriate.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1449">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulate concise arguments based on a critical evaluation of appropriate secondary literature on the role of printmaking in shaping diverse cultural, aesthetic or political identities.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1450">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of the impact of printmaking on the global history of art.</hasOutcomeDescription>
</owl:NamedIndividual>

