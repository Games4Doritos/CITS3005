  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an understanding of some of the fundamental problems in the philosophy of artificial intelligence and mind.</hasOutcomeDescription>
</owl:NamedIndividual>

