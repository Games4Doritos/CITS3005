  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate, design and apply optimum and adaptive filters to signals and engineering systems.</hasOutcomeDescription>
</owl:NamedIndividual>

