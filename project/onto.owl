<owl:NamedIndividual rdf:about="#MJD-AGTDM">
  <rdf:type rdf:resource="#Major"/>
  <hasMajorOutcomes rdf:resource="#evaluate the effect of soils, plants, animals and the environment on production in mixed farming systems in Western Australia."/>
  <hasMajorOutcomes rdf:resource="#demonstrate knowledge about agricultural trade and commodity marketing."/>
  <hasMajorOutcomes rdf:resource="#demonstrate skills and knowledge to assess agricultural systems using experimental, modelling and statistical methods."/>
  <hasMajorOutcomes rdf:resource="#demonstrate understanding of fundamental spatial data techniques and digital systems and sensors for agricultural applications."/>
  <hasMajorOutcomes rdf:resource="#demonstrate capacity to solve farming problems using programming and data science methods."/>
  <hasMajorOutcomes rdf:resource="#integrate agricultural data analysis with farming systems information to guide decision making for improved efficiency and profitability."/>
  <hasMajorOutcomes rdf:resource="#demonstrate effective networking and communication skills."/>
  <hasMajorOutcomes rdf:resource="#demonstrate competency in laboratory practice, report writing, oral presentation and team work skills suited to gain employment in the disciplines of Agricultural Science and Technology."/>
