  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distinguish between three different types of spatial data and apply basic statistical tools required conducting inference from such data.</hasOutcomeDescription>
</owl:NamedIndividual>

