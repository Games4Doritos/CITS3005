<owl:NamedIndividual rdf:about="#outcome2075">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyse how these actors challenge, express, and gain power.</hasOutcomeDescription>
