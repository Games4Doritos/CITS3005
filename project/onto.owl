  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify how ideology, nationalism, racism, and media shape interpretations of the past.</hasOutcomeDescription>
</owl:NamedIndividual>

