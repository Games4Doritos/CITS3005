<owl:NamedIndividual rdf:about="#PHIL1003">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-PHILY"/>
  <hasUnitOutcomes rdf:resource="#identify and evaluate arguments in philosophical texts."/>
  <hasUnitOutcomes rdf:resource="#independently construct arguments for philosophical positions."/>
  <hasUnitOutcomes rdf:resource="#understand and apply the methodologies of contemporary philosophy."/>
  <hasUnitOutcomes rdf:resource="#identify and evaluate assumptions underpinning philosophical viewpoints on topics such as ethics, free will, knowledge and religion."/>
  <hasUnitOutcomes rdf:resource="#demonstrate sound research skills and written and oral communication skills."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of important historical and contemporary philosophical ideas in areas such as ethics, free will, knowledge and religion."/>
  <hasUnitOutcomes rdf:resource="#articulate and understand a number of philosophical problems in relation to religion."/>
  <hasUnitOutcomes rdf:resource="#articulate and understand key issues in metaphysics and epistemology."/>
  <hasUnitOutcomes rdf:resource="#reason effectively towards answers in the above areas."/>
  <hasUnitOutcomes rdf:resource="#evaluate philosophical positions in the above areas."/>
  <hasUnitAssessments rdf:resource="#essay"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasContactRequirement rdf:resource="#contactrequirement455"/>
  <hasContactRequirement rdf:resource="#contactrequirement456"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL1003</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">God, Mind and Knowledge</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit covers some fundamental issues which are central in philosophy and which provide an introduction to contemporary philosophical debate. The topics are organised around three major themes—God, Mind and Knowledge. It covers such issues as whether it is reasonable to believe in God, whether we have grounds for believing in the external world, whether the mind and brain are really distinct and what makes us count as the same person over time.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

