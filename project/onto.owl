<owl:NamedIndividual rdf:about="#MKTG3305">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MRKTG"/>
  <hasUnitOutcomes rdf:resource="#critically reflect on the principles of social marketing and the various functions of behaviour change campaigns."/>
  <hasUnitOutcomes rdf:resource="#evaluate the effectiveness of the various components of a social marketing campaign and how they interact."/>
  <hasUnitOutcomes rdf:resource="#recommend creative strategies and tactics to design, implement, and evaluate social marketing initiatives."/>
  <hasUnitOutcomes rdf:resource="#demonstrate competencies to work effectively in diverse teams to address societal challenges."/>
  <hasUnitOutcomes rdf:resource="#deliver effective oral presentations in a marketing context."/>
  <hasUnitOutcomes rdf:resource="#produce clear and concise written communication tailored to different audiences and purposes."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an understanding of ethical decision making and sustainability issues."/>
  <hasUnitAssessments rdf:resource="#participation and reflection"/>
  <hasUnitAssessments rdf:resource="#project"/>
  <hasUnitAssessments rdf:resource="#exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement955"/>
  <hasContactRequirement rdf:resource="#contactrequirement956"/>
  <hasPrerequisiteUnits rdf:resource="#MKTG1203"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG3305</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marketing for Social Purpose</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social marketing applies marketing principles to influence behaviours that benefit individuals and society, addressing critical issues such as public health, environmental sustainability, and social justice. But how do we craft campaigns that effectively inspire positive behaviour change? This unit will answer that question, immersing students in real-world social marketing challenges and strategies. Students will explore how to identify target behaviours, segment audiences, and develop compelling value propositions that resonate with diverse groups. Additionally, students will learn how to design, implement, and evaluate social marketing campaigns, equipping you with the strategic and creative tools necessary to tackle societal issues and drive meaningful change</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MKTG1203 Introduction to Marketing</hasPrerequisiteText>
</owl:NamedIndividual>

