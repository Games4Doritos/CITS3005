<owl:NamedIndividual rdf:about="#CHIN2801">
  <rdf:type rdf:resource="#Unit"/>
  <hasUnitLocation rdf:resource="#China"/>
  <hasUnitMode rdf:resource="#On-campus"/>
  <hasLocation rdf:resource="#China"/>
  <isInMajor rdf:resource="#MJD-CHNSI"/>
  <isInMajor rdf:resource="#MJD-CHNSP"/>
  <isInMajor rdf:resource="#MJD-CHNSA"/>
  <isInMajor rdf:resource="#MJD-CHNSB"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHIN2801</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">China Field Study</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an in-country unit during Australian summer holidays which enables students to undertake intensive language study at a Chinese university to develop their oral and written skills to a high level. It is offered as an alternative to one Chinese studies unit at UWA.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of at least one Chinese language unit at UWA or equivalent as recognised by the Faculty</hasPrerequisiteText>
</owl:NamedIndividual>

