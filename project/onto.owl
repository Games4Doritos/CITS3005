  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate an advanced ability to select appropriate language use in the context of their planned future career or research interests.</hasOutcomeDescription>
