  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">understand the TCP/IP protocol stack, and its support for client/server and peer-to-peer networking models.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome2588">
