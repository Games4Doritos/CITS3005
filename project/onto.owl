<owl:NamedIndividual rdf:about="#PHIL2001">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major12"/>
  <hasUnitOutcomes rdf:resource="#locate global moral issues in their historical and cultural context."/>
  <hasUnitOutcomes rdf:resource="#independently interpret philosophical texts."/>
  <hasUnitOutcomes rdf:resource="#evaluate philosophical positions, including identifying counter-examples and identifying and questioning their basic assumptions."/>
  <hasUnitOutcomes rdf:resource="#compare and contrast philosophical positions."/>
  <hasUnitOutcomes rdf:resource="#construct persuasive arguments."/>
  <hasUnitOutcomes rdf:resource="#demonstrate strong written communication and research skills."/>
  <hasUnitOutcomes rdf:resource="#explain influential philosophical views concerning accounts of death."/>
  <hasUnitOutcomes rdf:resource="#reason in a constructive and cooperative way about some of the most polarising moral issues."/>
  <hasUnitAssessments rdf:resource="#writing assignment"/>
  <hasUnitAssessments rdf:resource="#weekly active learning"/>
  <hasUnitAssessments rdf:resource="#oral examination of writing assignments"/>
  <hasContactRequirement rdf:resource="#contactrequirement458"/>
  <hasContactRequirement rdf:resource="#contactrequirement459"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHIL2001</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bioethics</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit focuses on a set of related questions concerning the biomedical and health sciences, such as—What is health?  How should we understand well-being or quality of life?  What is the role of lived experience in accounts of disability?  How should we think about death?  What ethical issues arise in the use of reproductive technologies? What is mental illness and how should it be treated in the biomedical and health sciences?  Students become familiar with some of the most influential works on such questions. As well as learning about such substantive issues, students also deepen their understanding of ethical reasoning in general, and sharpen their ability to understand, evaluate and construct arguments.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any level 1 unit in the Bachelor of Arts, or equivalent</hasPrerequisiteText>
</owl:NamedIndividual>

