  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluate the solutions provided to the hypothetical business entity.</hasOutcomeDescription>
</owl:NamedIndividual>

