<owl:NamedIndividual rdf:about="#MICR3305">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major35"/>
  <isInMajors rdf:resource="#MJD-MCBIM"/>
  <hasUnitOutcomes rdf:resource="#describe the structure and function of the immune system."/>
  <hasUnitOutcomes rdf:resource="#describe  antigen recognition in innate and adaptive immunity."/>
  <hasUnitOutcomes rdf:resource="#explain how the host immune response can contribute to disease."/>
  <hasUnitOutcomes rdf:resource="#describe the immune response in cancer."/>
  <hasUnitOutcomes rdf:resource="#explain the immune response in transplantation."/>
  <hasUnitOutcomes rdf:resource="#describe the immunological basis of vaccination and immunotherapeutics and how they function to prevent and control disease."/>
  <hasUnitOutcomes rdf:resource="#explain an experimental protocol and describe how experimental data is derived and interpreted."/>
  <hasUnitAssessments rdf:resource="#tests and open-book quizzes"/>
  <hasUnitAssessments rdf:resource="#assignment"/>
  <hasUnitAssessments rdf:resource="#final exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement780"/>
  <hasContactRequirement rdf:resource="#contactrequirement781"/>
  <hasPrerequisiteUnits rdf:resource="#MICR2208"/>
  <hasPrerequisiteUnits rdf:resource="#MICR2209"/>
  <hasPrerequisiteUnits rdf:resource="#PATH2210"/>
  <hasPrerequisiteUnits rdf:resource="#PATH2220"/>
  <hasPrerequisiteUnits rdf:resource="#PATH2221"/>
  <hasPrerequisiteUnits rdf:resource="#PATH2222"/>
  <hasPrerequisiteUnits rdf:resource="#IMED2001"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MICR3305</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Immunobiology and Immune Diseases</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biomedical Sciences</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on basic concepts of immunology taught at level 2. It focuses on human immune responses. Topics covered in the unit include: structure and function of the immune system; antigen recognition; regulation of host immune responses; role of immune response in control of infectious pathogens; microbial immune evasion strategies; immunopathological  basis of autoimmune disease; immune response in transplantation and organ rejection; tumour biology; and vaccination and vaccine design.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Successful completion of MICR2208 Introductory Microbiology and MICR2209 Introduction to Infectious Diseases and Immunology or PATH2210 Fundamentals of Pathology and Laboratory Medicine and PATH2220 Introduction to Human Disease or PATH2221 Principles of Human Disease and PATH2222 Pathology of Body Systems or MICR2208 Introductory Microbiology and IMED2001 Body Defences</hasPrerequisiteText>
</owl:NamedIndividual>

