  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FINA3326</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Financial Management</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit builds on the Level 2 Finance units, with particular emphasis on financial policy decisions for firms operating in a multinational environment. Topics include the hedging of risk in a multinational environment; international capital budgeting; international arbitrage mechanisms and aspects of political risk and foreign direct investment.</hasUnitDescription>
