  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appreciate the impact of social, economic and cultural differences when designing strategies for long term management of environmental pollution across local, regional and global scales.</hasOutcomeDescription>
