<owl:NamedIndividual rdf:about="#HIST1901">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#Albany"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#Flexible"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major3"/>
  <hasUnitOutcomes rdf:resource="#formulate sound arguments about how human actions have been shaped by their historical contexts."/>
  <hasUnitOutcomes rdf:resource="#describe the processes leading to environmental change in a range of places and periods."/>
  <hasUnitOutcomes rdf:resource="#demonstrate knowledge of a range of key debates in environmental history."/>
  <hasUnitOutcomes rdf:resource="#identify, critically evaluate and respond to arguments presented in secondary sources."/>
  <hasUnitOutcomes rdf:resource="#identify, critically evaluate and respond to evidence presented in primary sources."/>
  <hasUnitOutcomes rdf:resource="#express ideas cogently in verbal and essay forms."/>
  <hasUnitOutcomes rdf:resource="#reference written work in accordance with the History guide to documentation of sources."/>
  <hasUnitOutcomes rdf:resource="#demonstrate an awareness of the ways in which historically determined ideas about the environment inform current environmental policies and debates."/>
  <hasUnitAssessments rdf:resource="#workshop participation"/>
  <hasUnitAssessments rdf:resource="#a short essay"/>
  <hasUnitAssessments rdf:resource="#Final exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement254"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HIST1901</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental History</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Humanities</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What factors have shaped human dealings with the natural world? How have people changed the environment? And how have different societies responded to environmental change over time? These are the questions at the heart of this unit, which offers an introduction to the flourishing field of environmental history. Workshops focus on lively historical debates around topics including Indigenous environmental impacts, human–animal relations, the causes of the American dust bowl, the management of fisheries, the cultural significance of wilderness, the 'green' policies of Nazi Germany, and the politics of climate change. Students gain an understanding of the myriad factors shaping relationships between people and environments in the past; an understanding that is essential for interpreting the environmental problems we face today.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
</owl:NamedIndividual>

