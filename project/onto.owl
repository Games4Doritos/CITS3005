  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an increased awareness of intercultural understanding and a greater sensitivity to modern German perspectives on world events.</hasOutcomeDescription>
</owl:NamedIndividual>

