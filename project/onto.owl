  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communicate effectively with others and present results in a logical and coherent fashion.</hasOutcomeDescription>
</owl:NamedIndividual>

