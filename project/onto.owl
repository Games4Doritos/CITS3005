<owl:NamedIndividual rdf:about="#MKTG2238">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 2"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#major21"/>
  <hasUnitOutcomes rdf:resource="#critically reflect on the key principles of marketing communications."/>
  <hasUnitOutcomes rdf:resource="#evaluate the effectiveness of different components of marketing communications."/>
  <hasUnitOutcomes rdf:resource="#exercise judgement to recommend solutions around appropriate marketing communications strategies for a range of organisations."/>
  <hasUnitOutcomes rdf:resource="#demonstrate competencies to work effectively in diverse teams."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the ability to give oral presentations in a clear and coherent manner."/>
  <hasUnitOutcomes rdf:resource="#demonstrate the ability to produce clear and concise written communication."/>
  <hasUnitAssessments rdf:resource="#participation"/>
  <hasUnitAssessments rdf:resource="#examination"/>
  <hasUnitAssessments rdf:resource="#project"/>
  <hasContactRequirement rdf:resource="#contactrequirement950"/>
  <hasPrerequisiteUnits rdf:resource="#MKTG1203"/>
  <hasPrerequisiteUnits rdf:resource="#MKTX1203"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG2238</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marketing communications</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UWA Business School</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marketing communications is one of the most prominent areas of marketing. There are many opportunities and issues in the fast-paced world of communications, which includes advertising, promotions, sponsorship, events, and public relations among others. This unit will cover all the areas of marketing communications across all types of organisations and industries, giving you a foundation for potential work in this field. You will learn how to assess and critique communications from organisations, and the strategy behind them. You will also have the opportunity to develop your own communications campaigns.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MKTG1203 Introduction to Marketing or MKTX1203 Introduction to Marketing</hasPrerequisiteText>
</owl:NamedIndividual>

