  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INDG3800</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indigenous Ways of Knowing 3 (Advanced)</hasUnitTitle>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides Level 3 students with the opportunity to study, experience and relate to a range of complex &amp; advanced Indigenous knowledge topics that become available through the School of Indigenous Studies global Indigenous engagement programs. Studying in different locations alongside different host communities will provide first-hand opportunities to experience and investigate complex issues of local, national and global Indigenous rights, sustainable community development, environmental custodianship and cultural well being primarily from an Indigenous perspective.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">96 points of prior study and approval by the School of Indigenous Studies.</hasPrerequisiteText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1578">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop an advanced level of understanding and experience by way of appropriately immersing themselves in the day-to-day learning and cultural lifestyles of host Indigenous communities and their settings.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1579">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">actively demonstrate advanced ethical ways of engaging ‘in-country' with different Indigenous peoples and their knowledges, values and belief systems.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1580">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">develop advanced skills to critically analyse representations of cultural heritage, making links to the knowledge of historical and contemporary
contexts in a set of creative multi-media exercises and assessment items.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1581">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">demonstrate high quality advanced communication, citizenship and life-learning skills in both academic and community-based settings.</hasOutcomeDescription>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#outcome1582">
  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identify further advanced initiatives for Indigenous study in their respective university learning programs, community service activities, or future professional
practices.</hasOutcomeDescription>
</owl:NamedIndividual>

