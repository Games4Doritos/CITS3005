  <rdf:type rdf:resource="#Outcome"/>
  <hasOutcomeDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the global-scale processes that regulate climate.</hasOutcomeDescription>
</owl:NamedIndividual>

