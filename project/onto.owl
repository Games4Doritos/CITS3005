<owl:NamedIndividual rdf:about="#MATH2030">
  <rdf:type rdf:resource="#Unit"/>
  <hasTeachingPeriods rdf:resource="#Semester 1"/>
  <hasUnitLocations rdf:resource="#UWA (Perth)"/>
  <hasUnitModes rdf:resource="#On-campus"/>
  <isInMajors rdf:resource="#MJD-MATHS"/>
  <hasUnitOutcomes rdf:resource="#explain and exploit the notions of measure."/>
  <hasUnitOutcomes rdf:resource="#provide examples of measurable and non measurable sets."/>
  <hasUnitOutcomes rdf:resource="#utilize the notion of product measure and the theorems of Fubini and Tonelli."/>
  <hasUnitOutcomes rdf:resource="#exploit Fatou's Lemma, Dominated Convergence Theorem and Monotone Convergence Theorem to compute limits of sequence of functions."/>
  <hasUnitOutcomes rdf:resource="#exploit the notion of Lebesgue points and the differentiation theorem to detect the density of a measure."/>
  <hasUnitAssessments rdf:resource="#tests"/>
  <hasUnitAssessments rdf:resource="#final exam"/>
  <hasContactRequirement rdf:resource="#contactrequirement860"/>
  <hasContactRequirement rdf:resource="#contactrequirement861"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1011"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1011"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1013"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1012"/>
  <hasPrerequisiteUnits rdf:resource="#MATX1012"/>
  <hasPrerequisiteUnits rdf:resource="#MATH1014"/>
  <hasUnitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH2030</hasUnitCode>
  <hasUnitTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metric Spaces &amp; Measure Theory</hasUnitTitle>
  <hasUnitSchool rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physics, Mathematics and Computing</hasUnitSchool>
  <hasUnitLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasUnitLevel>
  <hasUnitDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This unit provides students with foundations in metric spaces and measure theory. Topics include norms and metrics, metric spaces, completeness, compactness, the contraction mapping principle and its consequences, Lebesgue measure, measurable sets, sigma-algebras, repeated integration, product measure, Fatou's Lemma, Dominated Convergence Theorem, Monotone Convergence Theorem, Lebesgue points, differentiation Theorem, convolution and approximation of the identity.</hasUnitDescription>
  <hasCreditPoints rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasCreditPoints>
  <hasPrerequisiteText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MATH1011 Multivariable Calculus or MATX1011 Multivariable Calculus or MATH1013 Mathematical Analysis and MATH1012 Mathematical Theory and Methods or MATX1012 Mathematical Theory and Methods or MATH1014 Algebra</hasPrerequisiteText>
</owl:NamedIndividual>

